theory MacroExemple
begin

/*
 * Protocol:     Basic protocol (tamarin manual example)
 * Modeler:      Thiebaux Valentin
 * Date:         July 2023
 *
 * Status:       working
 * Used to test macros.
*/

builtins: hashing, asymmetric-encryption
macros: encrypt(x, y) = aenc(x, y), decrypt(x, y) = adec(x, y), hashdec(x, y) = h(decrypt(x, y))

rule Register_pk:
  [ Fr(~ltk) ]
-->
  [ !Ltk($A, ~ltk), !Pk($A, pk(~ltk)) ]

rule Get_pk:
  [ !Pk(A, pubkey) ]
-->
  [ Out(pubkey)  ]

rule Reveal_ltk:
  [ !Ltk(A, ltk) ]
--[ LtkReveal(A) ]->
  [ Out(ltk) ]

rule Client_1:
  [ Fr(~k)
  , !Pk($S, pkS) ]
--[ Test1() ]->
  [ Client_1($S, ~k)
  , Out(encrypt(~k, pkS)) ]

rule Client_2:
  [ Client_1(S, k)
  , In(h(k)) ]
--[ SessKeyC(S, k)
  , Secret('Client', S, k)
  , Commit('Client', S, <'Server', k>)
  , Honest(S)
  , Test3() ]->
  []

rule Serv_1:
  [ !Ltk($S, ~ltkS)
  , In(request) ]
--[ AnswerRequest($S, decrypt(request, ~ltkS))
  , Running($S, 'Client', <'Server', decrypt(request, ~ltkS)>)
  , Test2() ]->
  [ Out(hashdec(request, ~ltkS)) ]

// ---------- 1. Secrecy ----------
lemma Client_session_key_secrecy:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// ---------- 4. Non-injective agreement ----------
lemma Client_auth:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i & r < i)"

// ---------- 5. Injective agreement ----------
lemma Client_auth_injective:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i & r < i)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

end
