theory OPCUA_Secure_Channel
begin

section{* OPCUA_Secure_Channel *}

/*
 * Protocol:    OPCUA_Secure_Channel
 * Modeler:     Dreier Jannik, Maxime Puys and Pascal Lafourcade
 * Date:        17 june 2016
 * Status:      OPCUA Open secure channel
 */

builtins: signing, asymmetric-encryption, hashing


/* Public keys generation */
rule genServerKey:
    [ Fr(~x) ]
    --[ ServerKey($S, pk(~x)) ]->
    [ !Ltk($S, ~x), Out(<$S, pk(~x)>)]


rule genClientKey:
    [ Fr(~x) ]
    --[ ClientKey($C, pk(~x)) ]->
    [ !Ltk($C, ~x), Out(<$C, pk(~x)>)]


/*
// No corruption for the moment.
rule corrupt:
    [ !Ltk($C, ~x) ]
    --[ Corrupt($C, pk(~x)) ]->
    [ Out(<$C, ~x>) ]
*/


/* C -> DE : GEReq */
rule Init:
let
    m = 'GEReq'
in
    [ ]
    --[ Init($C, $S), Test1() ]->
    [ Out(m) ]


/* DE  -> C : GERes, pk(S), Sign, SP, UP */
rule Resp_Init:
let
    m = 'GEReq'
    m2 = <'GERes', pk(~x), 'Sign', $SP, $UP>
in
    [ In(m), !Ltk($S, ~x) ]
    --[ Resp($C, $S), Test2() ]->
    [ Out(m2) ]


/* C -> S : pk(C), <OSCReq, pk(C), Nc>, sign(h(OSCReq, pk(C), Nc ), sk(C) ) */
/* Where Nc is a fresh nonce generated by C */
rule Resp_Client:
let
    m = <'GERes', keyS, 'Sign', sp, up>
    m2 = <'OSCReq', pk(~x), ~nc>
in
    [ In(m), !Ltk($C, ~x), Fr(~nc) ]
    --[ Resp_Client($C, $S, ~nc, keyS, pk(~x)),
        WitnessNc($C, $S, ~nc),
        Running($C, $S, <'I', ~nc>),
        Test3() ]->
    [ Out(<pk(~x), m2, sign{h(m2)}~x, h(m2)>) ]


/* SE -> C : <OSCRes, NS , ST, TTL>, sign(h(OSCRes, NS , ST, TTL), sk(S)) */
rule Resp_Server:
let
    m = <'OSCReq', keyC, nc>
    m2 = <'OSCRes', ~ns, $ST, $TTL>
in
    [ !Ltk($S, ~x), In(<keyC, m, signature, h(m)>), Fr(~ns)]
    --[ Eq(verify(signature, h(<'OSCReq', keyC, nc>), keyC), true),
        Resp_Server($C, $S, ~ns, keyC, pk(~x)),
        RequestNc($C, $S, nc),
        WitnessNs($S, $C, ~ns),
        Commit($S, $C, <'I', nc>),
        Running($S, $C, <'R', ~ns>),
        Secret($C, $S, h(<nc, ~ns>)),
        Test4() ]->
    [ Out(<pk(~x), m2, sign{h(m2)}~x, h(m2)>) ]


/* Client authenticates server on Ns */
rule Auth_Client:
let
    m = <keys, 'OSCRes', ns, st, ttl>
in
    [ In(<m, signature>) ]
    --[ Eq(verify(signature, h(<'OSCRes', ns, st, ttl>), keys), true),
        RequestNs($S, $C, ns),
        Commit($C, $S, <'R', ns>),
        Test5() ]->
    [ ]


restriction Equality:
    "All x y #i. Eq(x, y) @ #i ==> x = y"


// ---------- 1. Secrecy ----------
lemma key_secrecy:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
     not (Ex #j. K(x) @ j)"


// ---------- 4. Non-injective agreement ----------
lemma nc_auth:
  "All a b nc #i.
     Commit(a, b, <'I', nc>) @ i
   ==>
     (Ex #j. Running(b, a, <'I', nc>) @ j)"


// ---------- 4. Non-injective agreement ----------
lemma ns_auth:
  "All a b ns #i.
     Commit(a, b, <'R', ns>) @ i
   ==>
     (Ex #j. Running(b, a, <'R', ns>) @ j)"


lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4 #t5.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & Test5() @ #t5
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4 & #t4 < #t5"


end
