theory ISO9798_4_4_979844_reuse_once_1_1
begin

functions: sid1_mut_cr/0,
		sid2_mut_cr/0,
		mac/2

rule MisGenerateRandoms:
	[
		Fr(~RA1)
	]
	--[
		MisgenerateOnlyOnce()
	]->
	[
		Random1(~RA1),
		Random1(~RA1)
	]

rule GenRandom1:
	[
		Fr(~RA1)
	]
	-->
	[
		Random1(~RA1)
	]

rule GenRandom0:
	[
		Fr(~RB0)
	]
	-->
	[
		Random0(~RB0)
	]

rule CreateAssociation:
	[
		In(< $IdA, $IdB >),
		Fr(~kAB)
	]
	-->
	[
		!RoleA($IdA, $IdB, ~kAB),
		!RoleB($IdA, $IdB, ~kAB),
		!Ltk($IdA, ~kAB),
		!Ltk($IdB, ~kAB)
	]

rule RevLtk:
	[
		!Ltk(A, k)
	]
	--[
		RevLtk(A),
		LtkReveal(A)
	]->
	[
		Out(k)
	]

rule CreateSession:
	[
		!RoleA($IdA, $IdB, ~kAB),
		!RoleB($IdA, $IdB, ~kAB)
	]
	-->
	[
		StartA($IdA, $IdB, ~kAB),
		StartB($IdA, $IdB, ~kAB)
	]

rule RoleB_1:
	[
		StartB($IdA, $IdB, ~kAB),
		Random0(~RB),
		Fr(~Text1)
	]
	--[
		BSendElt($IdA, $IdB, ~kAB, ~Text1, ~RB),
		BStarted($IdA, $IdB, ~RB),
		Test1()
	]->
	[
		Out(< ~RB, ~Text1 >),
		Step1B($IdA, $IdB, ~kAB, ~RB)
	]

rule RoleA_1:
	[
		StartA($IdA, $IdB, ~kAB),
		Random1(~RA),
		In(< RB, Text1 >),
		Fr(~Text2),
		Fr(~Text3)
	]
	--[
		ASendTokenAB($IdA, $IdB, ~kAB, ~RA, RB, $IdB, ~Text3),
		AStarted($IdA, $IdB, ~RA, RB),
		Running($IdA, $IdB, <'b_t', ~RA, RB>),
		Test2()
	]->
	[
		Out(< ~RA, ~Text3, < sid1_mut_cr, ~RA, RB, $IdB, ~Text2 >, mac(< sid1_mut_cr, ~RA, RB, $IdB >, ~kAB) >),
		Step1A($IdA, $IdB, ~kAB, ~RA, RB, ~Text2, ~Text3)
	]

rule RoleB_2:
	[
		Step1B($IdA, $IdB, ~kAB, ~RB),
		In(< RA, Text3, mac(< sid1_mut_cr, RA, ~RB, $IdB >, ~kAB) >),
		Fr(~Text4),
		Fr(~Text5)
	]
	--[
		BRecvTokenAB($IdA, $IdB, ~kAB, RA, ~RB, $IdB, Text3),
		BSendTokenBA($IdA, $IdB, ~kAB, ~RB, RA, ~Text5),
		BEnded($IdA, $IdB, RA, ~RB),
		Running($IdB, $IdA, <'a_t', RA, ~RB>),
		Commit($IdB, $IdA, <'b_t', RA, ~RB>),
		Honest($IdA),
		Honest($IdB),
		Test3()
	]->
	[
		Out(< ~Text5, mac(< sid2_mut_cr, ~RB, RA >, ~kAB) >)
	]

rule RoleA_2:
	[
		Step1A($IdA, $IdB, ~kAB, ~RA, RB, ~Text2, ~Text3),
		In(< Text5, mac(< sid2_mut_cr, RB, ~RA >, ~kAB) >)
	]
	--[
		ARecvTokenBA($IdA, $IdB, ~kAB, RB, ~RA, Text5),
		AEnded($IdA, $IdB, ~RA, RB),
		Commit($IdA, $IdB, <'a_t', ~RA, RB>),
		Honest($IdA),
		Honest($IdB),
		Test4()
	]->
	[

	]

restriction RestrMisgeneratesOnlyOnce:
"All #i #j . MisgenerateOnlyOnce() @i & MisgenerateOnlyOnce() @j ==> #i = #j"

restriction RestrEq:
	"All a b #i .
	Eq(a, b) @ i ==> (a = b)"


// ---------- 5. Injective agreement ----------
lemma agree_a:
  "All a b t #i.
     Commit(a, b, <'a_t', t>) @ i
   ==>
       ( (Ex #j. Running(b, a, <'a_t', t>) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, <'a_t', t>) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"


// ---------- 5. Injective agreement ----------
lemma agree_b:
  "All a b t #i.
     Commit(a, b, <'b_t', t>) @ i
   ==>
       ( (Ex #j. Running(b, a, <'b_t', t>) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, <'b_t', t>) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"


// ---------- 4. Non-injective agreement ----------
lemma noninj_agree_a:
  "All a b t #i.
     Commit(a, b, <'a_t', t>) @ i
   ==>
       (Ex #j. Running(b, a, <'a_t', t>) @ j & j < i)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"


// ---------- 4. Non-injective agreement ----------
lemma noninj_agree_b:
  "All a b t #i.
     Commit(a, b, <'b_t', t>) @ i
   ==>
       (Ex #j. Running(b, a, <'b_t', t>) @ j & j < i)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"


lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"


end
