theory CRXorNoKVfy
begin

builtins: xor, hashing

restriction Equality:
  "All x y #i. Eq(x, y) @ i ==> x = y"

rule SetupSharedKey:
  [ Fr(~k) ]
  --[ ]->
  [ !ShK($I, $R, ~k) ]

rule I_Start:
  [ Fr(~na), !ShK($I, $R, k) ]
  --[ Test1(), Create($I, ~na) ]->
  [ St_I_1($I, $R, k, ~na), Out(~na) ]

rule R_Respond:
  let t = h(na XOR k XOR ~nb) in
  [ In(na), !ShK($I, $R, k), Fr(~nb) ]
  --[ Test2(), Create($R, ~nb), Running($R, $I, <'R', t>) ]->
  [ Out(<t, ~nb>) ]

rule I_Verify:
  [ St_I_1($I, $R, k, ~na), In(<tag, nb>) ]
  --[
      Test3(),
      Eq(tag, h(~na XOR nb)),
      Commit($I, $R, <'R', tag>),
      Honest($I), Honest($R)
    ]->
  [ ]

// category: aliveness
lemma aliveness:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex id #j. Create(b, id) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

end
