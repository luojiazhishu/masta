theory PublicKeySessionKeyTransportAck
begin

builtins: asymmetric-encryption, hashing

rule Generate_ltk:
  [ Fr(~ltk) ]
  --[ ]->
  [ !Ltk($S, ~ltk), !Pk($S, pk(~ltk)) ]

rule Reveal_ltk:
  [ !Ltk($S, ~ltk) ]
  --[ LtkReveal($S) ]->
  [ Out(~ltk) ]

/* Action Block 1: Client generates session key and sends encrypted ciphertext */
rule Client_Init:
  [ Fr(~k), !Pk($S, pkS) ]
  --[ Test1(), Create($C, ~k), Secret($C, $S, ~k), Honest($C), Honest($S) ]->
  [ Out(aenc(~k, pkS)), St_C_1($C, $S, ~k) ]

/* Action Block 2: Server decrypts ciphertext and sends hash acknowledgement */
rule Server_Recv:
  let k = adec(c1, ~ltk)
  in
  [ In(c1), !Ltk($S, ~ltk) ]
  --[ Test2(), Running($S, $S, <'server', k>) ]->
  [ Out(<h(k), 'ack'>) ]

/* Action Block 3: Client checks tag and verifies hash, accepts session key */
rule Client_Finish:
  [ St_C_1($C, $S, ~k), In(<h(~k), 'ack'>) ]
  --[ Test3(), Commit($C, $S, <'client', ~k>), Honest($C), Honest($S) ]->
  [ ]

// category: secrecy
lemma secrecy_k:
  "All c s k #i.
     Secret(c, s, k) @ i
   ==>
       not (Ex #j. K(k) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement:
  "All c s k #i.
     Commit(c, s, <'client', k>) @ i
   ==>
     (Ex #j. Running(s, s, <'server', k>) @ j)
   | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement:
  "All c s k #i.
     Commit(c, s, <'client', k>) @ i
   ==>
     ( (Ex #j. Running(s, s, <'server', k>) @ j
           & j < i
           & not (Ex c2 s2 #i2. Commit(c2, s2, <'client', k>) @ i2
                              & not (#i2 = #i))) )
   | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

end
