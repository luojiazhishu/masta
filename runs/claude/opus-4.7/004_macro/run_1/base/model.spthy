theory BSKT
begin

builtins: asymmetric-encryption, hashing

rule Register_pk:
  [ Fr(~sk) ]
  -->
  [ !Ltk($S, ~sk), !Pk($S, pk(~sk)), Out(pk(~sk)) ]

rule Reveal_Ltk:
  [ !Ltk($S, ~sk) ]
  --[ LtkReveal($S) ]->
  [ Out(~sk) ]

rule Client_Init:
  [ Fr(~k), !Pk($S, pkS) ]
  --[ Test1(), Create($C, ~k), Secret($C, $S, ~k), Honest($C), Honest($S) ]->
  [ St_Client($C, $S, ~k), Out(aenc(~k, pkS)) ]

rule Server_Respond:
  let k = adec(ct, ~sk) in
  [ !Ltk($S, ~sk), In(ct) ]
  --[ Test2(), Running($S, $S, <'server', k>) ]->
  [ Out(h(k)) ]

rule Client_Confirm:
  [ St_Client($C, $S, ~k), In(h(~k)) ]
  --[ Test3(), Commit($C, $S, <'client', ~k>), Honest($C), Honest($S) ]->
  [ ]

// category: secrecy
lemma secrecy:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement:
  "All c s k #i.
     Commit(c, s, <'client', k>) @ i
   ==>
       (Ex #j. Running(s, s, <'server', k>) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement:
  "All c s k #i.
     Commit(c, s, <'client', k>) @ i
   ==>
       ( (Ex #j. Running(s, s, <'server', k>) @ j
             & j < i
             & not (Ex c2 s2 #i2. Commit(c2, s2, <'client', k>) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

end
