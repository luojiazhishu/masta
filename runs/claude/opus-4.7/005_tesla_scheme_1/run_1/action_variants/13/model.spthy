theory TESLA_Scheme1_Variant13
begin

builtins: signing

functions: MAC/2, f/1

rule Generate_Keypair:
    [ Fr(~ltk) ]
  -->
    [ !Ltk($A, ~ltk), !Pk($A, pk(~ltk)), Out(pk(~ltk)) ]

rule Reveal_Ltk:
    [ !Ltk(A, ltk) ]
  --[ LtkReveal(A) ]->
    [ Out(ltk) ]

// Block 1: Sender generates initial MAC key chain seed
rule Sender_Setup:
    [ Fr(~k1) ]
  --[ Test1() ]->
    [ Sender1($S, ~k1), !Sender0a($S, ~k1) ]

// Block 2: Receiver generates nonce and sends setup request
rule Receiver0a:
    [ Fr(~nR) ]
  --[ Test2() ]->
    [ Out(<$R, $S, ~nR>)
    , Receiver0b($R, $S, ~nR) ]

// Block 3: Sender answers with commitment and signature
rule Sender0a:
    [ !Sender0a(S, k1)
    , In(<R, S, nR>)
    , !Ltk(S, ltkS)
    ]
  --[ Test3() ]->
    [ Out(<S, R, f(k1), sign(<f(k1), nR>, ltkS)>) ]

// Block 4: Receiver receives setup response
rule Receiver0b:
    [ Receiver0b(R, S, nR)
    , !Pk(S, pkS)
    , In(<S, R, commit_k1, signature>)
    , Fr(~rid)
    ]
  --[ Create(R, ~rid), Test4() ]->
    [ Receiver0b_check(~rid, S, commit_k1, verify(signature, <commit_k1, nR>, pkS)) ]

// Block 5: Receiver checks signature validity
rule Receiver0b_check:
    [ Receiver0b_check(rid, S, commit_k1, true)
    , Fr(~rid2)
    ]
  --[ Test5() ]->
    [ Receiver1(rid, S, commit_k1) ]

// Block 6: Sender sends first stream message with delayed key disclosure
rule Send1:
  let data1 = <~m1, f(~k2)>
  in
    [ Sender1(S, ~k1)
    , Fr(~m1)
    , Fr(~k2)
    ]
  --[ Running(S, S, <'broadcast', data1>)
    , Test6()
    ]->
    [ Sender(S, ~k1, ~k2)
    , Out(<data1, MAC(data1, ~k1)>) ]

// Block 7: Receiver buffers first stream message (key not yet disclosed)
rule Recv1:
  let data1 = <m1, commit_k2>
  in
    [ Receiver1(rid, S, commit_k1)
    , In(<data1, mac1>)
    ]
  --[ AssumeCommitNotExpired(rid, commit_k1)
    , Test7()
    ]->
    [ Receiver(rid, S, data1, mac1, commit_k1, commit_k2) ]

// Block 8: Sender sends subsequent stream message, disclosing previous key
rule SendN:
  let data = <~m, f(~kNew), ~kOld>
  in
    [ Sender(S, ~kOld, ~k)
    , Fr(~m)
    , Fr(~kNew)
    ]
  --[ Running(S, S, <'broadcast', data>)
    , CommitExpired(f(~kOld))
    , Test8()
    ]->
    [ Sender(S, ~k, ~kNew)
    , Out(<data, MAC(data, ~k)>) ]

// Block 9: Receiver verifies MAC using disclosed key
rule RecvN:
  let data = <m, commit_kNew, kOld>
  in
    [ In(<data, mac>)
    , Receiver(rid, S, dataOld, MAC(dataOld, kOld), f(kOld), commit_k)
    ]
  --[ AssumeCommitNotExpired(rid, commit_k)
    , Commit(rid, S, <'broadcast', dataOld>)
    , Honest(S)
    , Test9()
    ]->
    [ Receiver(rid, S, data, mac, commit_k, commit_kNew) ]

restriction CommitNotExpiredOrdering:
  "All rid commit #i #j.
       AssumeCommitNotExpired(rid, commit) @ i & CommitExpired(commit) @ j
   ==> i < j"

// category: noninjective_agreement
lemma authentic [use_induction]:
  "All R S m #i.
     Commit(R, S, <'broadcast', m>) @ i
   ==>
       (Ex #j. Running(S, S, <'broadcast', m>) @ j & j < i)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4 #t5 #t6 #t7 #t8 #t9.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & Test4() @ #t4 & Test5() @ #t5 & Test6() @ #t6
     & Test7() @ #t7 & Test8() @ #t8 & Test9() @ #t9
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4 & #t4 < #t5
     & #t5 < #t6 & #t6 < #t7 & #t7 < #t8 & #t8 < #t9"

end
