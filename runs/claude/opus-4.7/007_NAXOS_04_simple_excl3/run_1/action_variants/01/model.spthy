theory SimplifiedNAXOS
begin

builtins: diffie-hellman

functions: h1/2, h2/1

rule Register_Ltk:
  [ Fr(~lk) ]
  --[ ]->
  [ !Ltk($A, ~lk), !Pk($A, 'g'^~lk) ]

rule Reveal_Ltk:
  [ !Ltk($A, ~lk) ]
  --[ LtkReveal($A) ]->
  [ Out(~lk) ]

// Action block 1: Initiator generates ephemeral, sends hkI and TransportId
rule Initiator_1:
  let exI = h1(~eskI, ~lkI)
      hkI = 'g'^exI
  in
  [ Fr(~eskI), Fr(~tid), !Ltk($I, ~lkI), !Pk($R, pkR) ]
  --[ Test1(), Create($I, ~tid) ]->
  [ Out(<hkI, ~tid, $I, $R>), St_I_1($I, $R, ~eskI, ~lkI, ~tid, pkR) ]

// Action block 2: Responder receives Message 1, sends hkR, derives kR
rule Responder_1:
  let exR = h1(~eskR, ~lkR)
      hkR = 'g'^exR
      kR  = h2(<pkI^exR, X^~lkR, $I, $R>)
  in
  [ In(<X, tid, $I, $R>), Fr(~eskR), !Ltk($R, ~lkR), !Pk($I, pkI) ]
  --[ Test2(), Create($R, ~eskR),
      Running($R, $I, <'session_key', $I, $R, kR>),
      Secret($I, $R, kR), Honest($I), Honest($R) ]->
  [ Out(hkR) ]

// Action block 3: Initiator receives hkR, derives kI
rule Initiator_2:
  let exI = h1(~eskI, ~lkI)
      kI  = h2(<Y^~lkI, pkR^exI, $I, $R>)
  in
  [ In(Y), St_I_1($I, $R, ~eskI, ~lkI, ~tid, pkR) ]
  --[ Test3(),
      Commit($I, $R, <'session_key', $I, $R, kI>),
      Secret($I, $R, kI), Honest($I), Honest($R) ]->
  [ ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

// category: secrecy
lemma secrecy:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end
