theory NAXOS_simple_excl3
begin

builtins: diffie-hellman

functions: h1/2, h2/1, com/2, bar/1

/* Long-term key registration */
rule Register_Pk:
  [ Fr(~lk) ]
  --[ ]->
  [ !Ltk($A, ~lk), !Pk($A, 'g'^~lk) ]

/* Adversary long-term key reveal */
rule Reveal_Ltk:
  [ !Ltk($A, ~lk) ]
  --[ LtkReveal($A) ]->
  [ Out(~lk) ]

/* Block 1: Initiator generates ephemeral key and sends Message 1 */
rule Initiator_Send:
  let
    exI = h1(~eskI, ~lkI)
    hkI = 'g'^exI
  in
  [ Fr(~eskI), !Ltk($I, ~lkI), !Pk($R, pkR) ]
  --[ Test1(), Create($I, ~eskI) ]->
  [ Out(hkI), St_I_1($I, $R, ~lkI, ~eskI, pkR) ]

/* Block 2: Responder receives Message 1, looks up PKI, generates fresh eskR,
   computes local audit values (not transmitted) */
rule Responder_RecvMsg1:
  [ In(X), Fr(~eskR), !Ltk($R, ~lkR), !Pk($I, pkI) ]
  --[ Test2(), Create($R, ~eskR) ]->
  [ St_R_1($I, $R, ~lkR, ~eskR, X, pkI) ]

/* Block 3: Responder sends Message 2 and computes session key kR */
rule Responder_Send:
  let
    exR = h1(~eskR, ~lkR)
    hkR = 'g'^exR
    kR  = h2(<pkI^exR, X^~lkR, $I, $R>)
  in
  [ St_R_1($I, $R, ~lkR, ~eskR, X, pkI) ]
  --[ Test3(),
      Secret($R, $I, kR),
      Running($R, $I, <'initiator', kR>),
      Honest($I), Honest($R) ]->
  [ Out(hkR) ]

/* Block 4: Initiator receives Message 2 and computes session key kI */
rule Initiator_Recv:
  let
    exI = h1(~eskI, ~lkI)
    kI  = h2(<Y^~lkI, pkR^exI, $I, $R>)
  in
  [ St_I_1($I, $R, ~lkI, ~eskI, pkR), In(Y) ]
  --[ Test4(),
      Secret($I, $R, kI),
      Commit($I, $R, <'initiator', kI>),
      Honest($I), Honest($R) ]->
  [ ]

// category: secrecy
lemma secrecy:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"


lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

end
