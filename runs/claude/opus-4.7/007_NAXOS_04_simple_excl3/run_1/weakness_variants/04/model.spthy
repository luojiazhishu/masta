theory SimplifiedNAXOS
begin

builtins: diffie-hellman

functions: h1/2, h2/1

/* Long-term key generation */
rule Register_LTK:
  [ Fr(~lk) ]
  --[ ]->
  [ !Ltk($A, ~lk) ]

/* Adversary can reveal long-term keys */
rule Reveal_LTK:
  [ !Ltk($A, ~lk) ]
  --[ LtkReveal($A) ]->
  [ Out(~lk) ]

/* Action block 1: Initiator generates ephemeral key and sends hkI = g^h1(eskI, lkI) */
rule Initiator_Send:
  [ Fr(~eskI), !Ltk($I, ~lkI) ]
  --[ Test1() ]->
  [ Out('g'^h1(~eskI, ~lkI)), St_I_1($I, $R, ~eskI, ~lkI) ]

/* Action block 2: Responder receives hkI, sends hkR = g^h1(eskR, lkR), derives kR = h2(<I,R>) */
rule Responder_Respond:
  [ In(hkI), Fr(~eskR), !Ltk($R, ~lkR) ]
  --[ Test2(),
      Secret($R, $I, h2(<$I, $R>)),
      Honest($I), Honest($R) ]->
  [ Out('g'^h1(~eskR, ~lkR)) ]

/* Action block 3: Initiator receives hkR and derives kI = h2(<I,R>) */
rule Initiator_Finish:
  [ St_I_1($I, $R, ~eskI, ~lkI), In(hkR) ]
  --[ Test3(),
      Secret($I, $R, h2(<$I, $R>)),
      Honest($I), Honest($R) ]->
  [ ]

// category: secrecy
lemma secrecy:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

end
