theory MutualAuthResponderTag
begin

builtins: signing

restriction Eq:
  "All x y #i. Eq(x, y) @ i ==> x = y"

rule Register_ltk:
  [ Fr(~ltkA) ]
  --[ ]->
  [ !Ltk($A, ~ltkA), !Pk($A, pk(~ltkA)) ]

rule Reveal_ltk:
  [ !Ltk(A, ltkA) ]
  --[ LtkReveal(A) ]->
  [ Out(ltkA) ]

// Action block 1: Initiator computes signature and sends
rule Initiator_Send:
  [ !Ltk($I, ltkI), !Pk($R, pkR), Fr(~tid) ]
  --[ Test1(), Create($I, ~tid) ]->
  [ St_I($I, $R, ~tid, pkR),
    Out(sign(<$I, $R>, ltkI)) ]

// Action block 2: Responder receives, verifies, computes, sends
rule Responder_Reply:
  [ !Ltk($R, ltkR), !Pk($I, pkI), In(sig), Fr(~tid) ]
  --[ Test2(),
      Eq(verify(sig, <$I, $R>, pkI), true),
      Create($R, ~tid),
      Running($R, $I, <'initiator', $I, $R>) ]->
  [ Out(<sign(<$I, $R>, ltkR), 'resp'>) ]

// Action block 3: Initiator checks tag, verifies signature, accepts
rule Initiator_Accept:
  [ St_I($I, $R, ~tid, pkR), In(<s, 'resp'>) ]
  --[ Test3(),
      Eq(verify(s, <$I, $R>, pkR), true),
      Commit($I, $R, <'initiator', $I, $R>),
      Honest($I), Honest($R) ]->
  [ ]

// category: weak_agreement
lemma weak_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex t2 #j. Running(b, a, t2) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

end
