theory H1MutualAuthAudit
begin

builtins: signing

functions: bar/1

/* Key infrastructure */
rule Register_pk:
  [ Fr(~ltk) ]
  --[ ]->
  [ !Ltk($A, ~ltk), !Pk($A, pk(~ltk)) ]

rule Reveal_ltk:
  [ !Ltk($A, ~ltk) ]
  --[ LtkReveal($A) ]->
  [ Out(~ltk) ]

/* Action Block 1: Initiator computes mI and audit_marker, sends both */
rule I_Send:
  [ !Ltk($I, ~ltkI), !Pk($R, pkR) ]
  --[ Test1(),
      Running($I, $R, <$I, $R>),
      Honest($I), Honest($R) ]->
  [ Out(sign(<$I, $R>, ~ltkI)),
    Out(bar($I)),
    St_I_1($I, $R) ]

/* Action Block 2: Responder verifies mI, computes and sends mR */
rule R_Process:
  [ In(sig), !Ltk($R, ~ltkR), !Pk($I, pkI) ]
  --[ Test2(),
      Eq(verify(sig, <$I, $R>, pkI), true),
      Running($R, $I, <$I, $R>),
      Commit($R, $I, <$I, $R>),
      Honest($I), Honest($R) ]->
  [ Out(sign(<$I, $R>, ~ltkR)) ]

/* Action Block 3: Initiator verifies mR and accepts */
rule I_Finish:
  [ St_I_1($I, $R), In(sigR), !Pk($R, pkR) ]
  --[ Test3(),
      Eq(verify(sigR, <$I, $R>, pkR), true),
      Commit($I, $R, <$I, $R>),
      Honest($I), Honest($R) ]->
  [ ]

restriction Equality:
  "All x y #i. Eq(x, y) @ i ==> x = y"

// category: weak_agreement
lemma weak_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex t2 #j. Running(b, a, t2) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

end
