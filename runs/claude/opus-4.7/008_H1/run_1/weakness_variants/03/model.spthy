theory H1ConstantReply
begin

builtins: signing

rule Register_Ltk:
  [ Fr(~ltk) ]
  --[ ]->
  [ !Ltk($A, ~ltk), !Pk($A, pk(~ltk)) ]

rule Get_Pk:
  [ !Pk($A, pkA) ]
  --[ ]->
  [ Out(pkA) ]

rule Reveal_Ltk:
  [ !Ltk($A, ~ltk) ]
  --[ LtkReveal($A) ]->
  [ Out(~ltk) ]

/* Action Block 1: Initiator computes mI = sign(<I,R>, ltkI) and sends it */
rule I_Start:
  let mI = sign(<$I, $R>, ~ltkI)
  in
  [ !Ltk($I, ~ltkI), !Pk($R, pkR), Fr(~tid) ]
  --[ Test1() ]->
  [ Out(mI), St_I_1($I, $R, ~tid, pkR) ]

/* Action Block 2: Responder verifies mI and replies with mR = sign(tagAck, ltkR) */
rule R_Respond:
  let mR = sign('tagAck', ~ltkR)
  in
  [ !Ltk($R, ~ltkR), !Pk($I, pkI), In(mI) ]
  --[ Test2(),
      Eq(verify(mI, <$I, $R>, pkI), true),
      Running($R, $I, <'initiator', $I, $R>) ]->
  [ Out(mR) ]

/* Action Block 3: Initiator verifies mR and accepts */
rule I_Finish:
  [ St_I_1($I, $R, ~tid, pkR), In(mR) ]
  --[ Test3(),
      Eq(verify(mR, 'tagAck', pkR), true),
      Commit($I, $R, <'initiator', $I, $R>),
      Honest($I), Honest($R) ]->
  [ ]

restriction Eq:
  "All x y #i. Eq(x, y) @ i ==> x = y"

// category: weak_agreement
lemma weak_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex t2 #j. Running(b, a, t2) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

end
