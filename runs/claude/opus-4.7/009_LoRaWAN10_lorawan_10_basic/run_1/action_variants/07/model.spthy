theory LoRaWAN10
begin

builtins: symmetric-encryption

functions: mac/2, brand/1

rule Setup:
  [ Fr(~AppKey) ]
  --[ ]->
  [ !Device($DevEUI, $JoinEUI, ~AppKey),
    !Server($DevEUI, $JoinEUI, ~AppKey) ]

rule Reveal_AppKey:
  [ !Device($DevEUI, $JoinEUI, ~AppKey) ]
  --[ LtkReveal($DevEUI), LtkReveal($JoinEUI) ]->
  [ Out(~AppKey) ]

/* Block 1: Device generates DevNonce and sends JoinRequest */
rule Device_Init:
  let reqMAC = mac(~AppKey, <'JoinRequest', $DevEUI, $JoinEUI, ~DevNonce>)
  in
  [ !Device($DevEUI, $JoinEUI, ~AppKey),
    Fr(~DevNonce) ]
  --[ Test1(),
      Create($DevEUI, ~DevNonce),
      Running($DevEUI, $JoinEUI, <'server', ~DevNonce>) ]->
  [ Out(<'JoinRequest', $DevEUI, $JoinEUI, ~DevNonce, reqMAC>),
    St_D1($DevEUI, $JoinEUI, ~AppKey, ~DevNonce) ]

/* Block 2: Server verifies JoinRequest, derives session keys, sends JoinAccept */
rule Server_Join:
  let reqMAC  = mac(~AppKey, <'JoinRequest', $DevEUI, $JoinEUI, devNonce>)
      respMAC = mac(~AppKey, <'JoinAccept', ~JoinNonce, ~DevAddr>)
      appSKey = senc(<'cst1', devNonce, ~JoinNonce>, ~AppKey)
      nwkSKey = senc(<'cst2', devNonce, ~JoinNonce>, ~AppKey)
  in
  [ !Server($DevEUI, $JoinEUI, ~AppKey),
    In(<'JoinRequest', $DevEUI, $JoinEUI, devNonce, reqMAC>),
    Fr(~JoinNonce), Fr(~DevAddr) ]
  --[ Test2(),
      Create($JoinEUI, ~JoinNonce),
      Commit($JoinEUI, $DevEUI, <'server', devNonce>),
      Running($JoinEUI, $DevEUI, <'device', devNonce, ~JoinNonce, ~DevAddr>),
      Running($JoinEUI, $DevEUI, <'keys', appSKey, nwkSKey>),
      Secret($DevEUI, $JoinEUI, appSKey),
      Secret($DevEUI, $JoinEUI, nwkSKey),
      Honest($DevEUI), Honest($JoinEUI) ]->
  [ Out(senc(<'JoinAccept', ~JoinNonce, ~DevAddr, respMAC>, ~AppKey)) ]

/* Block 3: Device decrypts JoinAccept, verifies MAC, derives session keys, computes AddrBrand */
rule Device_Finish:
  let respMAC  = mac(~AppKey, <'JoinAccept', joinNonce, devAddr>)
      appSKey  = senc(<'cst1', ~DevNonce, joinNonce>, ~AppKey)
      nwkSKey  = senc(<'cst2', ~DevNonce, joinNonce>, ~AppKey)
      addrBrand = brand(devAddr)
  in
  [ St_D1($DevEUI, $JoinEUI, ~AppKey, ~DevNonce),
    In(senc(<'JoinAccept', joinNonce, devAddr, respMAC>, ~AppKey)) ]
  --[ Test3(),
      Commit($DevEUI, $JoinEUI, <'device', ~DevNonce, joinNonce, devAddr>),
      Commit($DevEUI, $JoinEUI, <'keys', appSKey, nwkSKey>),
      Secret($DevEUI, $JoinEUI, appSKey),
      Secret($DevEUI, $JoinEUI, nwkSKey),
      Honest($DevEUI), Honest($JoinEUI) ]->
  [ ]

// category: secrecy
lemma secrecy_session_keys:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_device:
  "All d s dn jn da #i.
     Commit(d, s, <'device', dn, jn, da>) @ i
   ==>
       (Ex #j. Running(s, d, <'device', dn, jn, da>) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_device:
  "All d s dn jn da #i.
     Commit(d, s, <'device', dn, jn, da>) @ i
   ==>
       ( (Ex #j. Running(s, d, <'device', dn, jn, da>) @ j
             & j < i
             & not (Ex d2 s2 #i2. Commit(d2, s2, <'device', dn, jn, da>) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_server:
  "All s d dn #i.
     Commit(s, d, <'server', dn>) @ i
   ==>
       (Ex #j. Running(d, s, <'server', dn>) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_server:
  "All s d dn #i.
     Commit(s, d, <'server', dn>) @ i
   ==>
       ( (Ex #j. Running(d, s, <'server', dn>) @ j
             & j < i
             & not (Ex s2 d2 #i2. Commit(s2, d2, <'server', dn>) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_keys:
  "All A B appS nwkS #i.
     Commit(A, B, <'keys', appS, nwkS>) @ i
   ==>
       (Ex #j. Running(B, A, <'keys', appS, nwkS>) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_keys:
  "All A B appS nwkS #i.
     Commit(A, B, <'keys', appS, nwkS>) @ i
   ==>
       ( (Ex #j. Running(B, A, <'keys', appS, nwkS>) @ j
             & j < i
             & not (Ex A2 B2 #i2. Commit(A2, B2, <'keys', appS, nwkS>) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

end
