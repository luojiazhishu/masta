theory CrXorImk
begin

builtins: hashing, xor

rule Setup:
  [ Fr(~k) ]
  --[ Create($I, 'crxor'), Create($R, 'crxor'), Secret($I, $R, ~k), Honest($I), Honest($R) ]->
  [ !SharedKey($I, $R, ~k), !SharedKey($R, $I, ~k) ]

rule Reveal_Shared_Key:
  [ !SharedKey(A, B, k) ]
  --[ LtkReveal(A) ]->
  [ Out(k) ]

rule Initiator_Start:
  [ Fr(~na), !SharedKey(I, R, k) ]
  --[ Test1(), Honest(I), Honest(R) ]->
  [ Out(<~na, 'Init'>), St_I_1(I, R, ~na, k) ]

rule Responder_Respond:
  let tag = h(na XOR k XOR ~nb)
  in
  [ In(<na, 'Init'>), Fr(~nb), !SharedKey(R, I, k) ]
  --[ Test2(), Honest(R), Honest(I), Running(R, I, tag) ]->
  [ Out(<tag, ~nb>) ]

rule Initiator_Finish:
  let expected = h(na XOR k XOR nb)
  in
  [ St_I_1(I, R, na, k), In(<tag, nb>) ]
  --[ Test3(), Honest(I), Honest(R), Eq(tag, expected), Commit(I, R, tag) ]->
  [ ]

restriction Equality:
  "All x y #i. Eq(x, y) @ #i ==> x = y"

// category: secrecy
lemma shared_key_secrecy:
  "All A B k #i.
     Secret(A, B, k) @ #i
   ==>
       not (Ex #j. K(k) @ #j)
     | (Ex X #r. LtkReveal(X) @ #r & Honest(X) @ #i)"

// category: aliveness
lemma responder_aliveness:
  "All a b t #i.
     Commit(a, b, t) @ #i
   ==>
       (Ex id #j. Create(b, id) @ #j)
     | (Ex X #r. LtkReveal(X) @ #r & Honest(X) @ #i)"

// category: noninjective_agreement
lemma tag_noninjective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ #i
   ==>
       (Ex #j. Running(b, a, t) @ #j)
     | (Ex X #r. LtkReveal(X) @ #r & Honest(X) @ #i)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

end
