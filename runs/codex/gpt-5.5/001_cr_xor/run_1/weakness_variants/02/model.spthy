theory CrXorNoKvfy
begin

builtins: hashing, xor

restriction Equality:
  "All x y #i. Eq(x, y) @ #i ==> x = y"

rule Register_Shared_Key:
  [ Fr(~k) ]
  --[ ]->
  [ !SharedKey($I, $R, ~k) ]

rule Reveal_Initiator_Key:
  [ !SharedKey(I, R, k) ]
  --[ LtkReveal(I) ]->
  [ Out(k) ]

rule Reveal_Responder_Key:
  [ !SharedKey(I, R, k) ]
  --[ LtkReveal(R) ]->
  [ Out(k) ]

rule Initiator_Send_Challenge:
  [ Fr(~na), !SharedKey($I, $R, k) ]
  --[ Test1(), Create($I, ~na) ]->
  [ Out(~na), St_I_1($I, $R, ~na) ]

rule Responder_Send_Tag:
  let tag = h(na XOR k XOR ~nb) in
  [ In(na), Fr(~nb), !SharedKey($I, $R, k) ]
  --[ Test2(), Create($R, ~nb), Running($R, $I, <'verification_tag', tag>) ]->
  [ Out(<tag, ~nb>) ]

rule Initiator_Accept:
  let expected = h(na XOR nb) in
  [ St_I_1($I, $R, na), In(<tag, nb>) ]
  --[ Test3(), Eq(tag, expected), Commit($I, $R, <'verification_tag', tag>), Honest($I), Honest($R) ]->
  [ ]

// category: aliveness
lemma responder_aliveness:
  "All a b t #i.
     Commit(a, b, t) @ #i
   ==>
       (Ex id #j. Create(b, id) @ #j)
     | (Ex X #r. LtkReveal(X) @ #r & Honest(X) @ #i)"

// category: noninjective_agreement
lemma verification_tag_noninjective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ #i
   ==>
       (Ex #j. Running(b, a, t) @ #j)
     | (Ex X #r. LtkReveal(X) @ #r & Honest(X) @ #i)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

end
