theory Lak06
begin

builtins: hashing, xor

functions: tagmac/3, readermac/3

rule Provision:
  [ Fr(~k) ]
  --[ Create('Reader', ~k), Create('Tag', ~k), Secret('Reader', 'Tag', ~k), Honest('Reader'), Honest('Tag') ]->
  [ !Ltk('Reader', 'Tag', ~k) ]

rule Reveal_Ltk:
  [ !Ltk('Reader', 'Tag', k) ]
  --[ LtkReveal('Reader'), LtkReveal('Tag') ]->
  [ Out(k) ]

rule Reader_Start:
  [ !Ltk('Reader', 'Tag', k), Fr(~r0) ]
  --[ Test1(), Create('Reader', <~r0, k>) ]->
  [ Out(~r0), St_R_1('Reader', 'Tag', k, ~r0) ]

rule Tag_Response:
  let tag_mac = tagmac(r0, ~r1, k) in
  [ !Ltk('Reader', 'Tag', k), In(r0), Fr(~r1) ]
  --[ Test2(), Create('Tag', <r0, ~r1, k>), Running('Tag', 'Reader', <r0, ~r1, k>) ]->
  [ Out(<~r1, tag_mac>), St_T_1('Tag', 'Reader', k, r0, ~r1, tag_mac), !TagMac(r0, ~r1, k) ]

rule Reader_Confirm:
  let
    tag_mac = tagmac(~r0, r1, k)
    reader_mac = readermac(tag_mac, k, ~r0)
  in
  [ St_R_1('Reader', 'Tag', k, ~r0), In(<r1, tag_mac>) ]
  --[ Test3(), Honest('Reader'), Honest('Tag'), Running('Reader', 'Tag', <~r0, r1, k>), Commit('Reader', 'Tag', <~r0, r1, k>) ]->
  [ Out(<'CONF', reader_mac>) ]

rule Tag_Accept:
  let reader_mac = readermac(tag_mac, k, r0) in
  [ St_T_1('Tag', 'Reader', k, r0, ~r1, tag_mac), In(<'CONF', reader_mac>) ]
  --[ Test4(), Honest('Reader'), Honest('Tag'), Commit('Tag', 'Reader', <r0, ~r1, k>) ]->
  [ ]

rule Xor_Offset_Attack:
  [ !TagMac(r0_tag, r1_tag, k), In(<r0_reader, r1_reader>) ]
  --[ ]->
  [ Out(<r1_reader, tagmac(r0_reader, r1_reader, k)>) ]

// category: secrecy
lemma secrecy_ltk:
  "All A B k #i.
     Secret(A, B, k) @ #i
   ==>
       not (Ex #j. K(k) @ #j)
     | (Ex X #r. LtkReveal(X) @ #r & Honest(X) @ #i)"

// category: noninjective_agreement
lemma tag_authenticates_reader:
  "All a b t #i.
     Commit(a, b, t) @ #i & a = 'Tag'
   ==>
       (Ex #j. Running(b, a, t) @ #j)
     | (Ex X #r. LtkReveal(X) @ #r & Honest(X) @ #i)"

// category: injective_agreement
lemma reader_injective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ #i & a = 'Reader'
   ==>
       ( (Ex #j. Running(b, a, t) @ #j
             & #j < #i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ #i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ #r & Honest(X) @ #i)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

end
