theory Lak06
begin

builtins: hashing, xor

functions: tagmac/3, readermac/2

rule Provision:
  [ Fr(~k), Fr(~tag_id) ]
  --[ Secret($R, $T, ~tag_id) ]->
  [ !Ltk($R, $T, ~k), !TagId($T, ~tag_id) ]

rule Reveal_Reader_Tag_Key:
  [ !Ltk($R, $T, k) ]
  --[ LtkReveal($R), LtkReveal($T) ]->
  [ Out(k) ]

rule Reader_Send_R0:
  [ Fr(~r0), !Ltk($R, $T, k) ]
  --[ Test1(), Create($R, ~r0) ]->
  [ Out(~r0), St_Reader_Wait_T1($R, $T, ~r0, k) ]

rule Tag_Send_T1:
  let tag_mac = tagmac(r0, ~r1, k)
  in
  [ Fr(~r1), In(r0), !Ltk($R, $T, k), !TagId($T, tag_id) ]
  --[ Test2(), Create($T, ~r1), Running($T, $R, <'tag', r0, ~r1, tag_mac>) ]->
  [ Out(<~r1, tag_mac>), St_Tag_Wait_R1($R, $T, r0, ~r1, tag_mac) ]

rule Reader_Send_R1:
  let tag_mac = tagmac(r0, r1, k)
      reader_mac = readermac(tag_mac, r0)
  in
  [ St_Reader_Wait_T1($R, $T, r0, k), In(<r1, tag_mac>) ]
  --[ Test3(), Commit($R, $T, <'reader', r0, r1, tag_mac>), Honest($R), Honest($T) ]->
  [ Out(reader_mac) ]

rule Forge_Reader_Mac:
  [ In(r0), In(<r1, tag_mac>) ]
  --[ ]->
  [ Out(readermac(tag_mac, r0)) ]

rule Tag_Accept_R1:
  let reader_mac = readermac(tag_mac, r0)
  in
  [ St_Tag_Wait_R1($R, $T, r0, r1, tag_mac), In(reader_mac) ]
  --[ Test4(), Commit($T, $R, <'tag', r0, r1, tag_mac>), Honest($T), Honest($R) ]->
  [ ]

// category: secrecy
lemma tag_identifier_secrecy:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma tag_noninjective_agreement:
  "All a b r0 r1 tag_mac #i.
     Commit(a, b, <'tag', r0, r1, tag_mac>) @ i
   ==>
       (Ex #j. Running(b, a, <'tag', r0, r1, tag_mac>) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma reader_noninjective_agreement:
  "All a b r0 r1 tag_mac #i.
     Commit(a, b, <'reader', r0, r1, tag_mac>) @ i
   ==>
       (Ex #j. Running(b, a, <'tag', r0, r1, tag_mac>) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

end
