theory SymmetricKeyPmdProfile
begin

builtins: symmetric-encryption

rule Setup_Shared_Key:
  [ Fr(~k) ]
  --[ Create('I', ~k), Create('R', ~k) ]->
  [ !SharedKey('I', 'R', ~k) ]

rule Initiator_Send:
  [ !SharedKey('I', 'R', k), Fr(~sec), Fr(~pub) ]
  --[ Test1(), Secret('I', 'R', ~sec) ]->
  [ Out(<senc(<~sec, ~pub>, k), 'pmd'>) ]

rule Responder_Process:
  [ !SharedKey('I', 'R', k), In(<senc(<sec, pub>, k), tag>) ]
  --[ Test2() ]->
  [ ]

// category: secrecy
lemma secrecy_encapsulated_secret:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)"

lemma executable:
  exists-trace
  "Ex #t1 #t2.
       Test1() @ #t1 & Test2() @ #t2
     & #t1 < #t2"

end
