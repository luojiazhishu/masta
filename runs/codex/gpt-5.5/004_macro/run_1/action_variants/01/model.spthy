theory PublicKeySessionKeyTransport begin

builtins: asymmetric-encryption, hashing

rule Register_Server:
  [ Fr(~ltk) ]
  --[ Create('S', ~ltk) ]->
  [ !Ltk('S', ~ltk), !Pk('S', pk(~ltk)), Out(pk(~ltk)) ]

rule Reveal_Server_Ltk:
  [ !Ltk('S', ltk) ]
  --[ LtkReveal('S') ]->
  [ Out(ltk) ]

rule Client_Send_KeyTransport:
  [ Fr(~k), Fr(~rc), !Pk('S', pkS) ]
  --[ Test1(), Create('C', ~rc), Secret('C', 'S', ~k), Honest('S') ]->
  [ ClientPending('C', 'S', ~rc, ~k), Out(<aenc(~k, pkS), ~rc>) ]

rule Server_Send_KeyConfirm:
  let k = adec(ciphertext, ltkS) in
  [ !Ltk('S', ltkS), In(<ciphertext, rc>) ]
  --[ Test2(), Running('S', 'C', <'transported_key', k>) ]->
  [ Out(<h(k), rc>) ]

rule Client_Accept_KeyConfirm:
  [ ClientPending('C', 'S', rc, k), In(<h(k), rc>) ]
  --[ Test3(), Commit('C', 'S', <'transported_key', k>), Honest('S') ]->
  [ ClientAccepted('C', 'S', rc, k) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

// category: secrecy
lemma secrecy_transport_key:
  "All A B k #i.
     Secret(A, B, k) @ i
   ==>
       not (Ex #j. K(k) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_transport_key:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_transport_key:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end
