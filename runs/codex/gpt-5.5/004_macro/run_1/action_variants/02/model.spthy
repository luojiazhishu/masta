theory PublicKeyKeyTransport
begin

builtins: asymmetric-encryption, hashing

rule Register_Server:
  [ Fr(~ltkS) ]
  --[ ]->
  [ !Ltk('S', ~ltkS), !Pk('S', pk(~ltkS)) ]

rule Reveal_Server_Ltk:
  [ !Ltk('S', ltkS) ]
  --[ LtkReveal('S') ]->
  [ Out(ltkS) ]

rule Client_Send_KeyTransport:
  [ Fr(~k), !Pk('S', pkS) ]
  --[ Test1(), Create('C', ~k) ]->
  [ Out(aenc(~k, pkS)), St_C_1('C', 'S', ~k) ]

rule Server_Process_KeyTransport:
  let k = adec(ciphertext, ltkS)
      digest = h(k)
  in
  [ In(ciphertext), Fr(~rs), !Ltk('S', ltkS) ]
  --[ Test2(), Create('S', ~rs), Running('S', 'C', <'client', k>) ]->
  [ Out(<digest, ~rs>) ]

rule Client_Process_KeyConfirm:
  [ St_C_1('C', 'S', k), In(<h(k), rs>) ]
  --[ Test3(), Commit('C', 'S', <'client', k>), Secret('C', 'S', k), Honest('S') ]->
  [ Accepted('C', 'S', k, rs) ]

// category: secrecy
lemma secrecy_transport_key:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_transport_key:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_transport_key:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

end
