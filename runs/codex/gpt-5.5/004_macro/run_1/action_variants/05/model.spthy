theory PublicKeyKeyTransportDone begin

builtins: asymmetric-encryption, hashing

rule Generate_Server_Key:
  [ Fr(~ltkS) ]
  --[ Create('S'), Honest('S') ]->
  [ !Ltk('S', ~ltkS)
  , !Pk('S', pk(~ltkS))
  , Out(pk(~ltkS))
  ]

rule Reveal_Ltk:
  [ !Ltk(A, ltk) ]
  --[ LtkReveal(A) ]->
  [ Out(ltk) ]

rule Client_Send_KeyTransport:
  [ !Pk('S', pkS)
  , Fr(~k)
  ]
  --[ Test1()
    , Running('C', 'S', <'client', ~k>)
    , Secret('C', 'S', ~k)
    , Honest('S')
    ]->
  [ Client_State('C', 'S', ~k)
  , Out(aenc(~k, pkS))
  ]

rule Server_Recv_KeyTransport_Send_KeyConfirm:
  [ !Ltk('S', ltkS)
  , In(aenc(k, pk(ltkS)))
  ]
  --[ Test2()
    , Running('S', 'C', <'client', k>)
    ]->
  [ Out(<h(k), 'done'>) ]

rule Client_Recv_KeyConfirm_Accept:
  [ Client_State('C', 'S', k)
  , In(<h(k), 'done'>)
  ]
  --[ Test3()
    , Commit('C', 'S', <'client', k>)
    , Honest('S')
    ]->
  [ Accepted('C', 'S', k) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
     Test1() @ #t1
   & Test2() @ #t2
   & Test3() @ #t3
   & #t1 < #t2
   & #t2 < #t3"

// category: secrecy
lemma session_key_secrecy:
  "All A B k #i.
     Secret(A, B, k) @ #i
   ==> not (Ex #j. K(k) @ #j)
     | (Ex X #r. LtkReveal(X) @ #r & Honest(X) @ #i)"

// category: noninjective_agreement
lemma client_noninjective_agreement_on_key:
  "All a b t #i.
     Commit(a, b, t) @ #i
   ==> (Ex #j. Running(b, a, t) @ #j)
     | (Ex X #r. LtkReveal(X) @ #r & Honest(X) @ #i)"

// category: injective_agreement
lemma client_injective_agreement_on_key:
  "All a b t #i.
     Commit(a, b, t) @ #i
   ==> ( (Ex #j. Running(b, a, t) @ #j
           & #j < #i
           & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ #i2
                  & not (#i2 = #i)))
       | (Ex X #r. LtkReveal(X) @ #r & Honest(X) @ #i) )"

end
