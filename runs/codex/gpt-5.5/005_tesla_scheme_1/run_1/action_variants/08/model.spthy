theory TeslaScheme1 begin

builtins: hashing, signing

functions: mac/2

rule Register_Sender:
  [ Fr(~ltkS) ]
--[ Create($S, ~ltkS) ]->
  [ !Ltk($S, ~ltkS), !Pk($S, pk(~ltkS)), Out(pk(~ltkS)) ]

rule Receiver_Setup_Request:
  [ Fr(~nR) ]
--[ Test1(), Honest($R) ]->
  [ R_Setup_Sent($R, $S, ~nR), Out(<$R, $S, ~nR>) ]

rule Sender_Setup_Response:
  let c1 = h(~k1)
      sig = sign(<c1, nR>, ltkS)
  in
  [ !Ltk($S, ltkS), In(<$R, $S, nR>), Fr(~k1), Fr(~k2), Fr(~m1) ]
--[ Test2(), Running($S, $R, <'setup', c1, nR>), Honest($S) ]->
  [ S_Stream($S, $R, ~k1, ~k2, ~m1, c1, 'channel_tag'),
    Honest_Setup_Response($R, $S, c1, sig),
    Out(<$S, $R, c1, sig>) ]

rule Receiver_Setup_Verify:
  [ R_Setup_Sent($R, $S, nR), !Pk($S, pkS), Honest_Setup_Response($R, $S, c1, sig) ]
--[ Test3(), Eq(verify(sig, <c1, nR>, pkS), true), Commit_Setup($R, $S, <'setup', c1, nR>), Honest($R) ]->
  [ R_Setup_Done($R, $S, c1, 'channel_tag') ]

rule Sender_Broadcast_First:
  let c2 = h(k2)
      d1 = <m1, c2>
  in
  [ S_Stream($S, $R, k1, k2, m1, c1, channel_tag), Fr(~k3), Fr(~m2) ]
--[ Test4(), Running($S, $R, <'stream', channel_tag, m1>), Broadcast($S, channel_tag, m1) ]->
  [ S_After_First($S, $R, k1, k2, ~k3, m1, ~m2, c2, channel_tag),
    Honest_First($R, $S, d1, mac(k1, d1)),
    Out(<d1, mac(k1, d1)>) ]

rule Receiver_Cache_First:
  let d1 = <m1, c2>
  in
  [ R_Setup_Done($R, $S, c1, channel_tag), Honest_First($R, $S, d1, mac1) ]
--[ Test5() ]->
  [ R_Cached_First($R, $S, c1, c2, m1, mac1, channel_tag) ]

rule Sender_Broadcast_Second_Tagged:
  let c3 = h(k3)
      d2 = <m2, c3, k1>
  in
  [ S_After_First($S, $R, k1, k2, k3, m1, m2, c2, channel_tag), Fr(~k4), Fr(~m3) ]
--[ Test6(), Running($S, $R, <'stream', channel_tag, m2>), Broadcast($S, channel_tag, m2), Disclose($S, k1) ]->
  [ S_After_Second($S, $R, k2, k3, ~k4, m2, ~m3, c3, channel_tag),
    Honest_Second($R, $S, d2, mac(k2, d2), channel_tag),
    Out(<d2, mac(k2, d2), channel_tag>),
    Out(k1) ]

rule Receiver_Receive_Second_Accept_First:
  let d2 = <m2, c3, k1>
  in
  [ R_Cached_First($R, $S, c1, c2, m1, mac1, channel_tag), Honest_Second($R, $S, d2, mac2, channel_tag) ]
--[ Test7(), Eq(c1, h(k1)), Eq(mac1, mac(k1, <m1, c2>)), Commit($R, $S, <'stream', channel_tag, m1>) ]->
  [ R_Cached_Second($R, $S, c2, c3, m2, mac2, k1, channel_tag) ]

rule Sender_Broadcast_Third_Tagged:
  let c4 = h(k4)
      d3 = <m3, c4, k2>
  in
  [ S_After_Second($S, $R, k2, k3, k4, m2, m3, c3, channel_tag) ]
--[ Test8(), Running($S, $R, <'stream', channel_tag, m3>), Broadcast($S, channel_tag, m3), Disclose($S, k2) ]->
  [ Honest_Third($R, $S, d3, mac(k3, d3), channel_tag),
    Out(<d3, mac(k3, d3), channel_tag>),
    Out(k2) ]

rule Receiver_Receive_Third_Accept_Second:
  let d3 = <m3, c4, k2>
  in
  [ R_Cached_Second($R, $S, c2, c3, m2, mac2, k1, channel_tag), Honest_Third($R, $S, d3, mac3, channel_tag) ]
--[ Test9(), Eq(c2, h(k2)), Eq(mac2, mac(k2, <m2, c3, k1>)), Commit($R, $S, <'stream', channel_tag, m2>) ]->
  [ R_Accepted($R, $S, m2, channel_tag) ]

restriction Equality:
  "All x y #i. Eq(x, y) @ #i ==> x = y"

rule Reveal_Ltk:
  [ !Ltk(S, ltkS) ]
--[ LtkReveal(S) ]->
  [ Out(ltkS) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4 #t5 #t6 #t7 #t8 #t9.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 &
       Test4() @ #t4 & Test5() @ #t5 & Test6() @ #t6 &
       Test7() @ #t7 & Test8() @ #t8 & Test9() @ #t9 &
       #t1 < #t2 & #t2 < #t3 & #t3 < #t4 & #t4 < #t5 &
       #t5 < #t6 & #t6 < #t7 & #t7 < #t8 & #t8 < #t9"

// category: noninjective_agreement
lemma broadcast_authenticity:
  "All R S stream #i.
     Commit(R, S, stream) @ #i
   ==>
     (Ex #j. Running(S, R, stream) @ #j & #j < #i)
     | (Ex #r #c setup. LtkReveal(S) @ #r & Commit_Setup(R, S, setup) @ #c & #r < #c)"

end
