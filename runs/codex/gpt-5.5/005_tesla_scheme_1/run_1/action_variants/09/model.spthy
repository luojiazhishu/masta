theory TeslaSchemeOne
begin

builtins: hashing, signing

functions: mac/2, f/1, aux/1

rule Register_Sender:
  [ Fr(~sk) ]
  --[ Create($S, ~sk) ]->
  [ !Ltk($S, ~sk), !Pk($S, pk(~sk)), Out(pk(~sk)) ]

rule Reveal_Ltk:
  [ !Ltk(A, sk) ]
  --[ LtkReveal(A) ]->
  [ Out(sk) ]

rule Receiver_Setup_Request:
  [ Fr(~nR) ]
  --[ Test1(), Create($R, ~nR) ]->
  [ Out(<$R, $S, ~nR>), St_R_Setup($R, $S, ~nR) ]

rule Sender_Setup_Response:
  [ In(<R, S, nR>), !Ltk(S, sk), Fr(~k1) ]
  --[ Test2(), Running(S, R, <'setup', f(~k1), nR>) ]->
  [ Out(<S, R, f(~k1), sign(<f(~k1), nR>, sk)>),
    St_S_Stream(S, R, ~k1, f(~k1), nR) ]

rule Receiver_Stores_Setup:
  [ St_R_Setup(R, S, nR), In(<S, R, fk1, sig>), !Pk(S, pkS) ]
  --[ Eq(verify(sig, <fk1, nR>, pkS), true), Test3() ]->
  [ St_R_Stream(R, S, fk1, nR) ]

rule Sender_First_Broadcast_And_Audit:
  [ St_S_Stream(S, R, k1, fk1, nR), Fr(~k2), Fr(~m1) ]
  --[ Test4(), Running(S, R, <'broadcast', ~m1, fk1, f(~k2)>), Secret(S, R, aux(~m1)) ]->
  [ Out(<<~m1, f(~k2)>, mac(k1, <~m1, f(~k2)>)>),
    !SentFirst(S, R, ~m1, fk1, f(~k2), mac(k1, <~m1, f(~k2)>)),
    AuditLog(S, aux(~m1)),
    St_S_After_First(S, R, k1, ~k2, ~m1, fk1, f(~k2), nR) ]

rule Receiver_Buffers_First_Message:
  [ St_R_Stream(R, S, fk1, nR),
    In(<<m1, fk2>, tag>),
    !SentFirst(S, R, m1, fk1, fk2, tag) ]
  --[ Test5() ]->
  [ St_R_Buffered(R, S, m1, fk1, fk2, tag, nR) ]

rule Sender_Subsequent_Broadcast_Discloses_K1:
  [ St_S_After_First(S, R, k1, k2, m1, fk1, fk2, nR), Fr(~k3), Fr(~m2) ]
  --[ Test6(), Running(S, R, <'disclose', k1, fk1>) ]->
  [ Out(<<~m2, f(~k3), k1>, mac(k2, <~m2, f(~k3), k1>)>) ]

rule Receiver_Accepts_First_Payload:
  [ St_R_Buffered(R, S, m1, fk1, fk2, tag, nR),
    In(<<m2, fk3, k1>, tag2>) ]
  --[ Eq(f(k1), fk1), Eq(tag, mac(k1, <m1, fk2>)), Test7(), Commit(R, S, <'broadcast', m1, fk1, fk2>), Honest(S) ]->
  [ Out('accept') ]

restriction Equality:
  "All x y #i. Eq(x, y) @ i ==> x = y"

// category: noninjective_agreement
lemma broadcast_authenticity:
  "All r s t #i.
     Commit(r, s, t) @ i
   ==>
       (Ex #j. Running(s, r, t) @ j & j < i)
     | (Ex #r. LtkReveal(s) @ #r & #r < i & Honest(s) @ i)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4 #t5 #t6 #t7.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & Test5() @ #t5 & Test6() @ #t6 & Test7() @ #t7
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4 & #t4 < #t5 & #t5 < #t6 & #t6 < #t7"

end
