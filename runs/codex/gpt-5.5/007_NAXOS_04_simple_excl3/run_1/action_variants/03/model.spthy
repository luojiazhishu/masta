theory Simplified_NAXOS begin

builtins: diffie-hellman

functions: h1/1, h2/1

rule Generate_DH_key_pair:
  [ Fr(~lk) ]
  --[ Register($A) ]->
  [ !Ltk($A, ~lk)
  , !Pk($A, 'g'^~lk)
  , Out('g'^~lk)
  ]

rule Reveal_ltk:
  [ !Ltk($A, ~lk) ]
  --[ LtkReveal($A) ]->
  [ Out(~lk) ]

rule Initiator_1:
  let
    exI = h1(<~eskI, ~lkI>)
    hkI = 'g'^exI
  in
  [ Fr(~eskI)
  , Fr(~tidI)
  , !Ltk($I, ~lkI)
  , !Pk($R, pkR)
  ]
  --[ Test1()
    , Create($I, ~tidI)
    , Running($I, $R, <hkI, pkR>)
    ]->
  [ Out(hkI)
  , InitState(~tidI, $I, $R, ~lkI, exI, hkI, pkR)
  ]

rule Responder_2:
  let
    exR = h1(<~eskR, ~lkR>)
    hkR = 'g'^exR
    kR = h2(<pkI^exR, X^~lkR, $I, $R>)
  in
  [ In(X)
  , Fr(~eskR)
  , Fr(~tidR)
  , !Ltk($R, ~lkR)
  , !Pk($I, pkI)
  ]
  --[ Test2()
    , Create($R, ~tidR)
    , Running($R, $I, <kR, X, hkR, 'NAXOS-v1'>)
    , Secret($R, $I, kR)
    , CommitR($R, $I, <kR, X, hkR, 'NAXOS-v1'>)
    ]->
  [ Out(<hkR, 'NAXOS-v1'>) ]

rule Initiator_3:
  let
    kI = h2(<Y^~lkI, pkR^exI, $I, $R>)
  in
  [ InitState(~tidI, $I, $R, ~lkI, exI, hkI, pkR)
  , In(<Y, 'NAXOS-v1'>)
  ]
  --[ Test3()
    , CommitI($I, $R, <kI, hkI, Y, 'NAXOS-v1'>)
    , Secret($I, $R, kI)
    ]->
  [ ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

// category: secrecy
lemma session_key_secrecy:
  "All A B k #i.
     Secret(A, B, k) @ #i
   ==>
       not (Ex #j. K(k) @ #j)
     | (Ex #r. LtkReveal(A) @ #r)
     | (Ex #r. LtkReveal(B) @ #r)"

// category: aliveness
lemma initiator_aliveness:
  "All I R t #i.
     CommitI(I, R, t) @ #i
   ==>
       (Ex id #j. Create(R, id) @ #j)
     | (Ex #r. LtkReveal(I) @ #r)
     | (Ex #r. LtkReveal(R) @ #r)"

// category: weak_agreement
lemma initiator_weak_agreement:
  "All I R t #i.
     CommitI(I, R, t) @ #i
   ==>
       (Ex t2 #j. Running(R, I, t2) @ #j)
     | (Ex #r. LtkReveal(I) @ #r)
     | (Ex #r. LtkReveal(R) @ #r)"

// category: aliveness
lemma responder_aliveness:
  "All R I t #i.
     CommitR(R, I, t) @ #i
   ==>
       (Ex id #j. Create(I, id) @ #j)
     | (Ex #r. LtkReveal(R) @ #r)
     | (Ex #r. LtkReveal(I) @ #r)"

// category: weak_agreement
lemma responder_weak_agreement:
  "All R I t #i.
     CommitR(R, I, t) @ #i
   ==>
       (Ex t2 #j. Running(I, R, t2) @ #j)
     | (Ex #r. LtkReveal(R) @ #r)
     | (Ex #r. LtkReveal(I) @ #r)"

// category: noninjective_agreement
lemma initiator_noninjective_agreement:
  "All I R k X Y tag #i.
     CommitI(I, R, <k, X, Y, tag>) @ #i
   ==>
       (Ex #j. Running(R, I, <k, X, Y, tag>) @ #j)
     | (Ex #r. LtkReveal(I) @ #r)
     | (Ex #r. LtkReveal(R) @ #r)"

end
