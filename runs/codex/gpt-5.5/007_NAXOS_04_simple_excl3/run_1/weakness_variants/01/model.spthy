theory Simplified_NAXOS_S begin

builtins: diffie-hellman, hashing

rule Register:
  [ Fr(~ltk) ]
  --[ Create($A, ~ltk), Honest($A) ]->
  [ !Ltk($A, ~ltk), Out('g'^~ltk) ]

rule Reveal_ltk:
  [ !Ltk(A, ltk) ]
  --[ LtkReveal(A) ]->
  [ Out(ltk) ]

rule Initiator_Message1:
  let exI = h(<~eskI, ltkI>)
      hkI = h(<'hkI', exI>)
  in
  [ Fr(~eskI), !Ltk($I, ltkI), !Ltk($R, ltkR) ]
  --[ Test1() ]->
  [ Out(hkI), St_I_1($I, $R, ltkI, ltkR, exI, hkI) ]

rule Responder_Message2:
  let exR = h(<~eskR, ltkR>)
      hkR = h(<'hkR', exR>)
      kR  = h(<'kR', X, ltkI, ltkR, exR, $I, $R>)
  in
  [ Fr(~eskR), In(X), !Ltk($R, ltkR), !Ltk($I, ltkI) ]
  --[ Test2(), Running($R, $I, <kR, X, hkR>), Secret($R, $I, kR) ]->
  [ Out(hkR) ]

rule Initiator_Finish:
  let kI = h(<'kI', Y, ltkI, ltkR, exI, I, R>)
  in
  [ In(Y), St_I_1(I, R, ltkI, ltkR, exI, hkI) ]
  --[ Test3(), Commit(I, R, <kI, hkI, Y>), Secret(I, R, kI) ]->
  [ Out(kI) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1
     & Test2() @ #t2
     & Test3() @ #t3
     & #t1 < #t2
     & #t2 < #t3"

// category: secrecy
lemma session_key_secrecy:
  "All A B k #i.
     Secret(A, B, k) @ #i
   ==>
       not (Ex #j. K(k) @ #j)
     | (Ex X #r. LtkReveal(X) @ #r & Honest(X) @ #i)"

// category: noninjective_agreement
lemma initiator_noninjective_agreement:
  "All I R t #i.
     Commit(I, R, t) @ #i
   ==>
       (Ex #j. Running(R, I, t) @ #j & #j < #i)
     | (Ex X #r. LtkReveal(X) @ #r & Honest(X) @ #i)"

end
