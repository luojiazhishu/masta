theory SimplifiedNaxos
begin

builtins: diffie-hellman

functions: h1/1, h2/1

rule Register_pk:
  [ Fr(~lk) ]
  --[ Honest($A) ]->
  [ !Ltk($A, ~lk)
  , !Pk($A, 'g'^~lk)
  , Out($A)
  , Out('g'^~lk)
  ]

rule Reveal_ltk:
  [ !Ltk(A, lk) ]
  --[ LtkReveal(A) ]->
  [ Out(lk) ]

rule Initiator_1:
  let
    hkI = 'g'^h1(<~eskI, lkI>)
  in
  [ Fr(~eskI)
  , Fr(~tidI)
  , !Ltk($I, lkI)
  , !Pk($R, pkR)
  ]
  --[ Test1()
    , Create($I, ~tidI)
    , Running($I, $R, <'init', h2(<$I, $R>)>)
    ]->
  [ Out(<$I, $R, hkI>)
  , Init_1(~tidI, $I, $R, h2(<$I, $R>))
  ]

rule Responder_1:
  let
    hkR = 'g'^h1(<~eskR, lkR>)
    kR = h2(<I, R>)
  in
  [ In(<I, R, hkI>)
  , Fr(~eskR)
  , Fr(~tidR)
  , !Ltk(R, lkR)
  , !Pk(I, pkI)
  ]
  --[ Test2()
    , Create(R, ~tidR)
    , Running(R, I, <'resp', kR>)
    , Commit(R, I, <'resp', kR>)
    , Secret(R, I, kR)
    , Honest(R)
    ]->
  [ Out(<R, I, hkR>)
  ]

rule Initiator_2:
  let
    kI = h2(<I, R>)
  in
  [ Init_1(tidI, I, R, kI)
  , In(<R, I, hkR>)
  ]
  --[ Test3()
    , Commit(I, R, <'init', kI>)
    , Secret(I, R, kI)
    , Honest(I)
    ]->
  [ ]

// category: secrecy
lemma secrecy_session_key:
  "All A B k #i.
     Secret(A, B, k) @ i
   ==>
       not (Ex #j. K(k) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

end
