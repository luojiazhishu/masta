theory MutualIdentitySignatureInitiatorNonce
begin

builtins: signing

restriction Equality:
  "All x y #i. Eq(x, y) @ #i ==> x = y"

rule Register:
  [ Fr(~ltk) ]
  --[ Create($A, ~ltk) ]->
  [ !Ltk($A, ~ltk), !Pk($A, pk(~ltk)), Out(pk(~ltk)) ]

rule Reveal_ltk:
  [ !Ltk(A, ltk) ]
  --[ LtkReveal(A) ]->
  [ Out(ltk) ]

rule Initiator_Send:
  let payload = <I, R>
      mI = sign(payload, ltkI)
  in
  [ Fr(~rn), !Ltk(I, ltkI), !Pk(R, pkR) ]
  --[ Test1(), Running(I, R, <'identity', I, R>), Running(I, R, <'session', I, R, ~rn>) ]->
  [ Out(<mI, ~rn>), St_I_1(I, R, ~rn) ]

rule Responder_Receive_Send:
  let payload = <I, R>
      mR = sign(payload, ltkR)
  in
  [ In(<s, rn>), !Pk(I, pkI), !Ltk(R, ltkR) ]
  --[ Test2(), Eq(verify(s, payload, pkI), true), Running(R, I, <'identity', I, R>), Commit(R, I, <'identity', I, R>), Commit(R, I, <'session', I, R, rn>), Honest(R), Honest(I) ]->
  [ Out(mR) ]

rule Initiator_Receive_Accept:
  let payload = <I, R>
  in
  [ St_I_1(I, R, rn), In(s), !Pk(R, pkR) ]
  --[ Test3(), Eq(verify(s, payload, pkR), true), Commit(I, R, <'identity', I, R>), Honest(I), Honest(R) ]->
  [ ]

// category: weak_agreement
lemma weak_agreement_identity:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex t2 #j. Running(b, a, t2) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_identity:
  "All a b I R #i.
     Commit(a, b, <'identity', I, R>) @ i
   ==>
       (Ex #j. Running(b, a, <'identity', I, R>) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_identity:
  "All a b I R #i.
     Commit(a, b, <'identity', I, R>) @ i
   ==>
       ( (Ex #j. Running(b, a, <'identity', I, R>) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, <'identity', I, R>) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_session:
  "All a b I R rn #i.
     Commit(a, b, <'session', I, R, rn>) @ i
   ==>
       (Ex #j. Running(b, a, <'session', I, R, rn>) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_session:
  "All a b I R rn #i.
     Commit(a, b, <'session', I, R, rn>) @ i
   ==>
       ( (Ex #j. Running(b, a, <'session', I, R, rn>) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, <'session', I, R, rn>) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

end
