theory MutualIdentitySignatureResponderTag
begin

builtins: signing

functions: resp/0

restriction setup_once:
  "All #i #j. SetupOnce() @ i & SetupOnce() @ j ==> #i = #j"

rule Setup:
  [ Fr(~ltkI), Fr(~ltkR) ]
  --[ SetupOnce(), Create('I', ~ltkI), Create('R', ~ltkR) ]->
  [ !Ltk('I', ~ltkI), !Ltk('R', ~ltkR), !Pk('I', pk(~ltkI)), !Pk('R', pk(~ltkR)), Out(pk(~ltkI)), Out(pk(~ltkR)) ]

rule Reveal_Ltk:
  [ !Ltk(A, ltk) ]
  --[ LtkReveal(A) ]->
  [ Out(ltk) ]

rule Initiator_Send:
  [ !Ltk('I', ltkI), !Pk('R', pkR) ]
  --[ Test1(), Running('I', 'R', <'initiator', 'I', 'R'>) ]->
  [ Out(sign(<'I', 'R'>, ltkI)), St_I_1() ]

rule Responder_Receive_Send:
  [ !Ltk('I', ltkI), !Ltk('R', ltkR), In(sign(<'I', 'R'>, ltkI)) ]
  --[ Test2(), Running('R', 'I', <'responder', 'I', 'R'>), Commit('R', 'I', <'initiator', 'I', 'R'>), Honest('I'), Honest('R') ]->
  [ Out(<sign(<'I', 'R'>, ltkR), resp>) ]

rule Initiator_Receive_Accept:
  [ St_I_1(), !Ltk('R', ltkR), In(<sign(<'I', 'R'>, ltkR), resp>) ]
  --[ Test3(), Commit('I', 'R', <'responder', 'I', 'R'>), Honest('I'), Honest('R') ]->
  [ ]

// category: weak_agreement
lemma weak_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex t2 #j. Running(b, a, t2) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

end
