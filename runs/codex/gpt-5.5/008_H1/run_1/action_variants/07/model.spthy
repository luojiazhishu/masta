theory MutualIdentitySignatureInitiatorResend begin

builtins: signing

restriction DistinctIdentities:
  "All x #i. Neq(x, x) @ #i ==> F"

rule Register_pk:
  [ Fr(~ltk) ]
  -->
  [ !Ltk($A, ~ltk)
  , !Pk($A, pk(~ltk))
  , Out(pk(~ltk))
  ]

rule Reveal_ltk:
  [ !Ltk(A, ltk) ]
  --[ LtkReveal(A) ]->
  [ Out(ltk) ]

rule Initiator_Send_First:
  let mI = sign(<$I, $R>, ltkI)
  in
  [ Fr(~sidI)
  , !Ltk($I, ltkI)
  , !Pk($R, pkR)
  ]
  --[ Test1()
    , Neq($I, $R)
    , Create($I, ~sidI)
    , Running($I, $R, <'initiator', $I, $R>)
    ]->
  [ Out(mI)
  , St_I_1($I, $R, ~sidI, mI)
  ]

rule Initiator_Send_Second:
  [ St_I_1($I, $R, ~sidI, mI) ]
  --[ Test2() ]->
  [ Out(mI)
  , St_I_2($I, $R, ~sidI, mI)
  ]

rule Responder_Process_First:
  let mR = sign(<$I, $R>, ltkR)
  in
  [ Fr(~sidR)
  , In(sign(<$I, $R>, ltkI))
  , !Ltk($I, ltkI)
  , !Ltk($R, ltkR)
  ]
  --[ Test3()
    , Neq($I, $R)
    , Create($R, ~sidR)
    , Running($R, $I, <'responder', $I, $R>)
    , Commit($R, $I, <'initiator', $I, $R>)
    , Honest($I)
    , Honest($R)
    ]->
  [ Out(mR) ]

rule Initiator_Verify_Response:
  [ St_I_2($I, $R, ~sidI, mI)
  , In(sign(<$I, $R>, ltkR))
  , !Ltk($R, ltkR)
  ]
  --[ Test4()
    , Neq($I, $R)
    , Commit($I, $R, <'responder', $I, $R>)
    , Honest($I)
    , Honest($R)
    ]->
  [ ]

// category: weak_agreement
lemma weak_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex t2 #j. Running(b, a, t2) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

end
