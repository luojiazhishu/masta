theory MutualIdentitySignatureUnverifiedReply
begin

builtins: signing

restriction Equality:
  "All x y #i. Eq(x, y) @ #i ==> x = y"

rule Register:
  [ Fr(~ltk) ]
  --[ Create($A, ~ltk) ]->
  [ !Ltk($A, ~ltk), !Pk($A, pk(~ltk)), Out(pk(~ltk)) ]

rule Reveal_Ltk:
  [ !Ltk(A, ltk) ]
  --[ LtkReveal(A) ]->
  [ Out(ltk) ]

rule Initiator_Send:
  let mI = sign(<I, R>, ltkI)
  in
  [ !Ltk(I, ltkI), !Pk(R, pkR), Fr(~sid) ]
  --[ Test1(), Create(I, ~sid), Running(I, R, <'initiator', I, R>), Honest(I), Honest(R) ]->
  [ Out(mI), St_I_1(I, R, ~sid) ]

rule Responder_Receive_Send:
  let mR = sign(<I, R>, ltkR)
  in
  [ In(mI), !Pk(I, pkI), !Ltk(R, ltkR), Fr(~sidR) ]
  --[ Test2(), Eq(verify(mI, <I, R>, pkI), true), Create(R, ~sidR), Running(R, I, <'responder', I, R>), Commit(R, I, <'initiator', I, R>), Honest(I), Honest(R) ]->
  [ Out(mR) ]

rule Initiator_Receive_Accept:
  [ St_I_1(I, R, sid), In(m) ]
  --[ Test3(), Commit(I, R, <'responder', I, R>), Honest(I), Honest(R) ]->
  [ ]

// category: weak_agreement
lemma weak_agreement_responder_to_initiator:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex t2 #j. Running(b, a, t2) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_responder_to_initiator:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_responder_to_initiator:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

end
