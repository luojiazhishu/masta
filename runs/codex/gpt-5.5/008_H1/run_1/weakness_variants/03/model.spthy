theory MutualIdentitySignatureConstantReply begin

builtins: signing

restriction Equality:
  "All x y #i. Eq(x,y) @ #i ==> x = y"

rule Register:
  [ Fr(~ltk), In(A) ]
  --[ Create(A, ~ltk) ]->
  [ !Ltk(A, ~ltk), !Pk(A, pk(~ltk)), Out(pk(~ltk)) ]

rule Reveal_ltk:
  [ !Ltk(A, ltk) ]
  --[ LtkReveal(A) ]->
  [ Out(ltk) ]

rule Initiator_Send:
  let mI = sign(<I, R>, ltkI)
  in
  [ !Ltk(I, ltkI), !Pk(R, pkR) ]
  --[ Test1(), InitStart(I, R, <I, R>), Honest(I), Honest(R) ]->
  [ I_State(I, R, <I, R>), Out(mI) ]

rule Responder_Reply:
  let expected = <I, R>
      mR = sign('msg', ltkR)
  in
  [ !Ltk(R, ltkR), !Pk(I, pkI), In(mI) ]
  --[ Test2(), Eq(verify(mI, expected, pkI), true), Running(R, I, expected), Honest(R), Honest(I) ]->
  [ Out(mR) ]

rule Initiator_Accept:
  [ I_State(I, R, t), !Pk(R, pkR), In(mR) ]
  --[ Test3(), Eq(verify(mR, 'msg', pkR), true), Commit(I, R, t), Honest(I), Honest(R) ]->
  [ ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

// category: weak_agreement
lemma weak_agreement:
  "All a b t #i.
     Commit(a, b, t) @ #i
   ==>
       (Ex t2 #j. Running(b, a, t2) @ #j)
     | (Ex X #r. LtkReveal(X) @ #r & Honest(X) @ #i)"

// category: noninjective_agreement
lemma noninjective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ #i
   ==>
       (Ex #j. Running(b, a, t) @ #j)
     | (Ex X #r. LtkReveal(X) @ #r & Honest(X) @ #i)"

// category: injective_agreement
lemma injective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ #i
   ==>
       ( (Ex #j. Running(b, a, t) @ #j
             & #j < #i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ #i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ #r & Honest(X) @ #i)"

end
