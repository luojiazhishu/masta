theory LoRaWAN10_Join_Basic begin

builtins: symmetric-encryption

functions: mac/2

rule Register:
  [ Fr(~appkey), Fr(~deveui), Fr(~joineui), Fr(~devaddr) ]
--[ Create('Device', ~deveui), Create('Server', ~joineui) ]->
  [ !Provisioned('Device', 'Server', ~deveui, ~joineui, ~appkey, ~devaddr) ]

rule Device_JoinRequest:
  let req_body = <'JoinRequest', deveui, joineui, ~devnonce>
      req_mac = mac(appkey, req_body)
  in
  [ !Provisioned('Device', 'Server', deveui, joineui, appkey, devaddr), Fr(~devnonce) ]
--[ Test1(), Running('Device', 'Server', <appkey, deveui, joineui, ~devnonce>), RunningDeviceRequest('Device', 'Server', <appkey, deveui, joineui, ~devnonce>) ]->
  [ Out(<'JoinRequest', deveui, joineui, ~devnonce, req_mac>),
    DevicePending('Device', 'Server', deveui, joineui, appkey, devaddr, ~devnonce) ]

rule Server_JoinAccept:
  let req_body = <'JoinRequest', deveui, joineui, devnonce>
      req_mac = mac(appkey, req_body)
      appskey = senc(<'cst1', devnonce, ~joinnonce>, appkey)
      nwkskey = senc(<'cst2', devnonce, ~joinnonce>, appkey)
      resp_body = <'JoinAcceptBody', deveui, joineui, devaddr, devnonce, ~joinnonce, mac(appkey, <'JoinAcceptBody', deveui, joineui, devaddr, devnonce, ~joinnonce>)>
      ciphertext = senc(resp_body, appkey)
      tuple = <appkey, devnonce, ~joinnonce>
      keys = <appskey, nwkskey>
  in
  [ !Provisioned('Device', 'Server', deveui, joineui, appkey, devaddr),
    In(<'JoinRequest', deveui, joineui, devnonce, req_mac>),
    Fr(~joinnonce) ]
--[ Test2(), Running('Server', 'Device', tuple), CommitServerRequest('Server', 'Device', <appkey, deveui, joineui, devnonce>), RunningKeys('Server', 'Device', keys), CommitKeys('Server', 'Device', keys), Secret(appskey), Secret(nwkskey) ]->
  [ Out(<ciphertext, 'LoRa-1.0'>) ]

rule Device_JoinAccept:
  let resp_mac = mac(appkey, <'JoinAcceptBody', deveui, joineui, devaddr, accepted_devnonce, joinnonce>)
      resp_body = <'JoinAcceptBody', deveui, joineui, devaddr, accepted_devnonce, joinnonce, resp_mac>
      ciphertext = senc(resp_body, appkey)
      appskey = senc(<'cst1', accepted_devnonce, joinnonce>, appkey)
      nwkskey = senc(<'cst2', accepted_devnonce, joinnonce>, appkey)
      tuple = <appkey, devnonce, joinnonce>
      server_tuple = <appkey, accepted_devnonce, joinnonce>
      keys = <appskey, nwkskey>
  in
  [ DevicePending('Device', 'Server', deveui, joineui, appkey, devaddr, devnonce),
    In(<ciphertext, 'LoRa-1.0'>) ]
--[ Test3(), CommitDeviceAttempt('Device', 'Server', tuple), CommitDeviceServerTuple('Device', 'Server', server_tuple), CommitKeys('Device', 'Server', keys), Secret(appskey), Secret(nwkskey) ]->
  [ DeviceJoined('Device', 'Server', tuple, keys) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

// category: injective_agreement
lemma device_injective_agreement:
  "All a b t #i.
     CommitDeviceServerTuple(a, b, t) @ #i
   ==>
     (Ex #j. Running(b, a, t) @ #j & #j < #i
       & not (Ex a2 b2 #i2. CommitDeviceServerTuple(a2, b2, t) @ #i2 & not (#i2 = #i)))"

// category: noninjective_agreement
lemma device_noninjective_agreement:
  "All a b t #i.
     CommitDeviceServerTuple(a, b, t) @ #i
   ==>
     (Ex #j. Running(b, a, t) @ #j & #j < #i)"

// category: injective_agreement
lemma server_injective_agreement:
  "All a b t #i.
     CommitServerRequest(a, b, t) @ #i
   ==>
     (Ex #j. RunningDeviceRequest(b, a, t) @ #j & #j < #i
       & not (Ex a2 b2 #i2. CommitServerRequest(a2, b2, t) @ #i2 & not (#i2 = #i)))"

// category: noninjective_agreement
lemma server_noninjective_agreement:
  "All a b t #i.
     CommitServerRequest(a, b, t) @ #i
   ==>
     (Ex #j. RunningDeviceRequest(b, a, t) @ #j & #j < #i)"

// category: injective_agreement
lemma session_keys_injective_agreement:
  "All a b k #i.
     CommitKeys(a, b, k) @ #i & a = 'Device'
   ==>
     (Ex #j. RunningKeys(b, a, k) @ #j & #j < #i
       & not (Ex a2 b2 #i2. CommitKeys(a2, b2, k) @ #i2 & not (#i2 = #i)))"

// category: noninjective_agreement
lemma session_keys_noninjective_agreement:
  "All a b k #i.
     CommitKeys(a, b, k) @ #i & a = 'Device'
   ==>
     (Ex #j. RunningKeys(b, a, k) @ #j & #j < #i)"

// category: secrecy
lemma session_keys_secrecy:
  "All k #i.
     Secret(k) @ #i
   ==> not (Ex #j. K(k) @ #j)"

end
