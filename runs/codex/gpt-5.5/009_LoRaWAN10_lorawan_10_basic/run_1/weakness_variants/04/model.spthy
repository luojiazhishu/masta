theory LoRaWAN10Basic
begin

builtins: symmetric-encryption

functions: mac/2

rule Provision:
  [ Fr(~appkey) ]
  --[ ]->
  [ !AppKey($Device, $Server, ~appkey) ]

rule Device_Send_JoinRequest:
  let
    req_body = <'JoinRequest', $Device, $Server, ~devnonce>
    req_mac = mac(~appkey, req_body)
  in
  [ Fr(~devnonce), !AppKey($Device, $Server, ~appkey) ]
  --[ Test1(),
      Create($Device, ~devnonce),
      Running($Device, $Server, <'device_join', $Device, $Server, ~devnonce>)
    ]->
  [ Out(<'JoinRequest', $Device, $Server, ~devnonce, req_mac>),
    SentJoinRequest($Device, $Server, ~appkey, ~devnonce),
    St_Device_WaitAccept($Device, $Server, ~appkey, ~devnonce)
  ]

rule Server_Recv_JoinRequest_Send_JoinAccept:
  let
    app_s_key = senc(<'cst1', devnonce, ~joinnonce>, appkey)
    nwk_s_key = senc(<'cst2', devnonce, ~joinnonce>, appkey)
    resp_mac = mac(appkey, <'JoinAccept', ~joinnonce, 'devaddr'>)
    accept_body = <'JoinAccept', ~joinnonce, 'devaddr', resp_mac>
  in
  [ Fr(~joinnonce),
    SentJoinRequest(device, server, appkey, devnonce)
  ]
  --[ Test2(),
      Create(server, ~joinnonce),
      Running(server, device, <'device_session', device, server, devnonce, ~joinnonce, app_s_key, nwk_s_key>),
      Running(server, device, <'session_keys', device, server, devnonce, ~joinnonce, app_s_key, nwk_s_key>),
      Running(server, device, <'device_join', device, server, devnonce>),
      Commit(server, device, <'device_join', device, server, devnonce>),
      Honest(device),
      Honest(server)
    ]->
  [ Out(senc(accept_body, appkey)),
    SentJoinAccept(device, server, appkey, devnonce, ~joinnonce)
  ]

rule Device_Recv_JoinAccept_Derive_Keys:
  let
    app_s_key = senc(<'cst1', devnonce, joinnonce>, appkey)
    nwk_s_key = senc(<'cst2', devnonce, joinnonce>, appkey)
    resp_body = <'JoinAccept', joinnonce, devaddr>
    resp_mac = mac(appkey, resp_body)
  in
  [ St_Device_WaitAccept(device, server, appkey, devnonce),
    SentJoinAccept(device, server, appkey, devnonce, joinnonce)
  ]
  --[ Test3(),
      Running(device, server, <'server_join', device, server, devnonce>),
      Commit(device, server, <'device_session', device, server, devnonce, joinnonce, app_s_key, nwk_s_key>),
      Commit(device, server, <'session_keys', device, server, devnonce, joinnonce, app_s_key, nwk_s_key>),
      Secret(device, server, app_s_key),
      Secret(device, server, nwk_s_key),
      Honest(device),
      Honest(server)
    ]->
  [ St_Device_Keys(device, server, app_s_key, nwk_s_key) ]

rule Device_Publish_KeyDisclosure:
  [ St_Device_Keys(device, server, app_s_key, nwk_s_key) ]
  --[ Test4() ]->
  [ Out(<app_s_key, nwk_s_key>) ]

rule Reveal_AppKey:
  [ !AppKey(device, server, appkey) ]
  --[ LtkReveal(device), LtkReveal(server) ]->
  [ Out(appkey) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

// category: injective_agreement
lemma injective_agreement_device:
  "All a b t #i.
     Commit(a, b, t) @ i & (Ex device server devnonce joinnonce app_s_key nwk_s_key.
       t = <'device_session', device, server, devnonce, joinnonce, app_s_key, nwk_s_key>)
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_device:
  "All a b t #i.
     Commit(a, b, t) @ i & (Ex device server devnonce joinnonce app_s_key nwk_s_key.
       t = <'device_session', device, server, devnonce, joinnonce, app_s_key, nwk_s_key>)
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_server:
  "All a b t #i.
     Commit(a, b, t) @ i & (Ex device server devnonce.
       t = <'device_join', device, server, devnonce>)
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_server:
  "All a b t #i.
     Commit(a, b, t) @ i & (Ex device server devnonce.
       t = <'device_join', device, server, devnonce>)
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_session_keys:
  "All a b device server devnonce joinnonce app_s_key nwk_s_key #i.
     Commit(a, b, <'session_keys', device, server, devnonce, joinnonce, app_s_key, nwk_s_key>) @ i
   ==>
       ( (Ex #j. Running(b, a, <'session_keys', device, server, devnonce, joinnonce, app_s_key, nwk_s_key>) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, <'session_keys', device, server, devnonce, joinnonce, app_s_key, nwk_s_key>) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_session_keys:
  "All a b device server devnonce joinnonce app_s_key nwk_s_key #i.
     Commit(a, b, <'session_keys', device, server, devnonce, joinnonce, app_s_key, nwk_s_key>) @ i
   ==>
       (Ex #j. Running(b, a, <'session_keys', device, server, devnonce, joinnonce, app_s_key, nwk_s_key>) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: secrecy
lemma secrecy_session_keys:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end
