theory ISO979844_Mutual_CR begin

builtins: hashing

rule Provision:
  [ Fr(~k) ]
  --[ Create($A, ~k), Create($B, ~k) ]->
  [ !Ltk($A, $B, ~k), !Ltk($B, $A, ~k) ]

rule Reveal_Ltk:
  [ !Ltk(A, B, k) ]
  --[ LtkReveal(A), LtkReveal(B) ]->
  [ Out(k) ]

rule Responder_Challenge:
  [ Fr(~rb), Fr(~text1), !Ltk(B, A, k) ]
  --[ Test1(), Running(B, A, <'responder', ~rb>), Honest(B), Honest(A) ]->
  [ Out(<~rb, ~text1>), St_B_1(B, A, k, ~rb) ]

rule Initiator_TokenAB:
  let tagged1 = <'sid1_mut_cr', ra, rb, B, ~text2>
      mac1 = h(<'sid1_mut_cr', ra, rb, B, k>)
  in
  [ In(<rb, text1>), In(ra), !Ltk(A, B, k), Fr(~text2), Fr(~text3) ]
  --[ Test2(), Running(A, B, <'initiator', ra, rb>), Honest(A), Honest(B) ]->
  [ Out(<ra, ~text3, tagged1, mac1>), St_A_1(A, B, k, ra, rb) ]

rule Responder_TokenBA:
  let mac2 = h(<'sid2_mut_cr', rb, ra, k>)
  in
  [ In(<ra, text3, <'sid1_mut_cr', ra, rb, B, text2>, h(<'sid1_mut_cr', ra, rb, B, k>)>),
    St_B_1(B, A, k, rb), Fr(~text4), Fr(~text5), Fr(~nonceb2) ]
  --[ Test3(), Commit(B, A, <'responder', ra, rb>), Running(B, A, <'initiator', ra, rb>), Honest(B), Honest(A) ]->
  [ Out(<~text5, mac2, ~nonceb2>) ]

rule Initiator_Verify:
  [ In(<text5, h(<'sid2_mut_cr', rb, ra, k>), nonceb2>),
    St_A_1(A, B, k, ra, rb) ]
  --[ Test4(), Commit(A, B, <'initiator', ra, rb>), Honest(A), Honest(B) ]->
  [ ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

// category: noninjective_agreement
lemma noninjective_agreement_at_a:
  "All A B ra rb #i.
     Commit(A, B, <'initiator', ra, rb>) @ #i
   ==> 
       (Ex #j. Running(B, A, <'initiator', ra, rb>) @ #j)
     | (Ex X #r. LtkReveal(X) @ #r & Honest(X) @ #i)"

// category: noninjective_agreement
lemma noninjective_agreement_at_b:
  "All B A ra rb #i.
     Commit(B, A, <'responder', ra, rb>) @ #i
   ==> 
       (Ex #j. Running(A, B, <'initiator', ra, rb>) @ #j)
     | (Ex X #r. LtkReveal(X) @ #r & Honest(X) @ #i)"

// category: injective_agreement
lemma injective_agreement_at_a:
  "All A B ra rb #i.
     Commit(A, B, <'initiator', ra, rb>) @ #i
   ==> 
       ( (Ex #j. Running(B, A, <'initiator', ra, rb>) @ #j
             & #j < #i
             & not (Ex A2 B2 #i2. Commit(A2, B2, <'initiator', ra, rb>) @ #i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ #r & Honest(X) @ #i)"

// category: injective_agreement
lemma injective_agreement_at_b:
  "All B A ra rb #i.
     Commit(B, A, <'responder', ra, rb>) @ #i
   ==> 
       ( (Ex #j. Running(A, B, <'initiator', ra, rb>) @ #j
             & #j < #i
             & not (Ex B2 A2 #i2. Commit(B2, A2, <'responder', ra, rb>) @ #i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ #r & Honest(X) @ #i)"

end
