theory MutualChallengeResponse
begin

builtins: hashing

restriction Equality:
  "All x y #i. Eq(x,y) @ #i ==> x = y"

rule Provision:
  [ Fr(~k) ]
  --[ Create($A, $B), Honest($A), Honest($B), Secret($A, $B, ~k) ]->
  [ !Ltk($A, $B, ~k) ]

rule InitRandomSource:
  [ Fr(~ra) ]
  --[ ]->
  [ !ReusableRA($A, ~ra) ]

rule Reveal:
  [ !Ltk(A, B, k) ]
  --[ LtkReveal(A), LtkReveal(B) ]->
  [ Out(k) ]

rule Responder_Challenge:
  [ !Ltk(A, B, k), Fr(~rb), Fr(~text1) ]
  --[ Test1(), Running(B, A, <'B_challenge', A, B, ~rb>) ]->
  [ Out(<~rb, ~text1>), St_B_1(A, B, k, ~rb) ]

rule Initiator_TokenAB:
  [ !Ltk(A, B, k), !ReusableRA(A, ra), In(<rb, text1>), Fr(~text2), Fr(~text3) ]
  --[ Test2(), Running(A, B, <'A_token', A, B, ra, rb>) ]->
  [ Out(<'token_ab', ra, ~text3, <'sid1_mut_cr', ra, rb, B, ~text2>, h(<'sid1_mut_cr', ra, rb, B, k>)>),
    St_A_1(A, B, k, ra, rb) ]

rule Responder_TokenBA:
  [ St_B_1(A, B, k, rb),
    In(<'token_ab', ra, text3, <'sid1_mut_cr', ra, rb, B, text2>, request_mac>),
    Fr(~text4), Fr(~text5) ]
  --[ Test3(), Eq(request_mac, h(<'sid1_mut_cr', ra, rb, B, k>)), Honest(A), Honest(B), Commit(B, A, <'B_accept', A, B, ra, rb>), Running(B, A, <'B_accept', A, B, ra, rb>) ]->
  [ Out(<~text5, h(<'sid2_mut_cr', rb, ra, k>)>), St_B_Done(A, B, ra, rb) ]

rule Initiator_Finish:
  [ St_A_1(A, B, k, ra, rb), In(<text5, response_mac>) ]
  --[ Test4(), Eq(response_mac, h(<'sid2_mut_cr', rb, ra, k>)), Honest(A), Honest(B), Commit(A, B, <'A_accept', A, B, ra, rb>) ]->
  [ St_A_Done(A, B, ra, rb) ]

// category: secrecy
lemma long_term_key_secrecy:
  "All A B k #i.
     Secret(A, B, k) @ #i
   ==>
       not (Ex #j. K(k) @ #j)
     | (Ex X #r. LtkReveal(X) @ #r & Honest(X) @ #i)"

// category: noninjective_agreement
lemma noninjective_agreement_at_a:
  "All A B ra rb #i.
     Commit(A, B, <'A_accept', A, B, ra, rb>) @ #i
   ==>
       (Ex #j. Running(B, A, <'B_accept', A, B, ra, rb>) @ #j)
     | (Ex X #r. LtkReveal(X) @ #r & Honest(X) @ #i)"

// category: noninjective_agreement
lemma noninjective_agreement_at_b:
  "All A B ra rb #i.
     Commit(B, A, <'B_accept', A, B, ra, rb>) @ #i
   ==>
       (Ex #j. Running(A, B, <'A_token', A, B, ra, rb>) @ #j)
     | (Ex X #r. LtkReveal(X) @ #r & Honest(X) @ #i)"

// category: injective_agreement
lemma injective_agreement_at_a:
  "All A B ra rb #i.
     Commit(A, B, <'A_accept', A, B, ra, rb>) @ #i
   ==>
       ( (Ex #j. Running(B, A, <'B_accept', A, B, ra, rb>) @ #j
             & j < i
             & not (Ex A2 B2 #i2. Commit(A2, B2, <'A_accept', A, B, ra, rb>) @ #i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ #r & Honest(X) @ #i)"

// category: injective_agreement
lemma injective_agreement_at_b:
  "All A B ra rb #i.
     Commit(B, A, <'B_accept', A, B, ra, rb>) @ #i
   ==>
       ( (Ex #j. Running(A, B, <'A_token', A, B, ra, rb>) @ #j
             & j < i
             & not (Ex A2 B2 #i2. Commit(A2, B2, <'B_accept', A, B, ra, rb>) @ #i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ #r & Honest(X) @ #i)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

end
