theory ISO979844_Mutual_CR begin

builtins: hashing

functions: mac/2

rule Provision:
  [ Fr(~kAB) ]
--[ Create('A', 'B'), Create('B', 'A'), Honest('A'), Honest('B') ]->
  [ !Ltk('A', 'B', ~kAB), !Ltk('B', 'A', ~kAB), Out('A'), Out('B') ]

rule Reveal_A:
  [ !Ltk('A', 'B', kAB) ]
--[ LtkReveal('A') ]->
  [ Out(kAB) ]

rule Reveal_B:
  [ !Ltk('B', 'A', kAB) ]
--[ LtkReveal('B') ]->
  [ Out(kAB) ]

rule Random_Source_Fresh_RA:
  [ !Ltk('A', 'B', kAB), Fr(~RA) ]
--[ ]->
  [ RandomRA('A', 'B', kAB, ~RA), Reuse_RA_Available('A', 'B', kAB, ~RA) ]

rule Random_Source_Reuse_RA_Once:
  [ Reuse_RA_Available('A', 'B', kAB, RA) ]
--[ ]->
  [ RandomRA('A', 'B', kAB, RA) ]

rule Responder_Send_Challenge:
  [ !Ltk('B', 'A', kAB), Fr(~RB), Fr(~Text1) ]
--[ Test1() ]->
  [ St_B_1('A', 'B', kAB, ~RB), Out(<~RB, ~Text1>) ]

rule Initiator_Send_Token:
  let mac1 = mac(<'sid1_mut_cr', RA, RB, 'B', 'mac1_tag'>, kAB)
      tagged1 = <'sid1_mut_cr', RA, RB, 'B', ~Text2>
  in
  [ !Ltk('A', 'B', kAB), RandomRA('A', 'B', kAB, RA), In(<RB, Text1>), Fr(~Text2), Fr(~Text3) ]
--[ Test2(), Running('A', 'B', <RA, RB>) ]->
  [ St_A_2('A', 'B', kAB, RA, RB), Out(<RA, ~Text3, tagged1, mac1>) ]

rule Responder_Verify_And_Send_Token:
  let mac1 = mac(<'sid1_mut_cr', RA, RB, 'B', 'mac1_tag'>, kAB)
      mac2 = mac(<'sid2_mut_cr', RB, RA>, kAB)
  in
  [ St_B_1('A', 'B', kAB, RB), In(<RA, Text3, tagged1, mac1>), Fr(~Text4), Fr(~Text5) ]
--[ Test3(), Honest('A'), Honest('B'), Commit('B', 'A', <RA, RB>), Running('B', 'A', <RA, RB>) ]->
  [ Out(<~Text5, mac2>) ]

rule Initiator_Verify_Token:
  let mac2 = mac(<'sid2_mut_cr', RB, RA>, kAB)
  in
  [ St_A_2('A', 'B', kAB, RA, RB), In(<Text5, mac2>) ]
--[ Test4(), Honest('A'), Honest('B'), Commit('A', 'B', <RA, RB>) ]->
  [ ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

// category: injective_agreement
lemma injective_agreement_at_A:
  "All a b t #i.
     Commit(a, b, t) @ i & a = 'A'
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex #i2. Commit(a, b, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_at_B:
  "All a b t #i.
     Commit(a, b, t) @ i & a = 'B'
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex #i2. Commit(a, b, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_at_A:
  "All a b t #i.
     Commit(a, b, t) @ i & a = 'A'
   ==>
       (Ex #j. Running(b, a, t) @ j & j < i)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_at_B:
  "All a b t #i.
     Commit(a, b, t) @ i & a = 'B'
   ==>
       (Ex #j. Running(b, a, t) @ j & j < i)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end
