theory Iso979844MutualChallengeResponse
begin

builtins: hashing

rule Provision:
  [ Fr(~k) ]
  --[ ]->
  [ !Ltk($A, $B, ~k) ]

rule Reveal_Ltk:
  [ !Ltk(A, B, k) ]
  --[ LtkReveal(A), LtkReveal(B) ]->
  [ Out(k) ]

rule Responder_Send_Challenge:
  [ Fr(~rb), Fr(~text1), Fr(~sid), !Ltk(A, B, k) ]
  --[ Test1(), Create(B, ~sid) ]->
  [ Out(<~rb, ~text1>), St_B_1(A, B, k, ~rb, ~sid) ]

rule Initiator_Send_Token:
  let mac1 = h(<<'sid1_mut_cr', ~ra, rb, B>, k>) in
  [ Fr(~ra), Fr(~text2), Fr(~text3), Fr(~sid), !Ltk(A, B, k), In(<rb, text1>) ]
  --[ Test2(), Create(A, ~sid), Running(A, B, <'A', ~ra, rb>) ]->
  [ Out(<~ra, ~text3, <'sid1_mut_cr', ~ra, rb, B, ~text2>, mac1>),
    St_A_1(A, B, k, ~ra, rb, ~sid) ]

rule Responder_Send_Token:
  let mac1 = h(<<'sid1_mut_cr', ra, ~rb, B>, k>)
      mac2 = h(<<'sid2_mut_cr', ~rb, ra>, k>) in
  [ Fr(~text4), Fr(~text5), St_B_1(A, B, k, ~rb, sid),
    In(<ra, text3, <'sid1_mut_cr', ra, ~rb, B, text2>, mac1>) ]
  --[ Test3(), Running(B, A, <'B', ra, ~rb>), Commit(B, A, <'B', ra, ~rb>), Honest(A), Honest(B) ]->
  [ Out(<~text5, mac2>) ]

rule Initiator_Finish:
  let mac2 = h(<<'sid2_mut_cr', rb, ~ra>, k>) in
  [ St_A_1(A, B, k, ~ra, rb, sid), In(<text5, mac2>) ]
  --[ Test4(), Commit(A, B, <'A', ~ra, rb>), Honest(A), Honest(B) ]->
  [ ]

// category: noninjective_agreement
lemma noninjective_agreement_at_a:
  "All A B ra rb #i.
     Commit(A, B, <'A', ra, rb>) @ i
   ==>
       (Ex #j. Running(B, A, <'B', ra, rb>) @ j & j < i)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_at_b:
  "All B A ra rb #i.
     Commit(B, A, <'B', ra, rb>) @ i
   ==>
       (Ex #j. Running(A, B, <'A', ra, rb>) @ j & j < i)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_at_a:
  "All A B ra rb #i.
     Commit(A, B, <'A', ra, rb>) @ i
   ==>
       ( (Ex #j. Running(B, A, <'B', ra, rb>) @ j
             & j < i
             & not (Ex A2 B2 #i2. Commit(A2, B2, <'A', ra, rb>) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_at_b:
  "All B A ra rb #i.
     Commit(B, A, <'B', ra, rb>) @ i
   ==>
       ( (Ex #j. Running(A, B, <'A', ra, rb>) @ j
             & j < i
             & not (Ex B2 A2 #i2. Commit(B2, A2, <'B', ra, rb>) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

end
