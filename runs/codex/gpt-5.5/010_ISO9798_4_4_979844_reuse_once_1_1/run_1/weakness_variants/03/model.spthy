theory MutualChallengeResponse
begin

builtins: hashing

functions: mac/2

rule Provision:
  [ Fr(~k) ]
--[ Create('A', ~k), Create('B', ~k) ]->
  [ !SharedKey('A', 'B', ~k), !SharedKey('B', 'A', ~k) ]

rule RevealKey:
  [ !SharedKey(A, B, k) ]
--[ LtkReveal(A) ]->
  [ Out(k) ]

rule Responder_Challenge1:
  [ Fr(~rb), Fr(~text1), !SharedKey('B', 'A', k) ]
--[ Test1(), Create('B', ~rb) ]->
  [ St_B_1('A', 'B', k, ~rb), Out(<~rb, ~text1>) ]

rule Initiator_TokenAB:
  [ In(<rb, text1>), Fr(~text2), Fr(~text3), !SharedKey('A', 'B', k) ]
--[ Test2(), Create('A', 'duplicate_ra'), Running('A', 'B', <'resp', 'duplicate_ra', rb>) ]->
  [ St_A_1('A', 'B', k, 'duplicate_ra', rb), Out(<'duplicate_ra', ~text3>) ]

rule Responder_TokenBA:
  let mac2 = mac(<'sid2_mut_cr', rb, ra>, k)
  in
  [ St_B_1('A', 'B', k, rb), In(<ra, text3>), Fr(~text4), Fr(~text5) ]
--[ Test3(), Running('B', 'A', <'init', ra, rb>), Commit('B', 'A', <'resp', ra, rb>), Honest('B'), Honest('A') ]->
  [ Out(<~text5, mac2>) ]

rule Initiator_Verify_TokenBA:
  [ St_A_1('A', 'B', k, ra, rb), In(<text5, mac(<'sid2_mut_cr', rb, ra>, k)>) ]
--[ Test4(), Commit('A', 'B', <'init', ra, rb>), Honest('A'), Honest('B') ]->
  [ ]

// category: noninjective_agreement
lemma noninjective_agreement_at_a:
  "All a b t #i.
     Commit(a, b, t) @ i & a = 'A'
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_at_a:
  "All a b t #i.
     Commit(a, b, t) @ i & a = 'A'
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_at_b:
  "All a b t #i.
     Commit(a, b, t) @ i & a = 'B'
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_at_b:
  "All a b t #i.
     Commit(a, b, t) @ i & a = 'B'
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4.
      Test1() @ #t1
    & Test2() @ #t2
    & Test3() @ #t3
    & Test4() @ #t4
    & #t1 < #t2
    & #t2 < #t3
    & #t3 < #t4"

end
