theory Iso979844ReuseOnceWeakness04
begin

builtins: hashing

rule Setup:
  [ Fr(~k) ]
  -->
  [ !Ltk($A, $B, ~k) ]

rule Reveal_A:
  [ !Ltk($A, $B, k) ]
  --[ LtkReveal($A) ]->
  [ Out(k) ]

rule Reveal_B:
  [ !Ltk($A, $B, k) ]
  --[ LtkReveal($B) ]->
  [ Out(k) ]

rule Responder_Challenge:
  [ Fr(~rb), Fr(~text1), !Ltk($A, $B, k) ]
  --[ Test1(), Create($B, ~rb) ]->
  [ Out(<~rb, ~text1>), St_B_1($A, $B, k, ~rb) ]

rule Initiator_TokenAB:
  let mac1 = h(<'sid1_mut_cr', ~ra, rb, $B, k>)
      tagged1 = <'sid1_mut_cr', ~ra, rb, $B, ~text2>
  in
  [ Fr(~ra), Fr(~text2), Fr(~text3), In(<rb, text1>), !Ltk($A, $B, k) ]
  --[ Test2(), Create($A, ~ra), Running($A, $B, <'A', ~ra, rb>) ]->
  [ Out(<~ra, ~text3, tagged1, mac1>), St_A_1($A, $B, k, ~ra, rb) ]

rule Responder_TokenBA:
  let mac1 = h(<'sid1_mut_cr', ra, rb, $B, k>)
  in
  [ St_B_1($A, $B, k, rb), In(<ra, text3, tagged1, mac1>), Fr(~text4), Fr(~text5) ]
  --[ Test3(), Running($B, $A, <'B', ra, rb>), Commit($B, $A, <'A', ra, rb>), Honest($A), Honest($B) ]->
  [ Out(<~text5>) ]

rule Initiator_Accept:
  [ St_A_1($A, $B, k, ra, rb), In(<text5>) ]
  --[ Test4(), Commit($A, $B, <'B', ra, rb>), Honest($A), Honest($B) ]->
  [ ]

// category: noninjective_agreement
lemma noninjective_agreement_a:
  "All a b ra rb #i.
     Commit(a, b, <'B', ra, rb>) @ i
   ==>
       (Ex #j. Running(b, a, <'B', ra, rb>) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_b:
  "All a b ra rb #i.
     Commit(a, b, <'A', ra, rb>) @ i
   ==>
       (Ex #j. Running(b, a, <'A', ra, rb>) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_a:
  "All a b ra rb #i.
     Commit(a, b, <'B', ra, rb>) @ i
   ==>
       ( (Ex #j. Running(b, a, <'B', ra, rb>) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, <'B', ra, rb>) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_b:
  "All a b ra rb #i.
     Commit(a, b, <'A', ra, rb>) @ i
   ==>
       ( (Ex #j. Running(b, a, <'A', ra, rb>) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, <'A', ra, rb>) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

end
