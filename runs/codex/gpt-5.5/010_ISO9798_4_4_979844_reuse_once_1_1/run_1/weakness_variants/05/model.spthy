theory MutualChallengeResponse
begin

builtins: hashing

rule Provision:
  [ Fr(~k) ]
  --[ ]->
  [ !Ltk('IdA', 'IdB', ~k)
  , !Ltk('IdB', 'IdA', ~k)
  , Out('IdA')
  , Out('IdB')
  ]

rule Reveal_Initiator_Key:
  [ !Ltk('IdA', 'IdB', k) ]
  --[ LtkReveal('IdA') ]->
  [ Out(k) ]

rule Reveal_Responder_Key:
  [ !Ltk('IdB', 'IdA', k) ]
  --[ LtkReveal('IdB') ]->
  [ Out(k) ]

rule Fresh_RA_Source:
  [ Fr(~ra) ]
  --[ ]->
  [ RaSource(~ra) ]

rule Duplicate_RA_Source:
  [ Fr(~ra) ]
  --[ DuplicateSeed() ]->
  [ RaSource(~ra), RaSource(~ra) ]

restriction Only_One_Duplicate_RA:
  "All #i #j. DuplicateSeed() @ i & DuplicateSeed() @ j ==> #i = #j"

rule Responder_Send_Challenge:
  [ Fr(~rb), Fr(~text1), Fr(~tidB), !Ltk('IdB', 'IdA', k) ]
  --[ Test1(), Create('IdB', ~tidB) ]->
  [ Out(<~rb, ~text1>)
  , St_B_1('IdB', 'IdA', ~rb, k)
  ]

rule Initiator_Send_Token:
  [ In(<rb, text1>)
  , RaSource(ra)
  , Fr(~text2)
  , Fr(~text3)
  , Fr(~tidA)
  , !Ltk('IdA', 'IdB', k)
  ]
  --[ Test2()
    , Create('IdA', ~tidA)
    , Running('IdA', 'IdB', <'responder', ra, rb>)
    ]->
  [ Out(<ra, ~text3, <'sid1_mut_cr', ra, rb, 'IdB', ~text2>, h(<'sid1_mut_cr', rb, 'IdB', k>)>)
  , St_A_1('IdA', 'IdB', ra, rb, k)
  ]

rule Responder_Verify_And_Respond:
  [ St_B_1('IdB', 'IdA', rb, k)
  , In(<ra, text3, <'sid1_mut_cr', ra, rb, 'IdB', text2>, h(<'sid1_mut_cr', rb, 'IdB', k>)>)
  , Fr(~text4)
  , Fr(~text5)
  ]
  --[ Test3()
    , Running('IdB', 'IdA', <'initiator', ra, rb>)
    , Commit('IdB', 'IdA', <'responder', ra, rb>)
    , Honest('IdA')
    , Honest('IdB')
    ]->
  [ Out(<~text5, h(<'sid2_mut_cr', rb, ra, k>)>) ]

rule Initiator_Verify_Response:
  [ St_A_1('IdA', 'IdB', ra, rb, k)
  , In(<text5, h(<'sid2_mut_cr', rb, ra, k>)>)
  ]
  --[ Test4()
    , Commit('IdA', 'IdB', <'initiator', ra, rb>)
    , Honest('IdA')
    , Honest('IdB')
    ]->
  [ ]

// category: noninjective_agreement
lemma noninjective_agreement_at_a:
  "All a b t #i.
     Commit(a, b, t) @ i & a = 'IdA'
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_at_a:
  "All a b t #i.
     Commit(a, b, t) @ i & a = 'IdA'
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & a2 = 'IdA'
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: weak_agreement
lemma weak_agreement_at_b:
  "All a b t #i.
     Commit(a, b, t) @ i & a = 'IdB'
   ==>
       (Ex t2 #j. Running(b, a, t2) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_at_b:
  "All a b t #i.
     Commit(a, b, t) @ i & a = 'IdB'
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_at_b:
  "All a b t #i.
     Commit(a, b, t) @ i & a = 'IdB'
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & a2 = 'IdB'
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

end
