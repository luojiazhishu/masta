theory CR_XOR_IMK begin

builtins: hashing, xor

macros: IMK() = 'Init'

rule SetupKey:
  [ Fr(~k) ]
  -->
  [ !Ltk($I, $R, ~k) ]

rule LtkReveal:
  [ !Ltk($I, $R, k) ]
  --[ LtkReveal($I) ]->
  [ Out(k) ]

rule RuleStep1:
  [ Fr(~na), !Ltk($I, $R, k) ]
  --[ Test1(), Create($R, ~na) ]->
  [ Out(<~na, IMK()>), !StateI1($I, $R, ~na, k) ]

rule RuleStep2:
  let
    x1 = na XOR k
    x2 = x1 XOR ~nb
    tag = h(x2)
  in
  [ In(<na, 'Init'>), Fr(~nb), !Ltk($I, $R, k) ]
  --[ Test2(), Running($R, $I, <na, ~nb>), Honest($R) ]->
  [ Out(<tag, ~nb>) ]

rule RuleStep3:
  let
    x1 = na XOR k
    x2 = x1 XOR nb
    t_prime = h(x2)
  in
  [ In(<tag, nb>), !StateI1($I, $R, na, k), !Ltk($I, $R, k) ]
  --[ Test3(), Verified($I, $R, na, nb), Commit($I, $R, <na, nb>), Honest($I) ]->
  [ ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & #t1 < #t2 & #t2 < #t3"

// category: aliveness
lemma aliveness_of_responder:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex id #j. Create(b, id) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_verification_tag:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end