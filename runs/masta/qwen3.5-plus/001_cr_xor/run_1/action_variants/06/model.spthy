theory CR_XOR_DSep begin

builtins: hashing, xor

functions: k/0 [private]

rule Init_I:
  [ Fr(~id_i) ]
  --[ Create('I', ~id_i), Honest('I') ]->
  [ !State_I_Init('I', ~id_i) ]

rule Init_R:
  [ Fr(~id_r) ]
  --[ Create('R', ~id_r), Honest('R') ]->
  [ !State_R('R', ~id_r) ]

rule RuleStep1:
  [ !State_I_Init('I', ~id_i), Fr(~na) ]
  --[ Test1(), Honest('I') ]->
  [ Out(~na), !State_I_Nonce('I', ~id_i, ~na) ]

rule RuleStep2:
  [ !State_R('R', ~id_r), In(~na), Fr(~nb) ]
  --[ Test2(), Running('R', 'I', <~na, ~nb>), Honest('R') ]->
  [ Out(<h(~na ⊕ k ⊕ ~nb ⊕ 'Init'), ~nb>) ]

rule RuleStep3:
  [ !State_I_Nonce('I', ~id_i, ~na_check), In(<t, ~nb>) ]
  --[ Test3(), Commit('I', 'R', <~na_check, ~nb, t>) ]->
  [ Out('END') ]

rule LtkReveal:
  [ ]
  --[ LtkReveal('I'), LtkReveal('R') ]->
  [ Out(k) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & #t1 < #t2 & #t2 < #t3"

// category: aliveness
lemma aliveness_responder:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==> 
       (Ex id #j. Create(b, id) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_verification_tag:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end