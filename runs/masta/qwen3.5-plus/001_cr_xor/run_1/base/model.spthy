theory CR_XOR begin

builtins: hashing, xor

functions: Shk/3

// Pre-shared key setup rule
rule SetupKey:
  [ Fr(~k) ]
  --[ SetupKey($I, $R), Create($R, ~k) ]->
  [ !Shk($I, $R, ~k) ]

// RuleStep1: Initiator generates nonce na and sends it
rule RuleStep1:
  [ Fr(~na),
    !Shk($I, $R, ~k) ]
  --[ Test1(), Honest($I) ]->
  [ Out(~na),
    !StI1($I, $R, ~k, ~na) ]

// RuleStep2: Responder receives na, generates nb, computes tag, sends <tag, nb>
rule RuleStep2:
  [ In(na),
    Fr(~nb),
    !Shk($I, $R, ~k) ]
  --[ Test2(), Running($R, $I, <na, ~nb>), Honest($R) ]->
  [ Out(<h(na XOR ~k XOR ~nb), ~nb>) ]

// RuleStep3: Initiator receives <tag, nb>, verifies tag, completes
rule RuleStep3:
  let expected = h(~na XOR ~k XOR nb)
  in
  [ In(<expected, nb>),
    !StI1($I, $R, ~k, ~na) ]
  --[ Test3(), Commit($I, $R, <expected, nb>) ]->
  [ Out('<END>') ]

// LtkReveal rule for key compromise
rule ShkReveal:
  [ !Shk($I, $R, k) ]
  --[ LtkReveal($I) ]->
  [ Out(k) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & #t1 < #t2 & #t2 < #t3"

// category: aliveness
lemma aliveness_responder_aliveness:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex id #j. Create(b, id) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_non_injective_agreement_on_verification_tag:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end