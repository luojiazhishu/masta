theory CR_XOR_NoKVfy begin

builtins: hashing, xor

// Shared key setup - k is established out of band between I and R
rule SetupKey:
  [ Fr(~k) ]
  --[ Honest('I'), Honest('R'), Secret('I', 'R', ~k) ]->
  [ !SharedKey('I', 'R', ~k) ]

// Rule for revealing the long-term key (for threat model)
rule SharedKeyReveal:
  [ !SharedKey('I', 'R', ~k) ]
  --[ SharedKeyReveal('I'), SharedKeyReveal('R') ]->
  [ Out(~k) ]

// RuleStep1: Initiator generates nonce na and sends it
rule RuleStep1:
  [ Fr(~na),
    !SharedKey('I', 'R', ~k)
  ]
  --[ Test1(), Honest('I') ]->
  [ Out(~na),
    !StI1('I', 'R', ~k, ~na)
  ]

// RuleStep2: Responder receives na, generates nb, computes tag with k, sends response
rule RuleStep2:
  [ In(~na),
    Fr(~nb),
    !SharedKey('I', 'R', ~k)
  ]
  --[ Test2(), Honest('R'), Create('R', 'resp'), Running('R', 'I', 'session') ]->
  [ Out(<h(~na ⊕ ~k ⊕ ~nb), ~nb>) ]

// RuleStep3: Initiator receives response, verifies tag WITHOUT k (flawed by design), completes
rule RuleStep3:
  let
    expected_tag = h(~na ⊕ ~nb)
  in
  [ In(<expected_tag, ~nb>),
    !StI1('I', 'R', ~k, ~na)
  ]
  --[ Test3(), Honest('I'), Commit('I', 'R', 'session') ]->
  [ ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & #t1 < #t2 & #t2 < #t3"

// category: secrecy
lemma secrecy_shared_key_secrecy:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. SharedKeyReveal(X) @ r & Honest(X) @ i)"

// category: aliveness
lemma aliveness_responder_aliveness:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex id #j. Create(b, id) @ j)
     | (Ex X #r. SharedKeyReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_verification_tag_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. SharedKeyReveal(X) @ r & Honest(X) @ i)"

end