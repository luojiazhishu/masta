theory CR_XOR_DiscK begin

builtins: hashing, xor

rule RuleStep1:
  [ Fr(~k) ]
  --[ Test1(), SetupAnnounce(~k) ]->
  [ Out(~k), !SharedKey(~k) ]

rule LtkReveal:
  [ !SharedKey(k) ]
  --[ LtkReveal('shared') ]->
  [ Out(k) ]

rule RuleStep2:
  [ Fr(~na), Fr(~tidI) ]
  --[ Test2(), Create('I', ~tidI), Honest('I') ]->
  [ Out(~na), !InitState(~tidI, ~na) ]

rule RuleStep3:
  [ In(na), Fr(~nb), Fr(~tidR), !SharedKey(k) ]
  --[ Test3(), Create('R', ~tidR), Running('R', 'I', <na, ~nb, k>), Honest('R') ]->
  [ Out(<h(na XOR k XOR ~nb), ~nb>), !RespState(~tidR, na, ~nb, k) ]

rule RuleStep4:
  [ In(<h(na XOR k XOR nb), nb>), !InitState(tidI, na), !SharedKey(k) ]
  --[ Test4(), Commit('I', 'R', <na, nb, k>), Honest('I') ]->
  [ ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

// category: aliveness
lemma aliveness_aliveness_of_the_responder:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex id #j. Create(b, id) @ j)
   | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_noninjective_agreement_on_verification_tag:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
   | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end