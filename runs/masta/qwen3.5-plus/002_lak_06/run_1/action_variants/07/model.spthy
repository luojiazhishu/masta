theory LAK06 begin

builtins: hashing, xor

functions: aux/2 [private]

rule Setup:
  [ Fr(~k) ]
  --[ Honest($R), Honest($T) ]->
  [ !Ltk($R, $T, ~k) ]

rule RuleStep1:
  [ Fr(~r0) ]
  --[ Test1() ]->
  [ Out(~r0), !StR(~r0) ]

rule RuleStep2:
  [ In(~r0), Fr(~r1), !Ltk($R, $T, ~k) ]
  --[ Test2(), Secret($R, $T, ~k), Running($T, $R, <~r0,~r1>) ]->
  [ Out(<~r1, h(~r0 XOR ~r1 XOR ~k)>), !StT($R, $T, ~r0, ~r1, ~k) ]

rule RuleStep3:
  [ In(<r1, tag_mac>), !StR(~r0), !Ltk($R, $T, ~k) ]
  --[ Test3(), Running($R, $T, <~r0,r1>), Commit($R, $T, <~r0,r1>) ]->
  [ Out(h(tag_mac XOR ~k XOR ~r0)) ]

rule RuleStep4:
  [ In(reader_mac), !StT($R, $T, ~r0, ~r1, ~k), !Ltk($R, $T, ~k) ]
  --[ Test4(), Commit($T, $R, <~r0,~r1>) ]->
  [ ]

rule LtkReveal:
  [ !Ltk(A, B, ltk) ]
  --[ LtkReveal(A, B) ]->
  [ Out(ltk) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

// category: secrecy
lemma secrecy_long_term_key:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X Y #r. LtkReveal(X, Y) @ r)"

// category: noninjective_agreement
lemma noninjective_agreement_tag:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X Y #r. LtkReveal(X, Y) @ r & Honest(X) @ i & Honest(Y) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_reader:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X Y #r. LtkReveal(X, Y) @ r & Honest(X) @ i & Honest(Y) @ i)"

end