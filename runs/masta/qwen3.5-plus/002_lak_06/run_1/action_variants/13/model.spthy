theory LAK06 begin

builtins: hashing, xor

rule KeyProvisioning:
  [ Fr(~k) ]
  -->
  [ !SharedKey($Tag, ~k), !SharedKey($Reader, ~k) ]

rule RuleStep1:
  [ Fr(~r0) ]
  --[ Test1(), Honest($Reader) ]->
  [ Out(~r0), !ReaderState($Reader, ~r0) ]

rule RuleStep2:
  [ In(~r0), Fr(~r1), !SharedKey($Tag, k) ]
  --[ Test2(), Honest($Tag), Secret($Tag, $Reader, k), Running($Tag, $Reader, <~r0, ~r1>) ]->
  [ Out(<~r1, h(~r0 XOR ~r1 XOR k)>), !TagState($Tag, ~r0, ~r1, k) ]

rule RuleStep3:
  let tag_mac_computed = h(~r0 XOR ~r1 XOR k)
      reader_mac = h(tag_mac_computed XOR k XOR ~r0)
  in
  [ In(<~r1, tag_mac>), !ReaderState($Reader, ~r0), !SharedKey($Reader, k) ]
  --[ Test3(), Honest($Reader), Secret($Reader, $Tag, k), Running($Reader, $Tag, <~r0, ~r1>), Commit($Reader, $Tag, <~r0, ~r1>) ]->
  [ Out(<reader_mac, reader_mac>) ]

rule RuleStep4:
  let expected_reader_mac = h(h(~r0 XOR ~r1 XOR k) XOR k XOR ~r0)
  in
  [ In(<reader_mac_a, reader_mac_b>), !TagState($Tag, ~r0, ~r1, k) ]
  --[ Test4(), Honest($Tag), Commit($Tag, $Reader, <~r0, ~r1>) ]->
  [ ]

rule LtkReveal:
  [ !SharedKey(A, ltk) ]
  --[ LtkReveal(A) ]->
  [ Out(ltk) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

// category: secrecy
lemma secrecy_long_term_key_secrecy:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_tag_authenticates_reader:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_reader_authenticates_tag:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end