theory LAK06 begin

builtins: hashing, xor

rule SetupKey:
  [ Fr(~k) ]
  --[ Honest($R), Honest($T), Secret($R, $T, ~k) ]->
  [ !SharedKey($R, $T, ~k) ]

rule RuleStep1:
  [ Fr(~r0), !SharedKey($R, $T, ~k) ]
  --[ Test1(), Running($R, $T, <~r0>) ]->
  [ Out(~r0), ReaderWait($R, $T, ~r0, ~k) ]

rule RuleStep2:
  [ In(~r0), Fr(~r1), !SharedKey($R, $T, ~k) ]
  --[ Test2(), Running($T, $R, <~r0, ~r1>) ]->
  [ Out(<~r1, h(~r0 XOR ~r1 XOR ~k)>), TagWait($R, $T, ~r0, ~r1, ~k) ]

rule RuleStep3:
  [ In(<~r1, tag_mac>), ReaderWait($R, $T, ~r0, ~k) ]
  --[ Test3(), Commit($R, $T, <~r0, ~r1>) ]->
  [ Out(h(tag_mac XOR ~r0)), ReaderDone($R, $T, ~r0, ~r1, ~k) ]

rule RuleStep4:
  [ In(reader_mac), TagWait($R, $T, ~r0, ~r1, ~k) ]
  --[ Test4(), Commit($T, $R, <~r0, ~r1>) ]->
  [ ]

rule LtkReveal:
  [ !SharedKey($R, $T, ~k) ]
  --[ LtkReveal($R), LtkReveal($T) ]->
  [ Out(~k) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

// category: secrecy
lemma secrecy_long_term_key_secrecy:
  "All R T k #i.
     Secret(R, T, k) @ i
   ==>
       not (Ex #j. K(k) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_tag_noninjective_agreement:
  "All T R t #i.
     Commit(T, R, t) @ i
   ==>
       (Ex #j. Running(R, T, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_reader_noninjective_agreement:
  "All R T t #i.
     Commit(R, T, t) @ i
   ==>
       (Ex #j. Running(T, R, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end