theory LAK06 begin

builtins: hashing, xor

// Long-term symmetric key shared between Reader and Tag
rule SetupKey:
  [ Fr(~k) ]
  --[ Honest('Reader'), Honest('Tag'), Secret('Reader', 'Tag', ~k) ]->
  [ !Shk('Reader', 'Tag', ~k) ]

// RuleStep1: Reader generates r0 and sends R0
rule RuleStep1:
  [ Fr(~r0),
    !Shk('Reader', 'Tag', k)
  ]
  --[ Test1(), Running('Reader', 'Tag', <k, ~r0>) ]->
  [ Out(~r0),
    !StR1('Reader', 'Tag', k, ~r0)
  ]

// RuleStep2: Tag receives r0, generates r1, computes tag_mac, sends T1
rule RuleStep2:
  [ In(r0),
    Fr(~r1),
    !Shk('Reader', 'Tag', k)
  ]
  --[ Test2(), Running('Tag', 'Reader', <k, r0, ~r1>), Commit('Tag', 'Reader', <k, r0, ~r1>) ]->
  [ Out(<~r1, h(r0 ⊕ ~r1 ⊕ k)>) ]

// RuleStep3: Reader receives T1, verifies tag_mac, computes reader_mac, sends R1
rule RuleStep3:
  [ In(<r1, tag_mac>),
    !StR1('Reader', 'Tag', k, r0)
  ]
  --[ Test3(), Commit('Reader', 'Tag', <k, r0, r1>) ]->
  [ Out(<h(tag_mac ⊕ k ⊕ r0), k>) ]

// Reveal rule for long-term symmetric key
rule ShkReveal:
  [ !Shk(A, B, k) ]
  --[ LtkReveal(A) ]->
  [ Out(k) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & #t1 < #t2 & #t2 < #t3"

// category: secrecy
lemma secrecy_long_term_key:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_tag:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_reader:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end