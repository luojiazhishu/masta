theory sk_pmd begin

builtins: symmetric-encryption

functions: k/0 [private]

rule RuleStep1:
  [
    Fr(~sec),
    Fr(~pub),
    Fr(~I),
    Fr(~R)
  ]
  --[ Test1(), Secret(~I, ~R, ~sec) ]->
  [
    Out(<senc(<~sec, ~pub>, k), $tag>)
  ]

rule RuleStep2:
  [
    In(<senc(<~sec, ~pub>, k), $tag>)
  ]
  --[ Test2() ]->
  [
  ]

lemma executable:
  exists-trace
  "Ex #t1 #t2. Test1() @ #t1 & Test2() @ #t2 & #t1 < #t2"

// category: secrecy
lemma secrecy_secrecy_of_encapsulated_secret:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)"

end