theory SK_PMD begin

builtins: symmetric-encryption

/* Shared key k is modeled as a persistent fact established out-of-band */
/* Key is associated with agents I and R */

rule SetupKey:
  [
    Fr(~k)
  ]
  --[ ]->
  [
    !SharedKey('I', 'R', ~k)
  ]

rule RuleStep1:
  [
    Fr(~sec),
    Fr(~pub),
    !SharedKey('I', 'R', k)
  ]
  --[ Test1(), Secret(~sec), Honest('I'), Honest('R') ]->
  [
    Out(senc(<~sec, ~pub>, k))
  ]

rule RuleStep2:
  [
    In(senc(<sec, pub>, k)),
    !SharedKey('I', 'R', k)
  ]
  --[ Test2() ]->
  [
    Out(pub)
  ]

/* Long-term key reveal rule - single agent parameter to match canonical template */
rule SharedKeyReveal:
  [
    !SharedKey('I', 'R', k)
  ]
  --[ LtkReveal('I') ]->
  [
    Out(k)
  ]

lemma executable:
  exists-trace
  "Ex #t1 #t2. Test1() @ #t1 & Test2() @ #t2 & #t1 < #t2"

// category: secrecy
lemma secrecy_secrecy_of_encapsulated_secret_payload:
  "All x #i.
     Secret(x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex #r. LtkReveal('I') @ r & Honest('I') @ i)"

end