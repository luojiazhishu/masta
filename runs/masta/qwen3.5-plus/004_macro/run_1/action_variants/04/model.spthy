theory BSKTACK begin

builtins: asymmetric-encryption, hashing

rule Generate_key_pair:
  [ Fr(~skS) ]
  -->
  [ !Pk($S, pk(~skS))
  , !Ltk($S, ~skS)
  , Out(pk(~skS))
  ]

rule RuleStep1:
  [ Fr(~tid), Fr(~k), !Pk($S, pkS) ]
  --[ Test1(), Secret($C, $S, ~k), Honest($C) ]->
  [ Out(aenc(~k, pkS))
  , !ClientState(~tid, ~k, $S)
  ]

rule RuleStep2:
  [ In(ciphertext), !Ltk($S, skS) ]
  --[ Test2(), Running($S, $C, adec(ciphertext, skS)), Honest($S) ]->
  [ Out(<h(adec(ciphertext, skS)), 'ack'>)
  ]

rule RuleStep3:
  [ In(<h(k), 'ack'>), !ClientState(~tid, k, $S) ]
  --[ Test3(), Commit($C, $S, k) ]->
  [ ]

rule LtkReveal:
  [ !Ltk($S, skS) ]
  --[ LtkReveal($S) ]->
  [ Out(skS) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

// category: secrecy
lemma secrecy_session_key_secrecy:
  "All C S k #i.
     Secret(C, S, k) @ i
   ==>
       not (Ex #j. K(k) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_noninjective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_injective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end