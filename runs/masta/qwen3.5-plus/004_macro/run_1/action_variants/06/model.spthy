theory FAMED_BSKTDSH begin

builtins: hashing, asymmetric-encryption

// Long-term key setup for Server
rule SetupServer:
  [
    Fr(~ltkS)
  ]
  --[ ]->
  [
    !Ltk('S', ~ltkS),
    !Pk('S', pk(~ltkS))
  ]

// LtkReveal rule for server key compromise
rule LtkReveal:
  [
    !Ltk('S', ltk)
  ]
  --[ LtkReveal('S') ]->
  [
    Out(ltk)
  ]

// RuleStep1: Client generates session key, encrypts, and sends m1
rule RuleStep1:
  [
    Fr(~k)
  ]
  --[ Secret('C', 'S', ~k), Honest('S'), Test1() ]->
  [
    ClientWaiting(~k),
    Out(aenc(~k, pk($S)))
  ]

// RuleStep2: Server receives m1, decrypts, computes confirmation hash, sends m2
rule RuleStep2:
  [
    In(aenc(~k, pk($S)))
  ]
  --[ Running('S', 'C', ~k), Test2() ]->
  [
    Out(h(<~k, 'session'>))
  ]

// RuleStep3: Client receives m2 and verifies the confirmation hash
rule RuleStep3:
  [
    ClientWaiting(~k),
    In(h(<~k, 'session'>))
  ]
  --[ Commit('C', 'S', ~k), Test3() ]->
  [
    ClientDone(~k)
  ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & #t1 < #t2 & #t2 < #t3"

// category: secrecy
lemma secrecy_session_key:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_key:
  "All a b t #i.
    Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_key:
  "All a b t #i.
    Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end