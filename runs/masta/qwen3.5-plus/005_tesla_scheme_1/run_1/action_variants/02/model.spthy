theory TESLA_Scheme1 begin

builtins: signing, hashing

functions: f/1, MAC/2

// Key generation rule: produces persistent Ltk fact for sender S
rule Generate_key_S:
  [ Fr(~SK_S) ]
  --[ Honest('S') ]->
  [ !Ltk('S', ~SK_S),
    Out(pk(~SK_S)) ]

// LtkReveal rule for long-term key compromise
rule LtkReveal:
  [ !Ltk(A, ltk) ]
  --[ LtkReveal(A) ]->
  [ Out(ltk) ]

// RuleStep1: Receiver R sends setup request with fresh nonce n_R
rule RuleStep1:
  [ Fr(~n_R) ]
  --[ Honest('R'), Commit('R', 'S', ~n_R), Test1() ]->
  [ Out(<'R', 'S', ~n_R>) ]

// RuleStep2: Sender S receives setup request, generates k_1 and stag_S, sends setup response
rule RuleStep2:
  let
      commitment = f(~k_1)
      signature = sign(<commitment, ~n_R>, ~SK_S)
  in
  [ In(<'R', 'S', ~n_R>),
    Fr(~k_1),
    Fr(~stag_S),
    !Ltk('S', ~SK_S) ]
  --[ Honest('S'), Create('S', ~k_1), Running('S', 'R', <commitment, signature>), Test2() ]->
  [ Out(<'S', 'R', commitment, signature, ~stag_S>),
    !State_S('S', ~k_1) ]

// RuleStep3: Sender S sends first broadcast message with MAC(k_1, D_1)
rule RuleStep3:
  let
      D_1 = <~m_1, f(~k_2)>
      mac_1 = MAC(~k_1, D_1)
  in
  [ !State_S('S', ~k_1),
    Fr(~m_1),
    Fr(~k_2) ]
  --[ Secret('S', 'R', ~k_1), Test3() ]->
  [ Out(<D_1, mac_1>),
    !State_S('S', ~k_2) ]

// RuleStep4: Sender S sends second broadcast message with key disclosure
rule RuleStep4:
  let
      D_2 = <~m_2, f(~k_3), ~k_1>
      mac_2 = MAC(~k_2, D_2)
  in
  [ !State_S('S', ~k_2),
    Fr(~m_2),
    Fr(~k_3),
    !State_S('S', ~k_1) ]
  --[ Test4() ]->
  [ Out(<D_2, mac_2>),
    !State_S('S', ~k_3) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

// category: secrecy
lemma secrecy_mac_key_secrecy:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_broadcast_authenticity:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: aliveness
lemma aliveness_sender_aliveness:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex id #j. Create(b, id) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end