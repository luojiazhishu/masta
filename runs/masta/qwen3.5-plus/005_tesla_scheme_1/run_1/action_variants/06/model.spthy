theory TESLA_Scheme1 begin

builtins: signing, hashing

functions: f/1, MAC/2

rule GenerateKey:
  [ Fr(~sk_S) ]
  --[ Honest($S) ]->
  [ !Ltk($S, ~sk_S)
  , !Pk($S, pk(~sk_S))
  , Out(pk(~sk_S))
  ]

rule RuleStep1:
  [ Fr(~n_R) ]
  --[ Test1() ]->
  [ Out(<$R, $S, ~n_R>)
  , !StateR1($R, $S, ~n_R)
  ]

rule RuleStep2:
  [ In(<$R, $S, n_R>)
  , Fr(~k_1)
  , !Ltk($S, ~sk_S)
  ]
  --[ Test2()
    , Running($S, $R, <'commitment', n_R>)
    ]->
  [ Out(<$S, $R, f(~k_1), sign(<f(~k_1), n_R>, ~sk_S), 'commit_response'>)
  , !StateS1($S, $R, ~k_1)
  , !StateR2($R, $S, n_R)
  ]

rule RuleStep3:
  [ In(<$S, $R, commitment, signature, message_type>)
  , !Pk($S, pk_S)
  , !StateR2($R, $S, n_R)
  ]
  --[ Test3()
    , Commit($R, $S, <'commitment', n_R>)
    ]->
  [ ]

rule RuleStep4:
  [ !StateS1($S, $R, k_1)
  , Fr(~m_1)
  , Fr(~k_2)
  ]
  --[ Test4()
    , Secret($S, $R, k_1)
    , Running($S, $R, <~m_1, f(~k_2)>)
    ]->
  [ Out(<<~m_1, f(~k_2)>, MAC(k_1, <~m_1, f(~k_2)>)>)
  , !StateS2($S, $R, k_1, ~k_2)
  ]

rule RuleStep5:
  [ In(<D_1, mac_1>)
  , !StateR2($R, $S, n_R)
  ]
  --[ Test5()
    , Commit($R, $S, D_1)
    ]->
  [ ]

rule RuleStep6:
  [ !StateS2($S, $R, k_1, k_2)
  , Fr(~m_2)
  , Fr(~k_3)
  ]
  --[ Test6()
    , Secret($S, $R, k_2)
    , Running($S, $R, <~m_2, f(~k_3), k_1>)
    ]->
  [ Out(<<~m_2, f(~k_3), k_1>, MAC(k_2, <~m_2, f(~k_3), k_1>)>)
  , !StateS3($S, $R, k_1, k_2, ~k_3)
  ]

rule RuleStep7:
  [ In(<D_2, mac_2>)
  , !StateR2($R, $S, n_R)
  ]
  --[ Test7()
    , Commit($R, $S, D_2)
    ]->
  [ ]

rule RuleStep8:
  [ !StateS3($S, $R, k_1, k_2, k_3)
  ]
  --[ Test8() ]->
  [ ]

rule LtkReveal:
  [ !Ltk($S, ltk) ]
  --[ LtkReveal($S) ]->
  [ Out(ltk) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4 #t5 #t6 #t7 #t8.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & Test5() @ #t5 & Test6() @ #t6 & Test7() @ #t7 & Test8() @ #t8
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4 & #t4 < #t5 & #t5 < #t6 & #t6 < #t7 & #t7 < #t8"

// category: secrecy
lemma secrecy_mac_key_secrecy:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: weak_agreement
lemma weak_agreement_setup_response_authenticity:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex t2 #j. Running(b, a, t2) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_broadcast_authenticity:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end