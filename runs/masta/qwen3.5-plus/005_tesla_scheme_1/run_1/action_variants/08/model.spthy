theory TESLA_Scheme1 begin

builtins: signing, hashing

functions: f/1, MAC/2

rule RuleStep1:
  [ Fr(~n_R) ]
  --[ Test1(), Create('S', ~n_R) ]->
  [ Out(<$R, $S, ~n_R>) ]

rule RuleStep2:
  [ In(<$R, $S, n_R>), Fr(~k_1), Fr(~SK_S) ]
  --[ Test2(), Running('S', 'R', <f(~k_1), n_R>), Honest('S') ]->
  [ Out(<$S, $R, f(~k_1), sign(<f(~k_1), n_R>, ~SK_S)>),
    !StateS($S, ~k_1, ~SK_S) ]

rule RuleStep3:
  [ !StateS($S, k_1, sk_s), Fr(~m_1), Fr(~k_2) ]
  --[ Test3(), Secret('S', 'R', k_1) ]->
  [ Out(<<~m_1, f(~k_2)>, MAC(k_1, <~m_1, f(~k_2)>)>),
    !StateS($S, k_1, ~k_2) ]

rule RuleStep4:
  [ In(<<m_1, f_k2>, mac_1>) ]
  --[ Test4(), Commit('R', 'S', <f_k2, mac_1>) ]->
  [ !StateR($R, m_1, f_k2, mac_1) ]

rule RuleStep5:
  [ !StateS($S, k_1, k_2), Fr(~m_2), Fr(~k_3) ]
  --[ Test5(), Running('S', 'R', <~m_2, f(~k_3), k_1>), Honest('S'), Secret('S', 'R', k_2) ]->
  [ Out(<<<~m_2, f(~k_3)>, k_1>, MAC(k_2, <<~m_2, f(~k_3)>, k_1>), 'channel_tag'>) ]

rule RuleStep6:
  [ In(<<<m_2, f_k3>, k_1>, mac_2, channel_tag>),
    !StateR($R, m_1, f_k2, mac_1) ]
  --[ Test6(), Commit('R', 'S', <m_2, f_k3, k_1>) ]->
  [ Out('<END>') ]

rule LtkReveal:
  [ !StateS(S, k_1, ltk) ]
  --[ LtkReveal(S) ]->
  [ Out(ltk) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4 #t5 #t6. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & Test5() @ #t5 & Test6() @ #t6 & #t1 < #t2 & #t2 < #t3 & #t3 < #t4 & #t4 < #t5 & #t5 < #t6"

// category: noninjective_agreement
lemma noninjective_agreement_broadcast_message_authenticity:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_setup_phase_integrity:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: secrecy
lemma secrecy_key_disclosure_timing:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end