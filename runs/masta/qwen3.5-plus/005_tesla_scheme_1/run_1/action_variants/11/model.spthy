theory tesla_scheme1 begin

builtins: signing, hashing

functions: f/1, MAC/2

rule RuleStep1:
  [
    Fr(~n_R),
    Fr(~tid_R)
  ]
  --[ Test1(), Running($R, $S, <~n_R>) ]->
  [
    Out(<$R, $S, ~n_R>),
    !RecvState(~tid_R, $R, $S, ~n_R)
  ]

rule RuleStep2:
  [
    In(<$R, $S, n_R>),
    Fr(~k_1),
    Fr(~sk_S),
    Fr(~tid_S)
  ]
  --[ Test2(), Honest($S), Secret($S, $R, ~sk_S), Commit($S, $R, <f(~k_1), n_R, 'init'>) ]->
  [
    Out(<$S, $R, f(~k_1), sign(<f(~k_1), n_R, 'init'>, ~sk_S)>),
    !SenderState(~tid_S, $S, $R, ~k_1, ~sk_S),
    !Ltk($S, ~sk_S)
  ]

rule RuleStep3:
  [
    !SenderState(~tid_S, $S, $R, ~k_1, ~sk_S),
    Fr(~m_1),
    Fr(~k_2)
  ]
  --[ Test3(), Running($S, $R, <~m_1, f(~k_2)>) ]->
  [
    Out(<<~m_1, f(~k_2)>, MAC(~k_1, <~m_1, f(~k_2)>)>),
    !StreamState(~tid_S, $S, $R, ~k_1, ~k_2)
  ]

rule RuleStep4:
  [
    !StreamState(~tid_S, $S, $R, ~k_1, ~k_2),
    Fr(~m_2),
    Fr(~k_3)
  ]
  --[ Test4(), Commit($R, $S, <~m_2, f(~k_3), ~k_1>) ]->
  [
    Out(<<~m_2, f(~k_3), ~k_1>, MAC(~k_2, <~m_2, f(~k_3), ~k_1>)>)
  ]

rule LtkReveal:
  [ !Ltk(A, ltk) ]
  --[ LtkReveal(A) ]->
  [ Out(ltk) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

// category: secrecy
lemma secrecy_long_term_key_secrecy:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: weak_agreement
lemma weak_agreement_setup_binding:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex t2 #j. Running(b, a, t2) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_broadcast_message_authenticity:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end