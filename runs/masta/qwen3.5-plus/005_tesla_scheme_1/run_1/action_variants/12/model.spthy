theory TESLA_Scheme1 begin

builtins: hashing, signing

functions: f/1, mac/2

rule Setup_PKI:
  [ Fr(~ltk_S) ]
  --[ SetupPKI(), Honest($S) ]->
  [ !Ltk($S, ~ltk_S)
  , !Pk($S, pk(~ltk_S))
  , Out(pk(~ltk_S))
  ]

rule LtkReveal_S:
  [ !Ltk($S, ltk) ]
  --[ LtkReveal($S) ]->
  [ Out(ltk) ]

rule RuleStep1:
  [ Fr(~n_R) ]
  --[ Test1(), Create($R, ~n_R), Honest($R) ]->
  [ Out(<$R, $S, ~n_R>)
  , !State_R1($R, ~n_R)
  ]

rule RuleStep2:
  [ In(<$R, $S, n_R>)
  , Fr(~k_1)
  , !Ltk($S, ~ltk_S)
  ]
  --[ Test2(), Secret($S, $R, ~k_1), Running($S, $R, <f(~k_1), ~k_1>) ]->
  [ Out(<$S, $R, f(~k_1), sign(<f(~k_1), n_R>, ~ltk_S)>)
  , !State_S1($S, ~k_1)
  ]

rule RuleStep3:
  [ In(<$S, $R, f_k1, sig>)
  , !State_R1($R, n_R)
  , !Pk($S, pk_S)
  ]
  --[ Test3() ]->
  [ !VerifiedCommitment($R, f_k1)
  , !State_R2($R, f_k1)
  ]

rule RuleStep4:
  let f_k2 = f(~k_2)
      D_1 = <~m_1, f_k2>
      mac_1 = mac(k_1, <D_1, 'stream'>)
  in
  [ !State_S1($S, k_1)
  , Fr(~k_2)
  , Fr(~m_1)
  ]
  --[ Test4(), Secret($S, $R, mac_1) ]->
  [ Out(<D_1, mac_1>)
  , !State_S2($S, k_1, ~k_2)
  ]

rule RuleStep5:
  let m_1 = fst(D_1)
      f_k2 = snd(D_1)
  in
  [ In(<D_1, mac_1>)
  , !State_R2($R, f_k1)
  ]
  --[ Test5(), Commit($R, $S, <f_k1, D_1, mac_1>) ]->
  [ !CachedStream($R, D_1, mac_1)
  , !State_R3($R, f_k1)
  ]

rule RuleStep6:
  let f_k3 = f(~k_3)
      D_2 = <~m_2, f_k3, k_1>
      mac_2 = mac(k_2, <D_2, 'stream'>)
  in
  [ !State_S2($S, k_1, k_2)
  , Fr(~k_3)
  , Fr(~m_2)
  ]
  --[ Test6(), Secret($S, $R, mac_2) ]->
  [ Out(<D_2, mac_2>)
  , !State_S3($S, k_2, ~k_3)
  ]

rule RuleStep7:
  let m_2 = fst(D_2)
      f_k3 = fst(snd(D_2))
      disclosed_k = snd(snd(D_2))
  in
  [ In(<D_2, mac_2>)
  , !State_R3($R, f_k1)
  ]
  --[ Test7(), Commit($R, $S, <f_k1, D_2, mac_2, disclosed_k>) ]->
  [ !CachedStream($R, D_2, mac_2)
  , !State_R4($R, f_k1)
  ]

rule RuleStep8:
  [ !State_S3($S, k_2, k_3)
  ]
  --[ Test8() ]->
  [ Out('<END>')
  ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4 #t5 #t6 #t7 #t8. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & Test5() @ #t5 & Test6() @ #t6 & Test7() @ #t7 & Test8() @ #t8 & #t1 < #t2 & #t2 < #t3 & #t3 < #t4 & #t4 < #t5 & #t5 < #t6 & #t6 < #t7 & #t7 < #t8"

// category: noninjective_agreement
lemma noninjective_agreement_broadcast_authenticity:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: secrecy
lemma secrecy_mac_key_secrecy:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: secrecy
lemma secrecy_domain_separation:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_commitment_binding:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end