theory TESLA_Scheme1 begin

builtins: signing, hashing

rule Setup_PKI:
  [ Fr(~sk_S) ]
  --[ Honest('S'), Secret(~sk_S) ]->
  [ !Pk('S', pk(~sk_S))
  , Out(pk(~sk_S))
  , !Ltk('S', ~sk_S)
  ]

rule LtkReveal:
  [ !Ltk(A, ltk) ]
  --[ LtkReveal(A) ]->
  [ Out(ltk) ]

rule RuleStep1:
  [ Fr(~n_R) ]
  --[ Test1() ]->
  [ Out(<'R', 'S', ~n_R, 'R', 'S', ~n_R>) ]

rule RuleStep2:
  [ In(<'R', 'S', n_R, 'R', 'S', n_R>)
  , !Ltk('S', ~sk_S)
  , Fr(~k_1)
  ]
  --[ Test2() ]->
  [ Out(<'S', 'R', h(~k_1), sign(<h(~k_1), n_R>, ~sk_S)>)
  , !Key('S', ~k_1)
  ]

rule RuleStep3:
  [ In(<'S', 'R', commitment, signature>)
  , !Pk('S', pk_S)
  , Fr(~tid_R)
  ]
  --[ Test3() ]->
  [ !RecvSetup(~tid_R, 'R', 'S', commitment, signature) ]

rule RuleStep4:
  [ !Key('S', k_1)
  , Fr(~k_2)
  , Fr(~m_1)
  ]
  --[ Test4()
  , Running('S', 'R', <h(<~m_1, h(~k_2)>), h(<k_1, ~m_1, h(~k_2)>)>) ]->
  [ Out(<h(<~m_1, h(~k_2)>), h(<k_1, ~m_1, h(~k_2)>)>) ]

rule RuleStep5:
  [ In(<data_part, mac_part>)
  , Fr(~tid_R2)
  ]
  --[ Test5()
  , Commit('R', 'S', <data_part, mac_part>) ]->
  [ !RecvStream(~tid_R2, 'R', data_part, mac_part) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4 #t5. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & Test5() @ #t5 & #t1 < #t2 & #t2 < #t3 & #t3 < #t4 & #t4 < #t5"

end
