theory tesla_scheme1 begin

builtins: signing, hashing

functions: f/1, mac/2

rule RuleStep1:
  [ Fr(~n_R) ]
  --[ Test1() ]->
  [ Out(< 'R', 'S', ~n_R >), !StateR(~n_R) ]

rule RuleStep2:
  [ In(< 'R', 'S', n_R >), Fr(~k_1), Fr(~sk_s) ]
  --[ Test2(), Honest('S') ]->
  [ Out(< 'S', 'R', f(~k_1), sign(<f(~k_1), n_R>, ~sk_s) >), !K1(~k_1), !Pk('S', pk(~sk_s)) ]

rule RuleStep3:
  [ In(< 'S', 'R', f_k1, sig >), !StateR(n_R), !Pk('S', pk_s) ]
  --[ Test3(), CommitAuth('R', 'S', f_k1), Honest('S') ]->
  [ Commit(f_k1) ]

rule RuleStep4:
  [ !K1(k_1), Fr(~k_2), Fr(~m_1) ]
  --[ Test4(), Running('S', 'R', ~m_1) ]->
  [ Out(< <~m_1, f(~k_2)>, mac(k_1, <~m_1, f(~k_2)>) >), !K2(~k_2) ]

rule RuleStep5:
  [ In(<D_1, mac_1>) ]
  --[ Test5() ]->
  [ !D1(D_1), !Mac1(mac_1) ]

rule RuleStep6:
  [ !K1(k_1), !K2(k_2), Fr(~k_3), Fr(~m_2) ]
  --[ Test6(), Running('S', 'R', ~m_2) ]->
  [ Out(< <~m_2, f(~k_3), k_1>, mac(k_2, <~m_2, f(~k_3), k_1>) >) ]

rule RuleStep7:
  [ In(< <m_2, f_k3, k_1>, mac_2 >), !StateR(n_R), !D1(D_1), !Mac1(mac_1) ]
  --[ Test7() ]->
  [ End() ]

rule SkReveal:
  []
  --[ LtkReveal('S') ]->
  []

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4 #t5 #t6 #t7.
     Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & Test5() @ #t5 & Test6() @ #t6 & Test7() @ #t7
   & #t1 < #t2 & #t2 < #t3 & #t3 < #t4 & #t4 < #t5 & #t5 < #t6 & #t6 < #t7"

// category: noninjective_agreement
lemma noninjective_agreement_authenticity_of_broadcast_messages:
  "All R S m #i.
     CommitAuth(R, S, m) @ i
   ==>
       (Ex #j. Running(S, R, m) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end