theory tesla_scheme1 begin

builtins: signing, hashing

functions: f/1, MAC/2

rule SetupKeys:
  [
    Fr(~sk_S)
  ]
  --[ ]->
  [
    !Sk($S, ~sk_S),
    !Pk($S, pk(~sk_S))
  ]

rule SkReveal:
  [
    !Sk(A, sk)
  ]
  --[ LtkReveal(A) ]->
  [
    Out(sk)
  ]

rule RuleStep1:
  [
    Fr(~n_R)
  ]
  --[ Test1() ]->
  [
    Out(<$R, $S, ~n_R>)
  ]

rule RuleStep2:
  [
    In(<$R, $S, ~n_R>),
    Fr(~k_1),
    !Sk($S, ~sk_S)
  ]
  --[ Test2(), Secret($S, $R, ~k_1), Honest($S), Running($S, $R, f(~k_1)) ]->
  [
    Out(<$S, $R, f(~k_1), sign(<f(~k_1), ~n_R>, ~sk_S)>),
    !Commitment($R, f(~k_1)),
    !Key($S, 1, ~k_1)
  ]

rule RuleStep3:
  [
    In(<$S, $R, comm, sig>),
    !Commitment($R, comm)
  ]
  --[ Test3(), Commit($R, $S, comm) ]->
  [
    Out('<END>')
  ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & #t1 < #t2 & #t2 < #t3"

// category: secrecy
lemma secrecy_mac_key_secrecy:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_broadcast_integrity:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: weak_agreement
lemma weak_agreement_source_authenticity:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex t2 #j. Running(b, a, t2) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end