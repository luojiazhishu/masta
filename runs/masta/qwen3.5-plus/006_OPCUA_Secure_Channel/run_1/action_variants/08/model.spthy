theory OPCUA_SignSign begin

builtins: signing, hashing

rule Generate_Server_Keys:
  [ Fr(~server_ltk) ]
  --[ Honest($Server) ]->
  [ !Pk($Server, pk(~server_ltk))
  , !Ltk($Server, ~server_ltk)
  , Out(pk(~server_ltk))
  ]

rule Generate_Client_Keys:
  [ Fr(~client_ltk) ]
  --[ Honest($Client) ]->
  [ !Pk($Client, pk(~client_ltk))
  , !Ltk($Client, ~client_ltk)
  , Out(pk(~client_ltk))
  ]

rule ServerLtkReveal:
  [ !Ltk($Server, ltk) ]
  --[ LtkReveal($Server) ]->
  [ Out(ltk) ]

rule ClientLtkReveal:
  [ !Ltk($Client, ltk) ]
  --[ LtkReveal($Client) ]->
  [ Out(ltk) ]

rule RuleStep1:
  [ Fr(~tid1) ]
  --[ Test1() ]->
  [ Out(< 'GEReq' >)
  , !ClientState1(~tid1)
  ]

rule RuleStep2:
  [ In(< 'GEReq' >)
  , !Ltk($Server, ~server_ltk)
  , Fr(~tid2)
  ]
  --[ Test2() ]->
  [ Out(< 'GERes', pk(~server_ltk), 'Sign', 'OPCUA-SignSign', 'Anonymous' >)
  , !ServerState2(~tid2, ~server_ltk)
  ]

rule RuleStep3:
  let
      RequestBody = <'OSCReq', pk(~client_ltk), ~client_nonce>
      RequestBodyDigest = h(RequestBody)
      RequestSignature = sign(RequestBodyDigest, ~client_ltk)
  in
  [ In(< 'GERes', $ServerCert, 'Sign', $SecurityPolicy, $UserTokenPolicy >)
  , !Ltk($Client, ~client_ltk)
  , Fr(~client_nonce)
  , Fr(~tid3)
  ]
  --[ Test3()
    , Running($Client, $Server, ~client_nonce)
  ]->
  [ Out(< $ServerCert, RequestBody, RequestSignature, RequestBodyDigest >)
  , !ClientState3(~tid3, ~client_ltk, ~client_nonce, $ServerCert)
  ]

rule RuleStep4:
  let
      ResponseBody = <'OSCRes', ~server_nonce, 'SecurityToken123', '3600'>
      ResponseBodyDigest = h(ResponseBody)
      ResponseSignature = sign(ResponseBodyDigest, ~server_ltk)
  in
  [ In(< $ClientCert, <'OSCReq', ClientPubKey, ClientNonce>, RequestSignature, RequestBodyDigest >)
  , !Ltk($Server, ~server_ltk)
  , Fr(~server_nonce)
  , Fr(~tid4)
  ]
  --[ Test4()
    , Running($Server, $Client, ~server_nonce)
    , Commit($Server, $Client, ClientNonce)
  ]->
  [ Out(< pk(~server_ltk), ResponseBody, ResponseSignature, ResponseBodyDigest >)
  , !ServerState4(~tid4, ~server_ltk, ~server_nonce)
  ]

rule RuleStep5:
  let
      VerifyKeyTag = h($ServerCert)
      ChannelBinding = h(<~client_nonce, ~server_nonce>)
  in
  [ In(< $ServerCert, ResponseBody, ResponseSignature, ResponseBodyDigest >)
  , !ClientState3(~tid3, ~client_ltk, ~client_nonce, $ServerCert)
  , !ServerState4(~tid4, ~server_ltk, ~server_nonce)
  ]
  --[ Test5()
    , VerifyKeyTagComputed(~tid3, VerifyKeyTag)
    , ChannelBindingComputed(~tid3, ChannelBinding)
    , Secret($Client, $Server, ChannelBinding)
    , Commit($Client, $Server, ~server_nonce)
    ]->
  [ Out(< 'END' >)
  , !ClientState5(~tid3)
  ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4 #t5. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & Test5() @ #t5 & #t1 < #t2 & #t2 < #t3 & #t3 < #t4 & #t4 < #t5"

// category: secrecy
lemma secrecy_secrecy_channel_session_key:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_client_nonce:
  "All a b t #i.
    Commit(a, b, t) @ i
   ==> (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_server_nonce:
  "All a b t #i.
    Commit(a, b, t) @ i
   ==> (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end