theory SimplifiedNaxos begin

builtins: diffie-hellman

functions: h1/1, h2/1

rule Generate_DH_key_pair:
  [ Fr(~x) ]
  -->
  [ !Ltk($A, ~x)
  , !Pk($A, 'g'^~x)
  , Out('g'^~x)
  ]

rule LtkReveal:
  [ !Ltk(A, ltk) ]
  --[ LtkReveal(A) ]->
  [ Out(ltk) ]

rule RuleStep1:
  let
    exI = h1(<~eskI, ~lkI>)
    hkI = 'g'^exI
  in
  [
    Fr(~eskI),
    Fr(~tid),
    !Ltk($I, ~lkI)
  ]
  --[ Test1(), Honest($I), Create($I, ~tid) ]->
  [
    Out(hkI),
    !InitState(~tid, $I, ~lkI, ~eskI)
  ]

rule RuleStep2:
  let
    exR = h1(<~eskR, ~lkR>)
    hkR = 'g'^exR
    kR = h2(<pkI^~eskR, hkI^~lkR, $I, $R>)
  in
  [
    In(hkI),
    Fr(~eskR),
    Fr(~tidR),
    !Ltk($R, ~lkR),
    !Pk($I, pkI)
  ]
  --[ Test2(), SessionKey($R, kR), Secret($I, $R, kR), Honest($R), Running($R, $I, <kR, $I, $R>), Create($R, ~tidR) ]->
  [
    Out(hkR)
  ]

rule RuleStep3:
  let
    kI = h2(<hkR^~lkI, pkR^~eskI, $I, $R>)
  in
  [
    In(hkR),
    !InitState(~tid, $I, ~lkI, ~eskI),
    !Pk($R, pkR)
  ]
  --[ Test3(), SessionKey($I, kI), Secret($I, $R, kI), Honest($I), Commit($I, $R, <kI, $I, $R>) ]->
  [
    Out(kI)
  ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & #t1 < #t2 & #t2 < #t3"

// category: secrecy
lemma secrecy_session_key_secrecy:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: aliveness
lemma aliveness_initiator_aliveness:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex id #j. Create(b, id) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: aliveness
lemma aliveness_responder_aliveness:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex id #j. Create(b, id) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_session_key_and_participant_identities:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end