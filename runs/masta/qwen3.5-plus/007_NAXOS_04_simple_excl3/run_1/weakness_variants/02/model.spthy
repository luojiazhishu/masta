theory SimplifiedNaxos begin

builtins: diffie-hellman
functions: h1/1
functions: h2/1

rule GenerateKey:
  [ Fr(~x) ]
  -->
  [ !Ltk($A, ~x)
  , !Pk($A, 'g'^~x)
  , Out('g'^~x)
  ]

rule LtkReveal:
  [ !Ltk($A, ltk) ]
  --[ LtkReveal($A) ]->
  [ Out(ltk) ]

rule RuleStep1:
  let exI = h1(<~eskI, ~ltkI>)
      hkI = 'g'^exI
  in
  [ Fr(~eskI)
  , Fr(~tid)
  , !Ltk($I, ~ltkI)
  ]
  --[ Test1(), Create($I, ~tid), Honest($I), Running($I, 'any', hkI) ]->
  [ Out(hkI)
  , !StateI1(~tid, $I, exI, ~ltkI)
  ]

rule RuleStep2:
  let exR = h1(<~eskR, ~ltkR>)
      hkR = 'g'^exR
      kR = h2(<pkI^exR, X^~ltkR, 'I', 'R'>)
  in
  [ In(X)
  , Fr(~eskR)
  , Fr(~tidR)
  , !Ltk($R, ~ltkR)
  , !Pk($I, pkI)
  ]
  --[ Test2(), Create($R, ~tidR), Honest($R), Running($R, $I, hkR), Commit($R, $I, <X, hkR, kR>), Secret($R, $I, kR) ]->
  [ Out(<hkR, kR>)
  , !StateR1(~tidR, $R, $I, kR)
  ]

rule RuleStep3:
  let hkI = 'g'^exI
      kI = h2(<Y^~ltkI, pkR^exI, 'I', 'R'>)
  in
  [ In(<Y, kR>)
  , !StateI1(~tid, $I, exI, ~ltkI)
  , !Pk($R, pkR)
  ]
  --[ Test3(), Commit($I, $R, <hkI, Y, kI>) ]->
  [ Out('<END>')
  , !StateI2(~tid, $I, $R, kI)
  ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & #t1 < #t2 & #t2 < #t3"

// category: secrecy
lemma secrecy_session_key_secrecy:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: aliveness
lemma aliveness_initiator_aliveness:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex id #j. Create(b, id) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: aliveness
lemma aliveness_responder_aliveness:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex id #j. Create(b, id) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: weak_agreement
lemma weak_agreement_weak_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex t2 #j. Running(b, a, t2) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end