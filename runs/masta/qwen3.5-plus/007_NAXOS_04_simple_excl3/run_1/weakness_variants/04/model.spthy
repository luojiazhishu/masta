theory SimplifiedNAXOS begin

builtins: diffie-hellman

functions: h1/1
functions: h2/1

// PKI: long-term DH key pairs
rule Generate_DH_key_pair:
  [ Fr(~x) ]
  -->
  [ !Pk($A, 'g'^~x)
  , Out('g'^~x)
  , !Ltk($A, ~x)
  ]

// RuleStep1: Initiator sends first message
rule RuleStep1:
  let
      exI = h1(<~eskI, ~lkI>)
      hkI = 'g'^exI
  in
  [ Fr(~eskI)
  , Fr(~tid)
  , !Ltk($I, ~lkI)
  ]
  --[ Test1(), Create($I, ~tid), Honest($I) ]->
  [ Out(hkI)
  , !InitState(~tid, $I, ~lkI, exI)
  ]

// RuleStep2: Responder receives hkI, sends hkR, computes session key
rule RuleStep2:
  let
      exR = h1(<~eskR, ~lkR>)
      hkR = 'g'^exR
      kR = h2(<$I, $R>)
  in
  [ In(hkI)
  , Fr(~eskR)
  , Fr(~tidR)
  , !Ltk($R, ~lkR)
  ]
  --[ Test2(), SessionKey($R, kR), Running($R, $I, <'I','R'>), Honest($R), Commit($R, $I, <'I','R'>), Secret($R, $I, kR), Create($R, ~tidR) ]->
  [ Out(hkR)
  , !RespState(~tidR, $R, $I, kR)
  ]

// RuleStep3: Initiator receives hkR, computes session key
rule RuleStep3:
  let
      kI = h2(<$I, $R>)
  in
  [ In(hkR)
  , !InitState(~tid, $I, ~lkI, exI)
  ]
  --[ Test3(), SessionKey($I, kI), Commit($I, $R, <'I','R'>), Honest($I), Secret($I, $R, kI) ]->
  [ ]

// Long-term key reveal rule for compromised participants
rule LtkReveal:
  [ !Ltk(A, ltk) ]
  --[ LtkReveal(A) ]->
  [ Out(ltk) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & #t1 < #t2 & #t2 < #t3"

// category: aliveness
lemma aliveness_initiator_liveness:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex id #j. Create(b, id) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: aliveness
lemma aliveness_responder_liveness:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex id #j. Create(b, id) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: weak_agreement
lemma weak_agreement_identity_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex t2 #j. Running(b, a, t2) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: secrecy
lemma secrecy_session_key_computation:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end