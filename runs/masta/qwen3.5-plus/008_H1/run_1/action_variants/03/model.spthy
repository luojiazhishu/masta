theory FAMED_H1_IT begin

builtins: signing

// PKI: each agent has a long-term signing key
rule Generate_key_pair:
  [ Fr(~ltk) ]
  --[ Honest($A), Create($A, pk(~ltk)) ]->
  [ !Ltk($A, ~ltk)
  , !Pk($A, pk(~ltk))
  , Out(pk(~ltk))
  ]

// RuleStep1: Initiator computes mI = sign(<I, R>, ltkI) and sends <mI, tagInit>
rule RuleStep1:
  [ !Ltk($I, ~ltkI)
  , !Pk($R, pkR)
  ]
  --[ Test1(), Running($I, $R, <$I, $R>) ]->
  [ Out(<sign(<$I, $R>, ~ltkI), 'tagInit'>)
  ]

// RuleStep2: Responder receives <s, t>, asserts t = 'tagInit', computes mR = sign(<I, R>, ltkR), sends <mR>
rule RuleStep2:
  [ In(<s, 'tagInit'>)
  , !Ltk($R, ~ltkR)
  , !Pk($I, pkI)
  ]
  --[ Test2(), Running($R, $I, <$I, $R>), Commit($R, $I, <$I, $R>) ]->
  [ Out(sign(<$I, $R>, ~ltkR))
  ]

// RuleStep3: Initiator receives <mR>, verifies, and terminates
rule RuleStep3:
  [ In(sigR)
  , !Ltk($I, ~ltkI)
  , !Pk($R, pkR)
  ]
  --[ Test3(), Commit($I, $R, <$I, $R>) ]->
  [ ]

// LtkReveal rule for long-term key compromise
rule LtkReveal:
  [ !Ltk($A, ltk) ]
  --[ LtkReveal($A) ]->
  [ Out(ltk) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & #t1 < #t2 & #t2 < #t3"

// category: aliveness
lemma aliveness:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex id #j. Create(b, id) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: weak_agreement
lemma weak_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex t2 #j. Running(b, a, t2) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end