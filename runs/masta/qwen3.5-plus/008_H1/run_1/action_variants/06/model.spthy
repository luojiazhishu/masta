theory FAMED_RAM begin

builtins: signing
functions: com/2

rule Generate_key_pair:
  [ Fr(~ltk) ]
  -->
  [ !Ltk($A, ~ltk)
  , !Pk($A, pk(~ltk))
  , Out(pk(~ltk))
  ]

rule RuleStep1:
  let mI = sign(<$I, $R>, ~ltkI)
  in
  [ Fr(~tid)
  , !Ltk($I, ~ltkI)
  ]
  --[ Test1(), Create('I', ~tid), Honest('I') ]->
  [ Out(mI)
  , !InitState1(~tid, $I, $R, ~ltkI)
  ]

rule RuleStep2:
  let mR = sign(<$I, $R>, ~ltkR)
      audit_marker = com($R, $I)
  in
  [ In(mI)
  , Fr(~tidR)
  , !Ltk($R, ~ltkR)
  ]
  --[ Test2(), AuditMarker($R, $I, audit_marker), Running('R', 'I', <'I', 'R'>), Honest('R') ]->
  [ Out(mR)
  , !RespState1(~tidR, $I, $R, ~ltkR)
  ]

rule RuleStep3:
  [ In(mR)
  , !InitState1(~tid, $I, $R, ~ltkI)
  ]
  --[ Test3(), Commit('I', 'R', <'I', 'R'>) ]->
  [ ]

rule IReveal:
  [ !Ltk('I', ltk) ]
  --[ LtkReveal('I') ]->
  [ Out(ltk) ]

rule RReveal:
  [ !Ltk('R', ltk) ]
  --[ LtkReveal('R') ]->
  [ Out(ltk) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

// category: weak_agreement
lemma weak_agreement_weak_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex t2 #j. Running(b, a, t2) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_noninjective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_injective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end