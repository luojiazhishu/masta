theory FAMED_H1_IR begin

builtins: signing

rule Generate_key_pair:
  [ Fr(~ltkI), Fr(~ltkR) ]
  -->
  [ !Ltk('I', ~ltkI), !Pk('I', pk(~ltkI))
  , !Ltk('R', ~ltkR), !Pk('R', pk(~ltkR))
  , Out(pk(~ltkI)), Out(pk(~ltkR))
  ]

rule LtkReveal_I:
  [ !Ltk('I', ltk) ]
  --[ LtkReveal('I') ]->
  [ Out(ltk) ]

rule LtkReveal_R:
  [ !Ltk('R', ltk) ]
  --[ LtkReveal('R') ]->
  [ Out(ltk) ]

rule RuleStep1:
  [ !Ltk('I', ~ltkI)
  , Fr(~tid)
  ]
  --[ Test1(), Create('I', ~tid) ]->
  [ Out(sign(<'I', 'R'>, ~ltkI))
  , !InitState(~tid, 'I', 'R', ~ltkI)
  ]

rule RuleStep2:
  [ !InitState(~tid, 'I', 'R', ~ltkI)
  ]
  --[ Test2() ]->
  [ Out(sign(<'I', 'R'>, ~ltkI))
  , !InitState2(~tid, 'I', 'R', ~ltkI)
  ]

rule RuleStep3:
  [ !Ltk('R', ~ltkR)
  , In(sigI)
  , Fr(~tidR)
  ]
  --[ Test3(), Running('R', 'I', <'I','R'>), Honest('R') ]->
  [ Out(sign(<'I', 'R'>, ~ltkR))
  , !RespState(~tidR, 'I', 'R', ~ltkR)
  ]

rule RuleStep4:
  [ !InitState2(~tid, 'I', 'R', ~ltkI)
  , In(sigR)
  ]
  --[ Test4(), Commit('I', 'R', <'I','R'>), Honest('I') ]->
  [ ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

// category: weak_agreement
lemma weak_agreement_weak_agreement:
  "All a b t #i.
    Commit(a, b, t) @ i
  ==>
      (Ex t2 #j. Running(b, a, t2) @ j)
    | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_noninjective_agreement:
  "All a b t #i.
    Commit(a, b, t) @ i
  ==>
      (Ex #j. Running(b, a, t) @ j)
    | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_injective_agreement:
  "All a b t #i.
    Commit(a, b, t) @ i
  ==>
      ( (Ex #j. Running(b, a, t) @ j
            & j < i
            & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                               & not (#i2 = #i))) )
    | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end