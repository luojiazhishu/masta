theory FAMED begin

builtins: signing

// PKI: Each agent has a long-term signing key pair
rule Generate_key_pair:
  [ Fr(~ltk) ]
  --[ Honest($A) ]->
  [ !Ltk($A, ~ltk)
  , !Pk($A, pk(~ltk))
  , Out(pk(~ltk))
  ]

// RuleStep1: Initiator constructs and sends mI = sign(<I, R>, ltkI)
rule RuleStep1:
  let
    mI = sign(<$I, $R>, ~ltkI)
  in
  [ Fr(~tid)
  , !Ltk($I, ~ltkI)
  ]
  --[ Test1()
    , Running($I, $R, <$I, $R>)
  ]->
  [ Out(mI)
  , !InitState(~tid, $I, $R, ~ltkI)
  ]

// RuleStep2: Responder receives mI, computes mR = sign(<I, R>, ltkR), sends mR
rule RuleStep2:
  let
    mR = sign(<$I, $R>, ~ltkR)
  in
  [ In(mI)
  , !Ltk($R, ~ltkR)
  ]
  --[ Test2()
    , Running($R, $I, <$I, $R>)
  ]->
  [ Out(mR)
  , !RespState($I, $R, ~ltkR, mR)
  ]

// RuleStep3: Responder sends second copy of mR (duplicate emission)
rule RuleStep3:
  let
    mR = sign(<$I, $R>, ~ltkR)
  in
  [ !RespState($I, $R, ~ltkR, mR)
  ]
  --[ Test3() ]->
  [ Out(mR)
  ]

// RuleStep4: Initiator receives mR and terminates
rule RuleStep4:
  [ In(mR)
  , !InitState(~tid, $I, $R, ~ltkI)
  ]
  --[ Test4()
    , Commit($I, $R, <$I, $R>)
  ]->
  [ Out('<END>')
  ]

// LtkReveal rules for long-term key compromise
rule LtkReveal:
  [ !Ltk(A, ltk) ]
  --[ LtkReveal(A) ]->
  [ Out(ltk) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

// category: weak_agreement
lemma weak_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex t2 #j. Running(b, a, t2) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end