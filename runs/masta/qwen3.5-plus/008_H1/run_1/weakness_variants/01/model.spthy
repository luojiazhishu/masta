theory FAMED_UR begin

builtins: signing

/* Key generation for each agent */
rule GenerateKeys:
  [ Fr(~ltk) ]
  --[ Honest($A) ]->
  [ !Ltk($A, ~ltk)
  , Out(pk(~ltk))
  ]

/* RuleStep1: Initiator sends signed identity pair */
rule RuleStep1:
  [ !Ltk($I, ~ltkI)
  , Fr(~tid)
  ]
  --[ Test1() ]->
  [ Out(sign(<$I, $R>, ~ltkI))
  ]

/* RuleStep2: Responder receives, verifies, and sends signed reply */
rule RuleStep2:
  [ In(mI)
  , !Ltk($R, ~ltkR)
  ]
  --[ Test2(), Running($R, $I, <$I, $R>) ]->
  [ Out(sign(<$I, $R>, ~ltkR))
  ]

/* RuleStep3: Initiator receives reply without verification */
rule RuleStep3:
  [ In(mR)
  ]
  --[ Test3(), Commit($I, $R, <$I, $R>) ]->
  [ ]

/* Long-term key reveal rules */
rule InitiatorReveal:
  [ !Ltk($I, ltk) ]
  --[ LtkReveal($I) ]->
  [ Out(ltk) ]

rule ResponderReveal:
  [ !Ltk($R, ltk) ]
  --[ LtkReveal($R) ]->
  [ Out(ltk) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & #t1 < #t2 & #t2 < #t3"

// category: weak_agreement
lemma weak_agreement_weak_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex t2 #j. Running(b, a, t2) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_noninjective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_injective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end