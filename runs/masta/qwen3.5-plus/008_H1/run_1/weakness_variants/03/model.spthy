theory FAMED_CR begin

builtins: signing

rule Generate_key_pair_I:
  [ Fr(~ltkI) ]
  -->
  [ !Ltk($I, ~ltkI)
  , !Pk($I, pk(~ltkI))
  , Out(pk(~ltkI))
  , Create($I, ~ltkI)
  ]

rule Generate_key_pair_R:
  [ Fr(~ltkR) ]
  -->
  [ !Ltk($R, ~ltkR)
  , !Pk($R, pk(~ltkR))
  , Out(pk(~ltkR))
  , Create($R, ~ltkR)
  ]

rule RuleStep1:
  let
    mI = sign(<$I, $R>, ~ltkI)
  in
  [ !Ltk($I, ~ltkI)
  , Fr(~tid)
  ]
  --[ Test1(), Commit($I, $R, <$I, $R>), Honest($I) ]->
  [ Out(mI) ]

rule RuleStep2:
  let
    mR = sign('msg', ~ltkR)
  in
  [ In(mI)
  , !Ltk($R, ~ltkR)
  , !Pk($I, pkI)
  ]
  --[ Test2(), Running($R, $I, <$I, $R>), Honest($R) ]->
  [ Out(mR) ]

rule RuleStep3:
  [ In(mR)
  , !Pk($R, pkR)
  ]
  --[ Test3() ]->
  [ ]

rule LtkReveal_I:
  [ !Ltk($I, ltk) ]
  --[ LtkReveal($I) ]->
  [ Out(ltk) ]

rule LtkReveal_R:
  [ !Ltk($R, ltk) ]
  --[ LtkReveal($R) ]->
  [ Out(ltk) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & #t1 < #t2 & #t2 < #t3"

// category: weak_agreement
lemma weak_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex t2 #j. Running(b, a, t2) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end