theory LoRaWAN10Join begin

builtins: symmetric-encryption

functions: mac/2, cst1/0, cst2/0

// Provisioning: Device and Server share AppKey; Device has DevEUI, JoinEUI, DevAddr
rule ProvisionDevice:
  [ Fr(~AppKey), Fr(~DevEUI), Fr(~JoinEUI), Fr(~DevAddr) ]
  --[ Honest($D), Honest($S) ]->
  [ !Ltk($D, ~AppKey)
  , !Ltk($S, ~AppKey)
  , !DevEUI($D, ~DevEUI)
  , !JoinEUI($D, ~JoinEUI)
  , !DevAddr($D, ~DevAddr)
  ]

// RuleStep1: Device sends first JoinRequest
// Device Running emitted here with DevNonce only (JoinNonce not yet known)
rule RuleStep1:
  let
      reqMAC = mac(~AppKey, <'JoinRequest', ~DevEUI, ~JoinEUI, ~DevNonce>)
      msg = <'JoinRequest', ~DevEUI, ~JoinEUI, ~DevNonce, reqMAC>
  in
  [ Fr(~DevNonce)
  , !Ltk($D, ~AppKey)
  , !DevEUI($D, ~DevEUI)
  , !JoinEUI($D, ~JoinEUI)
  ]
  --[ Test1()
    , Running($D, $S, <~DevNonce>)
    ]->
  [ Out(msg)
  , !State1($D, ~DevNonce, ~AppKey, ~DevEUI, ~JoinEUI)
  ]

// RuleStep2: Device sends duplicate JoinRequest (same DevNonce, same reqMAC)
// Replay rule - no Running fact emitted (replays should not create new protocol instances)
// NOTE: This rule models the replay vulnerability - Server has no DevNonce tracking
rule RuleStep2:
  let
      reqMAC = mac(~AppKey, <'JoinRequest', ~DevEUI, ~JoinEUI, ~DevNonce>)
      msg = <'JoinRequest', ~DevEUI, ~JoinEUI, ~DevNonce, reqMAC>
  in
  [ !State1($D, ~DevNonce, ~AppKey, ~DevEUI, ~JoinEUI)
  ]
  --[ Test2()
    , ReplayAttack()
    ]->
  [ Out(msg)
  , !State2($D, ~DevNonce, ~AppKey, ~DevEUI, ~JoinEUI)
  ]

// RuleStep3: Server receives JoinRequest, verifies MAC, sends JoinAccept
// Server commits to <devNonce, JoinNonce> but Device has only Running(<devNonce>) at this point
// This is a protocol design issue - Server commits before Device can match the full term
// VULNERABILITY: Server does not check if devNonce was already used (no replay protection)
rule RuleStep3:
  let
      reqMAC = mac(~AppKey, <'JoinRequest', devEUI, joinEUI, devNonce>)
      respMAC = mac(~AppKey, <'JoinAccept', ~JoinNonce, ~DevAddr>)
      joinAcceptBody = <'JoinAccept', ~JoinNonce, ~DevAddr, respMAC>
      encJoinAccept = senc(joinAcceptBody, ~AppKey)
  in
  [ In(< 'JoinRequest', devEUI, joinEUI, devNonce, reqMAC >)
  , !Ltk($S, ~AppKey)
  , Fr(~JoinNonce)
  , Fr(~DevAddr)
  ]
  --[ Test3()
    , Running($S, devEUI, <devNonce, ~JoinNonce>)
    , Commit($S, devEUI, <devNonce, ~JoinNonce>)
    ]->
  [ Out(encJoinAccept)
  , !StateS($S, devNonce, ~JoinNonce, ~AppKey, ~DevAddr)
  ]

// RuleStep4: Device receives JoinAccept, decrypts, verifies MAC, derives session keys
// Device now knows JoinNonce and can emit Running with full term
rule RuleStep4:
  let
      joinAcceptBody = sdec(encMsg, ~AppKey)
      joinNonce = fst(snd(joinAcceptBody))
      devAddr = fst(snd(snd(joinAcceptBody)))
      respMAC = snd(snd(snd(joinAcceptBody)))
      expectedRespMAC = mac(~AppKey, <'JoinAccept', joinNonce, devAddr>)
      appSKey = senc(<cst1, ~DevNonce, joinNonce>, ~AppKey)
      nwkSKey = senc(<cst2, ~DevNonce, joinNonce>, ~AppKey)
  in
  [ In(encMsg)
  , !State2($D, ~DevNonce, ~AppKey, ~DevEUI, ~JoinEUI)
  ]
  --[ Test4()
    , SessionKeys($D, appSKey, nwkSKey)
    , Running($D, $S, <~DevNonce, joinNonce>)
    , Commit($D, $S, <~DevNonce, joinNonce>)
    , Secret(appSKey)
    , Secret(nwkSKey)
    ]->
  [ !State4($D, ~DevNonce, joinNonce, ~AppKey, appSKey, nwkSKey)
  ]

// AppKey reveal rule for long-term key compromise
rule AppKeyReveal:
  [ !Ltk(X, ltk) ]
  --[ AppKeyReveal(X) ]->
  [ Out(ltk) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

// DOCUMENTED PROTOCOL WEAKNESS: Replay attack on JoinRequest
// The LoRaWAN 1.0 Join procedure as modeled lacks server-side DevNonce tracking.
// An attacker can replay a captured JoinRequest, causing the Server to:
// 1. Commit to stale nonces without fresh Device Running
// 2. Derive session keys that may be predictable if DevNonce is known
// 3. Break agreement properties between Device and Server
//
// The following lemmas are EXPECTED TO FAIL due to this design weakness.
// These falsifications document genuine protocol vulnerabilities, not modeling errors.

// category: injective_agreement
// EXPECTED VERDICT: FALSIFIED (protocol weakness)
// Server Commit(<devNonce,JoinNonce>) in RuleStep3 has no matching Device Running
// Device Running(<~DevNonce>) in RuleStep1 lacks JoinNonce; Running(<~DevNonce,joinNonce>) in RuleStep4 comes after Server Commit
lemma injective_agreement_at_device:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. AppKeyReveal(X) @ r)"

// category: noninjective_agreement
// EXPECTED VERDICT: FALSIFIED (protocol weakness - replay attack)
// Server commits to <devNonce,JoinNonce> but Device only has Running(<devNonce>) when Server commits
// ReplayAttack() action fact marks traces where this weakness is exploited
lemma noninjective_agreement_at_device:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. AppKeyReveal(X) @ r)
     | (Ex #k. ReplayAttack() @ k)"

// category: injective_agreement
// EXPECTED VERDICT: FALSIFIED (protocol weakness - replay attack)
// Device Commit(<~DevNonce,joinNonce>) in RuleStep4 needs Server Running(<devNonce,~JoinNonce>)
// Server Running in RuleStep3 uses <devNonce,~JoinNonce> which matches structurally
// However, replay attack via RuleStep2 allows Server to commit on replayed message without fresh Device Running
lemma injective_agreement_at_server:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. AppKeyReveal(X) @ r)
     | (Ex #k. ReplayAttack() @ k)"

// category: noninjective_agreement
// EXPECTED VERDICT: FALSIFIED (protocol weakness - replay attack)
// Replay attack via RuleStep2 allows Server Commit without matching fresh Device Running
// Attacker can replay JoinRequest, causing Server to commit on stale/non-fresh Device state
lemma noninjective_agreement_at_server:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. AppKeyReveal(X) @ r)
     | (Ex #k. ReplayAttack() @ k)"

// category: injective_agreement
// EXPECTED VERDICT: FALSIFIED (protocol weakness)
// Session key agreement inherits the same Commit/Running term mismatch issues
// Server commits to key-derivation terms before Device can validate them
lemma injective_agreement_session_keys:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. AppKeyReveal(X) @ r)
     | (Ex #k. ReplayAttack() @ k)"

// category: noninjective_agreement
// EXPECTED VERDICT: FALSIFIED (protocol weakness - replay attack)
// Session key agreement broken by replay attack - Server may derive keys on replayed JoinRequest
// without corresponding fresh Device Running, leading to key synchronization issues
lemma noninjective_agreement_session_keys:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. AppKeyReveal(X) @ r)
     | (Ex #k. ReplayAttack() @ k)"

// category: secrecy
// EXPECTED VERDICT: FALSIFIED (protocol weakness - replay enables key exposure)
// Session keys derived from DevNonce + JoinNonce; both are fresh per session
// However, replay attack allows attacker to cause key derivation on stale state
// When DevNonce is known (from captured JoinRequest) and AppKey is compromised,
// attacker can compute session keys from replayed exchange
lemma secrecy_session_keys:
  "All x #i.
     Secret(x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. AppKeyReveal(X) @ r)
     | (Ex #k. ReplayAttack() @ k)"

end
