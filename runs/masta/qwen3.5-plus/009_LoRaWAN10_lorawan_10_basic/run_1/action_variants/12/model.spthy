theory LoRaWAN_Join begin

builtins: symmetric-encryption

functions: mac/2

/* Setup: Provisioning - creates persistent facts for device credentials */
rule Setup:
  [
    Fr(~AppKey),
    Fr(~DevEUI),
    Fr(~JoinEUI),
    Fr(~DevAddr)
  ]
  --[ Honest('Device'), Honest('Server') ]->
  [
    !AppKey('Device', ~AppKey),
    !DevEUI('Device', ~DevEUI),
    !JoinEUI('Device', ~JoinEUI),
    !DevAddr('Device', ~DevAddr)
  ]

/* RuleStep1: Device sends JoinRequest */
rule RuleStep1:
  let
    RequestMAC = mac(~AppKey, <~DevEUI, ~JoinEUI, ~DevNonce>)
  in
  [
    Fr(~DevNonce),
    Fr(~tid),
    !AppKey('Device', ~AppKey),
    !DevEUI('Device', ~DevEUI),
    !JoinEUI('Device', ~JoinEUI)
  ]
  --[ Test1(), Running('Device', 'Server', <~DevNonce, ~DevEUI, ~JoinEUI>) ]->
  [
    !State_Device_1(~tid, ~AppKey, ~DevNonce, ~DevEUI, ~JoinEUI),
    Out(< 'JoinRequest', ~DevEUI, ~JoinEUI, ~DevNonce, RequestMAC >)
  ]

/* RuleStep2: Server receives JoinRequest, verifies RequestMAC, sends two JoinAccept ciphertexts */
rule RuleStep2:
  let
    RequestMAC = mac(~AppKey, <~DevEUI, ~JoinEUI, ~DevNonce>)
    ResponseMAC = mac(~AppKey, <~JoinNonce, ~DevAddr>)
    JoinAcceptBody = <'JoinAccept', ~JoinNonce, ~DevAddr, ResponseMAC>
    ciphertext = senc(JoinAcceptBody, ~AppKey)
  in
  [
    In(< 'JoinRequest', ~DevEUI, ~JoinEUI, ~DevNonce, RequestMAC >),
    Fr(~JoinNonce),
    Fr(~sid),
    !AppKey('Device', ~AppKey),
    !DevEUI('Device', ~DevEUI),
    !JoinEUI('Device', ~JoinEUI),
    !DevAddr('Device', ~DevAddr)
  ]
  --[ Test2(), Running('Server', 'Device', <~DevNonce, ~JoinNonce, ~DevAddr>), Commit('Server', 'Device', <~DevNonce, ~JoinNonce, ~DevAddr>) ]->
  [
    !State_Server_1(~sid, ~AppKey, ~JoinNonce, ~DevAddr, ResponseMAC),
    Out(ciphertext),
    Out(ciphertext)
  ]

/* RuleStep3: Device receives ciphertext, decrypts, validates ResponseMAC, derives session keys */
rule RuleStep3:
  let
    JoinAcceptBody = sdec(ciphertext, ~AppKey)
    JoinNonce = snd(snd(fst(JoinAcceptBody)))
    DevAddr_from_msg = snd(snd(JoinAcceptBody))
    ResponseMAC_from_msg = snd(JoinAcceptBody)
    ExpectedMAC = mac(~AppKey, <JoinNonce, DevAddr_from_msg>)
    AppSKey = senc(<'cst1', ~DevNonce, JoinNonce>, ~AppKey)
    NwkSKey = senc(<'cst2', ~DevNonce, JoinNonce>, ~AppKey)
  in
  [
    In(ciphertext),
    !State_Device_1(~tid, ~AppKey, ~DevNonce, ~DevEUI, ~JoinEUI),
    !AppKey('Device', ~AppKey)
  ]
  --[ Test3(), SessionKeys(~tid, AppSKey, NwkSKey), Running('Device', 'Server', <~DevNonce, JoinNonce, DevAddr_from_msg>), Commit('Device', 'Server', <~DevNonce, JoinNonce, DevAddr_from_msg>), Secret(AppSKey), Secret(NwkSKey) ]->
  [
    !State_Device_Done(~tid, AppSKey, NwkSKey),
    Out('<END>')
  ]

/* LtkReveal rule for AppKey compromise */
rule AppKeyReveal:
  [ !AppKey('Device', ltk) ]
  --[ LtkReveal('Device') ]->
  [ Out(ltk) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & #t1 < #t2 & #t2 < #t3"

// category: injective_agreement
lemma injective_agreement_device:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_device:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_server:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_server:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_session_keys:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_session_keys:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: secrecy
lemma secrecy_session_keys:
  "All x #i.
     Secret(x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end