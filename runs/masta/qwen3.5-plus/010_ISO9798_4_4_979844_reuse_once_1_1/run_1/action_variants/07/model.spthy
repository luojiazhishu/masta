theory FAMED_ISO979844 begin

builtins: hashing

functions: mac/2, aux1/1

// Long-term key setup
rule SetupKeys:
  [ Fr(~kAB) ]
  -->
  [ !Ltk('IdA', 'IdB', ~kAB)
  , !Ltk('IdB', 'IdA', ~kAB)
  ]

// Key reveal rule for long-term key compromise
rule LtkReveal:
  [ !Ltk(A, B, k) ]
  --[ LtkReveal(A) ]->
  [ Out(k) ]

// RuleStep1: Responder sends Challenge1 = <RB, Text1>
rule RuleStep1:
  [ Fr(~RB), Fr(~Text1)
  , !Ltk('IdB', 'IdA', ~kAB)
  ]
  --[ Test1(), AuxLog('IdB', aux1(~Text1)), Running('IdB', 'IdA', <~RB, ~Text1>), Honest('IdB') ]->
  [ Out(<~RB, ~Text1>)
  , !StateR1('IdB', ~RB, ~kAB)
  ]

// RuleStep2: Initiator receives Challenge1, sends TokenAB with mac1
rule RuleStep2:
  [ In(<rb, text1>)
  , Fr(~RA), Fr(~Text2), Fr(~Text3)
  , !Ltk('IdA', 'IdB', ~kAB)
  ]
  --[ Test2(), Running('IdA', 'IdB', <~RA, rb, text1>), Honest('IdA') ]->
  [ Out(<~RA, ~Text3, <'sid1_mut_cr', ~RA, rb, 'IdB', ~Text2>, mac(<'sid1_mut_cr', ~RA, rb, 'IdB', ~Text2>, ~kAB)>)
  , !StateI1('IdA', ~RA, rb, ~kAB)
  ]

// RuleStep3: Responder receives TokenAB, verifies mac1, sends TokenBA with mac2
rule RuleStep3:
  [ In(<ra, text3, <'sid1_mut_cr', ra, rb, 'IdB', text2>, received_mac1>)
  , !StateR1('IdB', rb, kAB)
  , Fr(~Text5)
  ]
  --[ Test3(), VerifyMac1('IdB'), Commit('IdB', 'IdA', <ra, rb>), Honest('IdB') ]->
  [ Out(<~Text5, mac(<'sid2_mut_cr', rb, ra>, kAB)>)
  , !StateR2('IdB', rb, ra, kAB)
  ]

// RuleStep4: Initiator receives TokenBA, verifies mac2, completes
rule RuleStep4:
  [ In(<text5, mac(<'sid2_mut_cr', rb, ra>, kAB)>)
  , !StateI1('IdA', ra, rb, kAB)
  ]
  --[ Test4(), VerifyMac2('IdA'), Commit('IdA', 'IdB', <ra, rb>), Honest('IdA') ]->
  [ !AuthComplete('IdA', ra, rb)
  ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

// category: injective_agreement
lemma injective_agreement_at_a:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_at_b:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_at_a:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_at_b:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end