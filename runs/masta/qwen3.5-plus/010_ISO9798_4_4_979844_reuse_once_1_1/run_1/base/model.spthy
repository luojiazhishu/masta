theory FAMED_ISO979844 begin

builtins: hashing

functions: mac/2

/* Provisioning: long-term symmetric key kAB shared between IdA and IdB */
rule SetupKey:
  [ Fr(~kAB) ]
  --[ Secret('IdA', 'IdB', ~kAB), Honest('IdA'), Honest('IdB'), Test0() ]->
  [ !SharedKey('IdA', 'IdB', ~kAB)
  , !SharedKey('IdB', 'IdA', ~kAB)
  ]

/* RuleStep1: Responder B sends Challenge1 = <RB, Text1> */
rule RuleStep1:
  [ Fr(~RB)
  , Fr(~Text1)
  , !SharedKey('IdB', 'IdA', kAB)
  ]
  --[ Running('IdB', 'IdA', <~RB>), Honest('IdB'), Test1() ]->
  [ Out(<~RB, ~Text1>)
  , !RespState('IdB', ~RB)
  ]

/* RuleStep2: Initiator A receives Challenge1, sends TokenAB */
rule RuleStep2:
  [ In(<RB, Text1>)
  , Fr(~RA)
  , Fr(~Text2)
  , Fr(~Text3)
  , !SharedKey('IdA', 'IdB', kAB)
  ]
  --[ Running('IdA', 'IdB', <~RA, RB>), Honest('IdA'), Test2() ]->
  [ Out(<~RA, ~Text3, <'sid1_mut_cr', ~RA, RB, 'IdB', ~Text2>, mac(< 'sid1_mut_cr', ~RA, RB, 'IdB'>, kAB)>)
  , !InitState('IdA', ~RA, RB)
  ]

/* RuleStep3: Responder B receives TokenAB, verifies mac1, sends TokenBA */
rule RuleStep3:
  [ In(<RA, Text3, <'sid1_mut_cr', RA, RB, 'IdB', Text2>, mac1>)
  , !SharedKey('IdB', 'IdA', kAB)
  , !RespState('IdB', RB)
  , Fr(~Text5)
  ]
  --[ Running('IdB', 'IdA', <RA, RB>), Commit('IdB', 'IdA', <RA, RB>), Honest('IdB'), Test3() ]->
  [ Out(<~Text5, mac(< 'sid2_mut_cr', RB, RA>, kAB)>)
  ]

/* RuleStep4: Initiator A receives TokenBA, verifies mac2, completes authentication */
rule RuleStep4:
  [ In(<Text5, mac2>)
  , !SharedKey('IdA', 'IdB', kAB)
  , !InitState('IdA', RA, RB)
  ]
  --[ Commit('IdA', 'IdB', <RA, RB>), Honest('IdA'), Test4() ]->
  [ ]

/* Long-term key reveal rule */
rule LtkReveal:
  [ !SharedKey(A, B, kAB) ]
  --[ LtkReveal(A) ]->
  [ Out(kAB) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

// category: secrecy
lemma secrecy_key:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_initiator:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_responder:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_responder:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_initiator:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end