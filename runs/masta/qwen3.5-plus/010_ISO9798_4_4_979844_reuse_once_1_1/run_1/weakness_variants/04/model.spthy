theory FAMED_ISO979844 begin

functions: mac/2

rule Setup:
  [ Fr(~kAB) ]
  --[ Honest($IdA), Honest($IdB), Secret($IdA, $IdB, ~kAB) ]->
  [ !SharedKey($IdA, $IdB, ~kAB) ]

rule LtkReveal:
  [ !SharedKey($IdA, $IdB, ~kAB) ]
  --[ LtkReveal($IdA) ]->
  [ Out(~kAB) ]

rule RuleStep1:
  [ Fr(~RB), Fr(~Text1), !SharedKey($IdA, $IdB, ~kAB) ]
  --[ Test1(), Honest($IdB) ]->
  [ Out(<~RB, ~Text1>), StateR1($IdA, $IdB, ~kAB, ~RB) ]

rule RuleStep2:
  let
      Tagged1 = <'sid1_mut_cr', ~RA, ~RB, $IdB, ~Text2>
      mac1 = mac(Tagged1, ~kAB)
  in
  [ In(<~RB, ~Text1>), Fr(~RA), Fr(~Text2), Fr(~Text3), !SharedKey($IdA, $IdB, ~kAB) ]
  --[ Test2(), Running($IdA, $IdB, <~RA, ~RB>), Honest($IdA) ]->
  [ Out(<~RA, ~Text3, Tagged1, mac1>), StateI1($IdA, $IdB, ~kAB, ~RA, ~RB) ]

rule RuleStep3:
  let
      expected_mac = mac(< 'sid1_mut_cr', ra, rb, $IdB, text2>, ~kAB)
  in
  [ In(<ra, text3, <'sid1_mut_cr', ra, rb, $IdB, text2>, expected_mac>), Fr(~Text5), StateR1($IdA, $IdB, ~kAB, rb) ]
  --[ Test3(), Commit($IdB, $IdA, <ra, rb>), Honest($IdB) ]->
  [ Out(<~Text5>), StateR2($IdA, $IdB, ~kAB, ra, rb) ]

rule RuleStep4:
  [ In(<~Text5>), StateI1($IdA, $IdB, ~kAB, ~RA, ~RB) ]
  --[ Test4(), Commit($IdA, $IdB, <~RA, ~RB>), Honest($IdA) ]->
  [ Out('<END>'), SessionComplete($IdA, $IdB, ~RA, ~RB) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

// category: injective_agreement
lemma injective_agreement_injective_agreement_at_b:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_noninjective_agreement_at_b:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_injective_agreement_at_a:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_noninjective_agreement_at_a:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: secrecy
lemma secrecy_secrecy_of_long_term_key:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end