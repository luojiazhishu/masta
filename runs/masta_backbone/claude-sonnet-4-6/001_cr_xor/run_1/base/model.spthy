theory CRXOR
begin

builtins: hashing, xor

rule SetupSharedKey:
  [ Fr(~k) ]
  --[  ]->  
  [ !SharedKey($I, $R, ~k), !SharedKey($R, $I, ~k) ]

rule RuleStep1:
  [ Fr(~na), !SharedKey($I, $R, ~k) ]
  --[ Test1(), Create($I, 'init'), Honest($I) ]->  
  [ Out(~na), St_Init_1($I, $R, ~na, ~k) ]

rule RuleStep2:
  [ In(na), Fr(~nb), !SharedKey($R, $I, ~k) ]
  --[ Test2(), Create($R, 'resp'), Running($R, $I, <'R', 'I', h((na XOR ~k) XOR ~nb)>), Honest($R) ]->  
  [ Out(<h((na XOR ~k) XOR ~nb), ~nb>) ]

rule RuleStep3:
  [ In(<tag, nb>), St_Init_1($I, $R, ~na, ~k) ]
  --[ Test3(), Eq(tag, h((~na XOR ~k) XOR nb)), Commit($I, $R, <'I', 'R', tag>), Honest($I) ]->  
  [ ]

restriction Equality:
  "All x y #i. Eq(x, y) @ #i ==> x = y"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & #t1 < #t2 & #t2 < #t3"

// category: aliveness
lemma aliveness_aliveness_of_responder:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex id #j. Create(b, id) @ j)"

// category: noninjective_agreement
lemma noninjective_agreement_non_injective_agreement_on_verification_tag:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)"

end