theory CRXORNoVfy
begin

builtins: hashing, xor

rule Generate_Shared_Key:
  [ Fr(~sk) ]
  --[  ]->  
  [ !Ltk($I, $R, ~sk), !Ltk($R, $I, ~sk) ]

rule RuleStep1:
  [ Fr(~na), !Ltk($I, $R, ~sk) ]
  --[ Test1(), Create($I, ~na), Honest($I) ]->  
  [ Out(~na), St_I_1($I, $R, ~na, ~sk) ]

rule RuleStep2:
  [ In(na), Fr(~nb), !Ltk($R, $I, ~sk) ]
  --[ Test2(), Create($R, ~nb), Running($R, $I, <'I','R', h(na XOR ~sk XOR ~nb)>), Honest($R) ]->  
  [ Out(<h(na XOR ~sk XOR ~nb), ~nb>), St_R_1($R, $I, na, ~nb, ~sk) ]

rule RuleStep3:
  [ In(<tag, nb>), St_I_1($I, $R, ~na, ~sk) ]
  --[ Test3(), Commit($I, $R, <'I','R', tag>), Honest($R) ]->  
  [ ]

rule LtkReveal:
  [ !Ltk($A, $B, ~sk) ]
  --[ LtkReveal($A) ]->  
  [ Out(~sk) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

// category: aliveness
lemma aliveness_aliveness_of_the_responder:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex id #j. Create(b, id) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_non_injective_agreement_on_the_verification_tag:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end