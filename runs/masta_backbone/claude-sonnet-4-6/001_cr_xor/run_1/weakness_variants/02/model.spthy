theory CR_XOR_NoKVfy
begin

builtins: hashing, xor

rule RuleStep1:
  [ Fr(~na) ]
  --[ Test1(), Create('I', ~na) ]->  
  [ Out(~na),
    St_Init_1(~na) ]

rule RuleStep2:
  [ In(na),
    Fr(~nb),
    Fr(~k) ]
  --[ Test2(), Create('R', ~k), Running('R', 'I', <'I', 'R', h(na XOR ~k XOR ~nb)>) ]->  
  [ Out(<h(na XOR ~k XOR ~nb), ~nb>),
    St_Resp_1(~k, na, ~nb) ]

rule RuleStep3:
  [ In(<tag_recv, nb>),
    St_Init_1(~na) ]
  --[ Test3(),
      Eq(h(~na XOR nb), tag_recv),
      Commit('I', 'R', <'I', 'R', tag_recv>) ]->  
  [ Out('<END>') ]

restriction Equality:
  "All x y #i. Eq(x, y) @ #i ==> x = y"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

// category: aliveness
lemma aliveness_aliveness_of_the_responder:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex id #j. Create(b, id) @ j)"

// category: noninjective_agreement
lemma noninjective_agreement_noninjective_agreement_on_verification_tag:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)"

end