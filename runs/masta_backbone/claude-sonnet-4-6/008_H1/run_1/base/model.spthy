theory TwoMessageMutualAuth
begin

builtins: signing

rule Generate_Ltk:
  [ Fr(~ltk) ]
  --[ ]-> 
  [ !Ltk($A, ~ltk), !Pk($A, pk(~ltk)), Out(pk(~ltk)) ]

rule RuleStep1:
  let mI = sign(<$I, $R>, ltkI)
  in
  [ !Ltk($I, ltkI) ]
  --[ Test1(), Create($I, 'step1') ]-> 
  [ Out(mI), St_Init_1($I, $R, ltkI) ]

rule RuleStep2:
  let mR = sign(<$I, $R>, ltkR)
  in
  [ In(mI), !Ltk($R, ltkR), !Pk($I, pkI) ]
  --[ Test2(), Eq(verify(mI, <$I, $R>, pkI), true), Running($R, $I, <$I, $R>), Create($R, 'step2') ]-> 
  [ Out(mR), St_Resp_2($R, $I, ltkR) ]

rule RuleStep3:
  [ In(mR), St_Init_1($I, $R, ltkI), !Pk($R, pkR) ]
  --[ Test3(), Eq(verify(mR, <$I, $R>, pkR), true), Commit($I, $R, <$I, $R>) ]-> 
  [ Out('<END>') ]

rule LtkReveal:
  [ !Ltk($A, ltk) ]
  --[ LtkReveal($A) ]-> 
  [ Out(ltk) ]

restriction Equality:
  "All x y #i. Eq(x, y) @ #i ==> x = y"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & #t1 < #t2 & #t2 < #t3"

// category: weak_agreement
lemma weak_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex t2 #j. Running(b, a, t2) @ j)
     | (Ex X #r. LtkReveal(X) @ r)"

// category: noninjective_agreement
lemma noninjective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r)"

// category: injective_agreement
lemma injective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r)"

end