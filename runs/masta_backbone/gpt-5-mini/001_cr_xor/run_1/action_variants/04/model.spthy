theory model begin

builtins: hashing, xor
functions: com/2 [private]

rule SetupK:
  [ Fr(~k) ]
  -->
  [ !K(~k) ]

rule RuleStep1:
  [ Fr(~na) ]
  --[ Test1() ]->
  [ Out(~na), I_1(~na) ]

rule RuleStep2:
  let t = h(<na, ~k, ~nb>) in
  [ In(na), Fr(~nb), !K(~k) ]
  --[ Test2() ]->
  [ Out(<t, ~nb>), R_1(~nb) ]

rule RuleStep3:
  let t_prime = h(<~na, ~k, nb>) in
  [ In(<tag, nb>), I_1(~na), !K(~k) ]
  --[ Test3() ]->
  [ Out('<END>') ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

end
