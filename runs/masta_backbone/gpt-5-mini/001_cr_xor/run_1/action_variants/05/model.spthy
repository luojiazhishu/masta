theory crxor_raudit begin

builtins: hashing, xor

functions: k/0 [private], bar/1 [private]

rule RuleStep1:
  [ Fr(~na) ]
  --[ Test1() ]->
  [ Out(~na), StNa(~na), Honest('I'), Create('I', ~na) ]

rule RuleStep2:
  [ In(na), Fr(~nb) ]
  --[ Test2() ]->
  [ Out(<h(na ⊕ k ⊕ ~nb), ~nb>), Audit(bar(~nb)), Create('R', ~nb), Honest('R'), Running('R', 'I', h(na ⊕ k ⊕ ~nb)) ]

rule RuleStep3:
  [ In(<h(na ⊕ k ⊕ nb), nb>), StNa(na) ]
  --[ Test3() ]->
  [ Commit('I', 'R', h(na ⊕ k ⊕ nb)), Honest('I') ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

// category: aliveness
lemma aliveness_responder_aliveness:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex id #j. Create(b, id) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_noninjective_agreement_on_verification_tag:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end
