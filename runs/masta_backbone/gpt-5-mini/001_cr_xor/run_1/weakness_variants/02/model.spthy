theory crxor_nokvfy begin

builtins: hashing, xor

rule RuleStep1:
  [ Fr(~na) ]
  --[ Test1() ]->
  [ Out(~na) ]

rule RuleStep2:
  [ In(na), Fr(~nb) ]
  --[ Test2(), Create(~nb, ~nb), Running(~nb, na, h(na XOR ~nb)) ]->
  [ Out(<h(na XOR ~nb), ~nb>) ]

rule RuleStep3:
  [ In(<tag, nb>), Fr(~na) ]
  --[ Test3(), Commit(~na, nb, tag), Honest(~na) ]->
  [ ]

rule LtkReveal:
  [ !Ltk(A, ltk) ]
  --[ LtkReveal(A) ]->
  [ Out(ltk) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

// category: aliveness
lemma aliveness_responder_aliveness:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex id #j. Create(b, id) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_verification_tag_noninjective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end
