theory sk_pmd begin

builtins: symmetric-encryption

rule RuleStep1:
  [ Fr(~sec), Fr(~pub) ]
  --[ Test1(), Secret('I','R', ~sec) ]->
  [ Out( senc(<~sec, ~pub>, $k) ), Out( <~sec, ~pub> ) ]

rule RuleStep2:
  [ In(senc(<sec, pub>, $k)) ]
  --[ Test2() ]->
  [ ]

lemma executable:
  exists-trace
  "Ex #t1 #t2.
       Test1() @ #t1 & Test2() @ #t2
     & #t1 < #t2"

// category: secrecy
lemma secrecy_encapsulated_secret_secrecy:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)"

end
