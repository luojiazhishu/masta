theory model begin

builtins: signing

rule RuleStep1:
  [ Fr(~ltkI) ]
  --[ Test1(), Honest($I), Commit($I, $R, sign(<$I, $R>, ~ltkI)), Running($R, $I, sign(<$I, $R>, ~ltkI)) ]->
  [ Out( sign(<$I, $R>, ~ltkI) ) ]

rule LtkRevealRule:
  [ !Ltk($I, ~ltkI) ]
  --[ LtkReveal($I) ]->
  [ !Ltk($I, ~ltkI), Out(~ltkI) ]

// category: weak_agreement
lemma weak_agreement_weak_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex t2 #j. Running(b, a, t2) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_noninjective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_injective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

lemma executable:
  exists-trace
  "Ex #t1. Test1() @ #t1"

end
