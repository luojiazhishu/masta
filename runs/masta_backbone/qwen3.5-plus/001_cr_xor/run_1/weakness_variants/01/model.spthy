theory CR_XOR_NoVfy begin

builtins: hashing, xor

rule SetupKey:
  [
    Fr(~k)
  ]
  -->
  [ !SharedKey(~k) ]

rule SharedKeyReveal:
  [
    !SharedKey(~k)
  ]
  --[ SharedKeyReveal() ]->
  [
    Out(~k)
  ]

rule RuleStep1:
  [
    Fr(~na),
    Fr(~tid)
  ]
  --[ Test1(), Create('R',~tid), Honest('I') ]->
  [
    Out(~na),
    !InitState(~tid, ~na)
  ]

rule RuleStep2:
  [
    In(~na),
    Fr(~nb),
    !SharedKey(~k)
  ]
  --[ Test2(), Running('R','I',~na), Honest('R') ]->
  [
    Out(<h(~na ⊕ ~k ⊕ ~nb), ~nb>)
  ]

rule RuleStep3:
  [
    In(<tag, ~nb>),
    !InitState(~tid, ~na)
  ]
  --[ Test3(), Commit('I','R',~na) ]->
  [
    Out(<'END'>)
  ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

// category: aliveness
lemma aliveness_of_responder:
  "All na #i.
     Commit('I','R',na) @ i
   ==>
       (Ex id #j. Create('R',id) @ j)
     | (Ex #r. SharedKeyReveal() @ r)"

// category: noninjective_agreement
lemma noninjective_agreement_verification_tag:
  "All na #i.
     Commit('I','R',na) @ i
   ==>
       (Ex #j. Running('R','I',na) @ j)
     | (Ex #r. SharedKeyReveal() @ r)"

end