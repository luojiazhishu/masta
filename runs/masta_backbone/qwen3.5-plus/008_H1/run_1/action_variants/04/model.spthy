theory MutualAuth begin

builtins: signing

rule RegisterKeys:
  [ Fr(~ltkI), Fr(~ltkR) ]
  --[ ]->
  [ !Ltk('I', ~ltkI), !Ltk('R', ~ltkR), !Pk('I', pk(~ltkI)), !Pk('R', pk(~ltkR)) ]

rule RuleStep1:
  [ !Ltk('I', ltkI) ]
  --[ Test1(), Honest('I') ]->
  [ Out( sign(<'I', 'R'>, ltkI) ) ]

rule RuleStep2:
  [ In( sigI ), !Ltk('R', ltkR), !Pk('I', pkI) ]
  --[ Test2(), Honest('R'), Running('R', 'I', <'I','R'>) ]->
  [ Out( <sign(<'I', 'R'>, ltkR), 'tagResp'> ) ]

rule RuleStep3:
  [ In( <sigR, t> ), !Pk('R', pkR) ]
  --[ Test3(), Honest('I'), Commit('I', 'R', <'I','R'>) ]->
  [ ]

rule LtkReveal:
  [ !Ltk(A, ltk) ]
  --[ LtkReveal(A) ]->
  [ Out(ltk) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & #t1 < #t2 & #t2 < #t3"

// category: weak_agreement
lemma weak_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex t2 #j. Running(b, a, t2) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end