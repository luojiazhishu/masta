theory FAMED_H1 begin

builtins: signing

rule Generate_key_pair:
  [ Fr(~ltk) ]
  -->
  [ !Ltk($A, ~ltk)
  , !Pk($A, pk(~ltk))
  , Out(pk(~ltk))
  ]

rule RuleStep1:
  [ !Ltk($I, ~ltkI)
  , !Pk($I, pkI)
  , !Pk($R, pkR)
  ]
  --[ Test1() ]->
  [ Out(sign(<$I, $R>, ~ltkI))
  ]

rule RuleStep2:
  [ In(sigI)
  , !Ltk($R, ~ltkR)
  , !Pk($I, pkI)
  , !Pk($R, pkR)
  ]
  --[ Test2(), VerifiedI(sigI, <$I, $R>, pkI), Running($R, $I, <$I, $R>), Honest($R) ]->
  [ Out(sign(<$I, $R>, ~ltkR))
  ]

rule RuleStep3:
  [ In(sigR)
  , !Ltk($I, ~ltkI)
  , !Pk($I, pkI)
  , !Pk($R, pkR)
  ]
  --[ Test3(), VerifiedR(sigR, <$I, $R>, pkR), Commit($I, $R, <$I, $R>), Honest($I) ]->
  [ ]

rule LtkReveal:
  [ !Ltk($A, ltk) ]
  --[ LtkReveal($A) ]->
  [ Out(ltk) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & #t1 < #t2 & #t2 < #t3"

// category: weak_agreement
lemma weak_agreement_weak_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex t2 #j. Running(b, a, t2) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_noninjective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_injective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end