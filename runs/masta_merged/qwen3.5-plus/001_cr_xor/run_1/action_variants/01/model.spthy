theory CR_XOR_Echo begin

builtins: hashing, xor

functions: k/0 [private]

rule Setup_I:
  [
  ]
  --[ ]->
  [
    !Ltk('I', k)
  ]

rule Setup_R:
  [
  ]
  --[ ]->
  [
    !Ltk('R', k)
  ]

rule RuleStep1:
  [
    Fr(~na),
    Fr(~r)
  ]
  --[ Test1(), Create('I', ~na), Honest('I') ]->
  [
    Out(<~na, ~r>),
    StI(~na, ~r)
  ]

rule RuleStep2:
  [
    In(<na, r>),
    Fr(~nb)
  ]
  --[ Test2(), Create('R', ~nb), Running('R', 'I', <na, ~nb>), Honest('R') ]->
  [
    Out(<h(na XOR k XOR ~nb), ~nb, r>)
  ]

rule RuleStep3:
  [
    In(<tag, nb, r_echo>),
    StI(na, r)
  ]
  --[ Test3(), VerifyTag(na, nb, tag), VerifyEcho(r, r_echo), Commit('I', 'R', <na, nb, tag>) ]->
  [
    Out('end')
  ]

rule LtkReveal_I:
  [
    !Ltk('I', k)
  ]
  --[ LtkReveal('I') ]->
  [
    Out(k)
  ]

rule LtkReveal_R:
  [
    !Ltk('R', k)
  ]
  --[ LtkReveal('R') ]->
  [
    Out(k)
  ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & #t1 < #t2 & #t2 < #t3"

// category: aliveness
lemma aliveness_of_responder:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex id #j. Create(b, id) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_verification_tag:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end