theory CR_XOR begin

builtins: hashing, xor

rule SetupKey:
  [ Fr(~k) ]
  --[ Setup(), Honest($R) ]->
  [ !SharedKey($I, $R, ~k) ]

rule LtkReveal:
  [ !SharedKey($I, $R, k) ]
  --[ LtkReveal($R) ]->
  [ Out(k) ]

rule RuleStep1:
  [ Fr(~na) ]
  --[ Test1() ]->
  [ Out(~na), !InitWait(~na) ]

rule RuleStep2:
  [ In(~na), Fr(~nb), !SharedKey($I, $R, ~k) ]
  --[ Test2(), Running($R, $I, <~na, ~nb>), Create($R, ~nb) ]->
  [ Out(<h(~na ⊕ ~k ⊕ ~nb), ~nb>) ]

rule RuleStep3:
  [ In(<h(~na ⊕ ~k ⊕ ~nb), ~nb>), !InitWait(~na), !SharedKey($I, $R, ~k) ]
  --[ Test3(), Verified(~na, ~nb), Commit($I, $R, <~na, ~nb>) ]->
  [ ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & #t1 < #t2 & #t2 < #t3"

// category: aliveness
lemma aliveness_responder:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex id #j. Create(b, id) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_verification_tag:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end