theory CR_XOR_NoVfy begin

builtins: hashing, xor

rule SetupKeys:
  [ Fr(~k) ]
  -->
  [ !Ltk('I', ~k), !Ltk('R', ~k) ]

rule RevealKey:
  [ !Ltk(A, ~k) ]
  --[ LtkReveal(A) ]->
  [ Out(~k) ]

rule RuleStep1:
  [ Fr(~na), Fr(~tid) ]
  --[ Test1(), Create('I', ~tid), Honest('I') ]->
  [ Out(~na), !StateI(~tid, ~na) ]

rule RuleStep2:
  [ In(~na), Fr(~nb), !Ltk('R', ~k) ]
  --[ Test2(), Running('R', 'I', <~na, ~nb>), Honest('R'), Create('R', ~nb) ]->
  [ Out(<h(~na XOR ~k XOR ~nb), ~nb>) ]

rule RuleStep3:
  [ In(<tag, ~nb>), !StateI(~tid, ~na) ]
  --[ Test3(), Commit('I', 'R', <~na, ~nb>), Honest('R') ]->
  [ ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & #t1 < #t2 & #t2 < #t3"

// category: aliveness
lemma aliveness_responder:
  "All a b t #i.
    Commit(a, b, t) @ i
  ==> (Ex id #j. Create(b, id) @ j)
    | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_non_injective_agreement_on_verification_tag:
  "All a b t #i.
    Commit(a, b, t) @ i
  ==> (Ex #j. Running(b, a, t) @ j)
    | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end