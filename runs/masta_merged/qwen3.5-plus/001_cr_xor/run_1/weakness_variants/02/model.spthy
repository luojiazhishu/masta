theory CR_XOR_NoKVfy begin

builtins: hashing, xor

rule SetupKey:
  [ Fr(~k) ]
  --[ Honest('I'), Honest('R') ]->
  [ !SharedKey('I', 'R', ~k) ]

rule KeyReveal:
  [ !SharedKey('I', 'R', k) ]
  --[ LtkReveal('I'), LtkReveal('R') ]->
  [ Out(k) ]

rule RuleStep1:
  [ Fr(~na) ]
  --[ Test1(), Running('I', 'R', ~na) ]->
  [ Out(~na), !InitState('I', ~na) ]

rule RuleStep2:
  [ In(~na),
    Fr(~nb),
    !SharedKey('I', 'R', ~k) ]
  --[ Test2(), Running('R', 'I', <~na, ~nb>), Create('R', <~na, ~nb>) ]->
  [ Out(<h(~na ⊕ ~k ⊕ ~nb), ~nb>) ]

rule RuleStep3:
  [ In(<tag, nb>),
    !InitState('I', ~na) ]
  --[ Test3(), Commit('I', 'R', <~na, nb, tag>) ]->
  [ ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & #t1 < #t2 & #t2 < #t3"

// category: aliveness
lemma aliveness_aliveness_of_the_responder:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex id #j. Create(b, id) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_verification_tag:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end