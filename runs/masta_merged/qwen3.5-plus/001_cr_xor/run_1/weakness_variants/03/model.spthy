theory CR_XOR_DiscK begin

builtins: hashing, xor

rule RuleStep1:
  [
    Fr(~k)
  ]
  --[ Test1() ]->
  [
    Out(~k),
    !SharedKey(~k)
  ]

rule RuleStep2:
  [
    Fr(~na)
  ]
  --[ Test2(), Honest('Initiator') ]->
  [
    Out(~na),
    !InitNonce(~na)
  ]

rule RuleStep3:
  [
    !SharedKey(~k),
    In(na),
    Fr(~nb)
  ]
  --[ Test3(), Honest('Responder'), Create('Responder', 'Responder'), Running('Responder', 'Initiator', h(na XOR ~k XOR ~nb)) ]->
  [
    Out(<h(na XOR ~k XOR ~nb), ~nb>)
  ]

rule RuleStep4:
  [
    !SharedKey(~k),
    !InitNonce(~na),
    In(<tag, nb>)
  ]
  --[ Test4(), Honest('Initiator'), Commit('Initiator', 'Responder', tag) ]->
  [
  ]

rule SharedKeyReveal:
  [
    !SharedKey(k)
  ]
  --[ LtkReveal('Responder') ]->
  [
    Out(k)
  ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

// category: aliveness
lemma aliveness_of_responder:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex id #j. Create(b, id) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_on_tag:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end