theory LAK06 begin

builtins: hashing, xor

functions: k/0 [private]

rule RuleStep1:
  [ Fr(~r0), Fr(~r0_aux) ]
  --[ Test1(), Running('Reader', 'Tag', <~r0, ~r0_aux>) ]->
  [ Out(<~r0, ~r0_aux>), !ReaderState(~r0, ~r0_aux) ]

rule RuleStep2:
  [ In(<r0, r0_aux>), Fr(~r1) ]
  --[ Test2(), Running('Tag', 'Reader', <r0, ~r1>), Secret('Tag', 'Reader', k) ]->
  [ Out(<~r1, h(r0 ⊕ ~r1 ⊕ k)>), !TagState(r0, ~r1, h(r0 ⊕ ~r1 ⊕ k)) ]

rule RuleStep3:
  let expected = h(r0 ⊕ r1 ⊕ k)
      reader_mac = h(tag_mac ⊕ k ⊕ r0)
  in
  [ In(<r1, tag_mac>), !ReaderState(r0, r0_aux) ]
  --[ Test3(), Commit('Reader', 'Tag', <r0, r1>), Secret('Reader', 'Tag', k) ]->
  [ Out(reader_mac) ]

rule RuleStep4:
  let expected = h(tag_mac ⊕ k ⊕ r0)
  in
  [ In(reader_mac), !TagState(r0, r1, tag_mac) ]
  --[ Test4(), Commit('Tag', 'Reader', <r0, r1>), Secret('Tag', 'Reader', k) ]->
  [ Out('<END>') ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

// category: secrecy
lemma secrecy_long_term_key:
  "All A B #i.
     Secret(A, B, k) @ i
   ==>
     not (Ex #j. K(k) @ j)"

// category: noninjective_agreement
lemma noninjective_agreement_tag_authenticates_reader:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
     (Ex #j. Running(b, a, t) @ j)"

// category: noninjective_agreement
lemma noninjective_agreement_reader_authenticates_tag:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
     (Ex #j. Running(b, a, t) @ j)"

end