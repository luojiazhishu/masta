theory LAK06 begin

builtins: hashing, xor

rule KeySetup:
  [
    Fr(~k)
  ]
  --[ Secret($Reader, $Tag, ~k), Honest($Reader), Honest($Tag) ]->
  [
    !Ltk($Reader, ~k),
    !Ltk($Tag, ~k)
  ]

rule LtkReveal:
  [
    !Ltk(A, k)
  ]
  --[ LtkReveal(A) ]->
  [
    Out(k)
  ]

rule RuleStep1:
  [
    Fr(~r0)
  ]
  --[ Test1() ]->
  [
    Out(~r0),
    !ReaderState(~r0)
  ]

rule RuleStep2:
  [
    In(~r0),
    Fr(~r1),
    Fr(~r1_aux),
    !Ltk($Tag, ~k)
  ]
  --[ Test2(), Running($Tag, $Reader, <~r0, ~r1, ~k>) ]->
  [
    Out(<~r1, h(~r0 ⊕ ~r1 ⊕ ~k), ~r1_aux>),
    !TagState(~r0, ~r1, ~k)
  ]

rule RuleStep3:
  [
    In(<~r1, tag_mac, ~r1_aux>),
    !ReaderState(~r0),
    !Ltk($Reader, ~k)
  ]
  --[ Test3(), Commit($Reader, $Tag, <~r0, ~r1, ~k>), Running($Reader, $Tag, <~r0, ~r1, ~k>) ]->
  [
    Out(h(tag_mac ⊕ ~k ⊕ ~r0))
  ]

rule RuleStep4:
  [
    In(h(h(~r0 ⊕ ~r1 ⊕ ~k) ⊕ ~k ⊕ ~r0)),
    !TagState(~r0, ~r1, ~k)
  ]
  --[ Test4(), Commit($Tag, $Reader, <~r0, ~r1, ~k>) ]->
  [
  ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

// category: secrecy
lemma secrecy_long_term_key_secrecy:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_tag_authentication_of_reader:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_reader_authentication_of_tag:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end