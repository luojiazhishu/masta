theory LAK06 begin

builtins: hashing, xor

functions: k/0 [private]

rule Setup:
  [ ]
  --[ Setup(), Honest('Reader'), Honest('Tag'), Secret('Reader', 'Tag', k()) ]->
  [ !SharedKey(k()) ]

rule RuleStep1:
  [ Fr(~r0) ]
  --[ Test1() ]->
  [ Out(~r0) ]

rule RuleStep2:
  [ In(~r0), Fr(~r1), !SharedKey(k()) ]
  --[ Test2(), Running('Tag', 'Reader', <~r0, ~r1>) ]->
  [ Out(<~r1, h(~r0 ⊕ ~r1 ⊕ k())>) ]

rule RuleStep3:
  [ In(<~r1, tag_mac>), !SharedKey(k()), Fr(~r0_check) ]
  --[ Test3(), Running('Reader', 'Tag', <~r0_check, ~r1>), ReaderAccepts(~r0_check, ~r1), Commit('Reader', 'Tag', <~r0_check, ~r1>) ]->
  [ Out(< 'CONF', h(tag_mac ⊕ k() ⊕ ~r0_check) >) ]

rule RuleStep4:
  [ In(< 'CONF', reader_mac >), !SharedKey(k()), Fr(~r0_tag), Fr(~r1_tag) ]
  --[ Test4(), TagAccepts(~r0_tag, ~r1_tag), Commit('Tag', 'Reader', <~r0_tag, ~r1_tag>) ]->
  [ ]

rule LtkReveal:
  [ !SharedKey(k()) ]
  --[ LtkReveal('Reader'), LtkReveal('Tag') ]->
  [ Out(k()) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

// category: secrecy
lemma secrecy_long_term_key:
  "All A B #i.
     Secret(A, B, k()) @ i
   ==>
       not (Ex #j. K(k()) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_tag:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_reader:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end