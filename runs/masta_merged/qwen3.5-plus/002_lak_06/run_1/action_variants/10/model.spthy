theory LAK06 begin

builtins: hashing, xor

functions: k/0 [private]

rule Setup:
  [
  ]
  --[ ]->
  [
    !Ltk($R, k),
    !Ltk($T, k)
  ]

rule RuleStep1:
  [
    Fr(~r0)
  ]
  --[ Test1(), Honest($R) ]->
  [
    Out(~r0),
    StReader(~r0)
  ]

rule RuleStep2:
  [
    Fr(~r1),
    In(~r0)
  ]
  --[ Test2(), Honest($T), Secret($T, $R, k), Running($T, $R, <~r0, ~r1>) ]->
  [
    Out(<~r1, h(~r0 ⊕ ~r1 ⊕ k)>),
    StTag(~r0, ~r1, h(~r0 ⊕ ~r1 ⊕ k))
  ]

rule RuleStep3:
  [
    StReader(~r0),
    In(<~r1, tag_mac>)
  ]
  --[ Test3(), Commit($R, $T, <~r0, ~r1>), Running($R, $T, <~r0, ~r1>) ]->
  [
    Out(h(tag_mac ⊕ k ⊕ ~r0 ⊕ 'CONFIRM')),
    StReaderDone(~r0, ~r1, tag_mac)
  ]

rule RuleStep4:
  [
    StTag(~r0, ~r1, tag_mac),
    In(reader_mac)
  ]
  --[ Test4(), Commit($T, $R, <~r0, ~r1>) ]->
  [
    Out('<END>')
  ]

rule LtkReveal:
  [
    !Ltk($X, k)
  ]
  --[ LtkReveal($X) ]->
  [
    Out(k)
  ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

// category: secrecy
lemma secrecy_long_term_key:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_tag:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_reader:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end