theory LAK06 begin

builtins: hashing, xor

rule ProvisionKey:
  [ Fr(~k) ]
  --[ KeyGen(), Secret('Reader', 'Tag', ~k), Honest('Reader'), Honest('Tag') ]->
  [ !Ltk('Reader', ~k), !Ltk('Tag', ~k) ]

rule LtkReveal:
  [ !Ltk(A, k) ]
  --[ LtkReveal(A) ]->
  [ Out(k) ]

rule RuleStep1:
  [ Fr(~r0), Fr(~tidR), !Ltk('Reader', k) ]
  --[ Test1(), Honest('Reader') ]->
  [ Out(~r0), !StateR1(~tidR, 'Reader', 'Tag', ~r0, k) ]

rule RuleStep2:
  [ In(~r0), Fr(~r1), Fr(~tidT), !Ltk('Tag', k) ]
  --[ Test2(), Honest('Tag'), Running('Tag', 'Reader', <~r0, ~r1, k>) ]->
  [ Out(<~r1, h(~r0 XOR ~r1 XOR k)>), !StateT1(~tidT, 'Tag', 'Reader', ~r0, ~r1, k) ]

rule RuleStep3:
  [ In(<r1, h(r0 XOR r1 XOR k)>), !StateR1(tidR, 'Reader', 'Tag', r0, k) ]
  --[ Test3(), Honest('Reader'), Running('Reader', 'Tag', <r0, r1, k>), Commit('Reader', 'Tag', <r0, r1, k>) ]->
  [ Out(<h(h(r0 XOR r1 XOR k) XOR k XOR r0), h(h(r0 XOR r1 XOR k) XOR k XOR r0)>), !StateR2(tidR, 'Reader', 'Tag', r0, r1, k) ]

rule RuleStep4:
  [ In(<reader_mac_a, reader_mac_b>), !StateT1(tidT, 'Tag', 'Reader', r0, r1, k) ]
  --[ Test4(), Honest('Tag'), Commit('Tag', 'Reader', <r0, r1, k>) ]->
  [ !StateT2(tidT, 'Tag', 'Reader', r0, r1, k) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

// category: secrecy
lemma secrecy_long_term_key:
  "All A B x #i.
     Secret(A, B, x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_tag:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_reader:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end
