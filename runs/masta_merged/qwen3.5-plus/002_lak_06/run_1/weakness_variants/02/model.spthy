theory LAK06 begin

builtins: hashing, xor

functions: k/0 [private]

rule SetupKey:
  [
    Fr(~ltk)
  ]
  --[ ]->
  [
    !Ltk('Tag', ~ltk)
  ]

rule RuleStep1:
  [
    Fr(~r0)
  ]
  --[ Test1(), Honest('Reader'), Running('Reader', 'Tag', <~r0>) ]->
  [
    Out(~r0),
    !RdrState(~r0)
  ]

rule RuleStep2:
  [
    In(~r0),
    Fr(~r1),
    !Ltk('Tag', ltk)
  ]
  --[ Test2(), Honest('Tag'), Secret(ltk), Running('Tag', 'Reader', <~r0, ~r1>) ]->
  [
    Out(<~r1, h(~r0 XOR ~r1 XOR ltk)>),
    !TagState(~r0, ~r1)
  ]

rule RuleStep3:
  [
    In(<~r1, tag_mac>),
    !RdrState(~r0),
    !Ltk('Tag', ltk)
  ]
  --[ Test3(), Honest('Reader'), Commit('Reader', 'Tag', <~r0, ~r1, tag_mac>) ]->
  [
    Out(h(tag_mac XOR ltk XOR ~r0))
  ]

rule RuleStep4:
  [
    !TagState(~r0, ~r1)
  ]
  --[ Test4(), Commit('Tag', 'Reader', <~r0, ~r1>) ]->
  [
  ]

rule LtkReveal:
  [
    !Ltk('Tag', ltk)
  ]
  --[ LtkReveal('Tag') ]->
  [
    Out(ltk)
  ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

// category: secrecy
lemma secrecy_long_term_key_secrecy:
  "All x #i.
    Secret(x) @ i
  ==>
      not (Ex #j. K(x) @ j)
    | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_tag:
  "All a b t #i.
    Commit(a, b, t) @ i
  ==> (Ex #j. Running(b, a, t) @ j)
      | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_reader:
  "All a b t #i.
    Commit(a, b, t) @ i
  ==> (Ex #j. Running(b, a, t) @ j)
      | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end
