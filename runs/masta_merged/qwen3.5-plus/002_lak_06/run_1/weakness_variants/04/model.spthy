theory LAK06 begin

builtins: hashing, xor

// Long-term key k is shared between Reader and Tag (private function)
functions: k/0 [private]

// RuleStep1: Reader generates fresh r0 and sends challenge
// Stores r0 in persistent state for later verification
rule RuleStep1:
  [ Fr(~r0) ]
  --[ Test1(), Create('Reader', ~r0), Secret(k), Honest('Reader') ]->
  [ Out(~r0), !ReaderState(~r0) ]

// RuleStep2: Tag receives r0, generates fresh r1, computes tag_mac, sends response
// tag_mac = h(r0 XOR r1 XOR k)
rule RuleStep2:
  [ Fr(~r1), In(~r0) ]
  --[ Test2(), Running('Tag', 'Reader', <~r0, ~r1>), Honest('Tag') ]->
  [ Out(<~r1, h(~r0 ⊕ ~r1 ⊕ k)>), !TagState(~r0, ~r1) ]

// RuleStep3: Reader receives response, verifies tag_mac, computes and sends reader_mac
// reader_mac = h(tag_mac XOR r0)
rule RuleStep3:
  [ In(<~r1, tag_mac>), !ReaderState(~r0) ]
  --[ Test3(), Running('Reader', 'Tag', <~r0, ~r1>), Commit('Reader', 'Tag', <~r0, ~r1>) ]->
  [ Out(h(tag_mac ⊕ ~r0)) ]

// RuleStep4: Tag receives reader_mac, verifies it
// expected = h(tag_mac XOR r0)
rule RuleStep4:
  [ In(reader_mac), !TagState(~r0, ~r1) ]
  --[ Test4(), Commit('Tag', 'Reader', <~r0, ~r1>) ]->
  [ ]

// Long-term key reveal rule (for compromise modeling)
rule LtkReveal:
  [ ]
  --[ LtkReveal('ReaderTag') ]->
  [ Out(k) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4. Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

// category: secrecy
lemma secrecy_long_term_key:
  "All #i.
    Secret(k) @ i
  ==>
      not (Ex #j. K(k) @ j)
    | (Ex X #r. LtkReveal(X) @ r)"

// category: noninjective_agreement
lemma noninjective_agreement_tag:
  "All a b t #i.
    Commit(a,b,t) @ i
  ==>
      (Ex #j. Running(b,a,t) @ j)
    | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_reader:
  "All a b t #i.
    Commit(a,b,t) @ i
  ==>
      (Ex #j. Running(b,a,t) @ j)
    | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end