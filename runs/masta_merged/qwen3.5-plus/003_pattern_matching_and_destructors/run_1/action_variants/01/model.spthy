theory sk_pmd begin

builtins: symmetric-encryption

// RuleStep1: Initiator generates sec, pub, k, computes msg, sends <msg, 'pmd'>
rule RuleStep1:
  [
    Fr(~sec),
    Fr(~pub),
    Fr(~k)
  ]
  --[ Test1(), Secret(~sec) ]->
  [
    Out(<senc(<~sec, ~pub>, ~k), 'pmd'>)
  ]

// RuleStep2: Responder receives <msg, 'pmd'>
rule RuleStep2:
  [
    In(<msg, 'pmd'>)
  ]
  --[ Test2() ]->
  [
  ]

lemma executable:
  exists-trace
  "Ex #t1 #t2.
       Test1() @ #t1 & Test2() @ #t2
     & #t1 < #t2"

// category: secrecy
lemma secrecy_encapsulated_secret:
  "All x #i.
     Secret(x) @ i
   ==> 
     not (Ex #j. K(x) @ j)"

end