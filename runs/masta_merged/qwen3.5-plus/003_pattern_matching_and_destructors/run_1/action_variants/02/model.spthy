theory sk_pmd begin

builtins: symmetric-encryption

// Persistent fact for the shared key k
// In this profile, k is a pre-shared symmetric key known to I and R.
// We model it as a persistent fact generated at setup.
rule SetupKey:
  [
    Fr(~k)
  ]
  --[ ]->
  [
    !SharedKey(~k)
  ]

// Rule for key compromise (to support the escape clause in secrecy lemma)
// The adversary can learn the long-term key k via this rule.
rule RevealKey:
  [
    !SharedKey(~k)
  ]
  --[ RevealKey() ]->
  [
    Out(~k)
  ]

// RuleStep1: Initiator generates sec, pub, computes msg = senc(<sec, pub>, k), sends <msg, tag>
rule RuleStep1:
  let
    msg = senc(<~sec, ~pub>, ~k)
  in
  [
    Fr(~sec),
    Fr(~pub),
    Fr(~tag),
    !SharedKey(~k)
  ]
  --[ Test1(), Secret(~sec) ]->
  [
    Out(<msg, ~tag>)
  ]

// RuleStep2: Responder receives <msg, tag>
rule RuleStep2:
  [
    In(<msg, tag>),
    !SharedKey(~k)
  ]
  --[ Test2() ]->
  [
  ]

lemma executable:
  exists-trace
  "Ex #t1 #t2.
       Test1() @ #t1 & Test2() @ #t2
     & #t1 < #t2"

// Property 1: Secrecy of Encapsulated Secret
// category: secrecy
// scope: sec (encapsulated secret payload)
// description: The secret payload `sec` must remain unknown to the adversary unless the shared key `k` is compromised.
// Revised lemma: Removed the invalid 'Out(k)' check from the escape clause.
// The lemma now states: If Secret(x) occurs, then either the adversary never knows x, OR the key was revealed (RevealKey action occurred).
// The RevealKey action implies the key is output, so checking the action is sufficient and syntactically correct.
lemma secrecy_sec:
  "All x #i.
     Secret(x) @ i
   ==> 
       not (Ex #j. K(x) @ j)
     | (Ex #r. RevealKey() @ r)"

end