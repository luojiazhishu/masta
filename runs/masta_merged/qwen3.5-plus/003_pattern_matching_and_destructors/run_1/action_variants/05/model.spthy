theory sk_pmd begin

builtins: symmetric-encryption, hashing

functions: k/0

rule Setup:
  [
    Fr(~ltk)
  ]
  -->
  [
    !Ltk('I', ~ltk),
    !Ltk('R', ~ltk)
  ]

rule RuleStep1:
  [
    Fr(~sec),
    Fr(~pub),
    !Ltk('I', ltkI)
  ]
  --[ Test1(), Secret(~sec), Honest('I') ]->
  [
    Out(<senc(<~sec, ~pub>, k), h(~sec)>)
  ]

rule RuleStep2:
  [
    In(<msg, witness>),
    !Ltk('R', ltkR)
  ]
  --[ Test2(), Honest('R') ]->
  [
  ]

rule LtkReveal:
  [ !Ltk(X, ltk) ]
  --[ LtkReveal(X) ]->
  [ Out(ltk) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2.
       Test1() @ #t1 & Test2() @ #t2
     & #t1 < #t2"

// category: secrecy
// The protocol exposes h(sec) in cleartext. In the symbolic Dolev-Yao model,
// this does not automatically reveal sec if sec is high-entropy. However,
// the previous verification returned 'falsified', indicating Tamarin found
// a trace where the adversary learns sec. This is likely due to the
// 'witness' variable in RuleStep2 or the structure allowing the adversary
// to link h(sec) to sec via some derivation not blocked by the one-way
// property in the specific trace found (e.g., if sec was low entropy or
// if the model implies a guessability attack).
// Given the document claims secrecy holds, we must accept the falsified
// verdict as the analysis result: the property as stated does not hold
// under the current model constraints or the model reveals a weakness
// (linkability/guessing) not captured by simple DY secrecy.
// We record the lemma as defined; the falsified verdict is the answer.
lemma secrecy_sec:
  "All x #i.
     Secret(x) @ i
   ==>
       not (Ex #j. K(x) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end