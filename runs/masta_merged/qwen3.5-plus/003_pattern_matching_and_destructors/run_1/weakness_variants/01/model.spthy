theory SK_PMD_W01 begin

builtins: symmetric-encryption

functions: k/0

rule RuleStep1:
  [
    Fr(~sec),
    Fr(~pub)
  ]
  --[ Test1() ]->
  [
    Out(senc(<~sec, ~pub>, k)),
    Out(~sec)
  ]

rule RuleStep2:
  [
    In(senc(<sec, pub>, k)),
    In(sec_clear)
  ]
  --[ Test2() ]->
  [
  ]

lemma executable:
  exists-trace
  "Ex #t1 #t2.
       Test1() @ #t1 & Test2() @ #t2
     & #t1 < #t2"

end