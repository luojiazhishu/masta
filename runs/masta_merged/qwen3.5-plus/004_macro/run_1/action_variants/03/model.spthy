theory BSKT_I begin

builtins: asymmetric-encryption, hashing

functions: tag_init/0

equations: tag_init() = 'init'

rule Generate_Server_Keys:
  [ Fr(~skS) ]
  --[ ]->
  [ !Ltk($S, ~skS), !Pk($S, pk(~skS)), Out(pk(~skS)) ]

rule RuleStep1:
  [ Fr(~k), !Pk($S, pkS) ]
  --[ Test1() ]->
  [ Out(<aenc(~k, pkS), 'init'>) ]

rule RuleStep2:
  [ In(<ciphertext, 'init'>), !Ltk($S, skS) ]
  let k = adec(ciphertext, skS) in
  --[ Test2() ]->
  [ Out(h(k)) ]

rule RuleStep3:
  [ In(m2), Fr(~k) ]
  --[ Test3() ]->
  [ ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

end