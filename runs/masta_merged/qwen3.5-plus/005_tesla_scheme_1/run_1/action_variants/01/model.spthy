theory TESLA_Scheme1 begin

builtins: signing, hashing, symmetric-encryption

functions: f/1, MAC/2

// Long-term key generation for Sender S
rule Generate_Key_S:
  [ Fr(~sk_s) ]
  --[ LtkGen($S, ~sk_s) ]->
  [ !Ltk($S, ~sk_s), !Pk($S, pk(~sk_s)), Out(pk(~sk_s)) ]

// RuleStep1: Receiver R initiates setup with nonce and tag
rule RuleStep1:
  [ Fr(~n_R), Fr(~tag_R), Fr(~tid_R) ]
  --[ Test1(), StartR(~tid_R, $R, $S, ~n_R, ~tag_R) ]->
  [ Out(<$R, $S, ~n_R, ~tag_R>), !StateR1(~tid_R, $R, $S, ~n_R, ~tag_R) ]

// RuleStep2: Sender S receives setup request, generates k_1, signs response
rule RuleStep2:
  [ In(<$R, $S, n_R, tag_R>), Fr(~k_1), Fr(~tid_S), !Ltk($S, ~sk_s) ]
  let commit_1 = f(~k_1)
      sig_data = <commit_1, n_R, tag_R>
      sig_0b = sign(sig_data, ~sk_s)
  in
  --[ Test2(), StartS(~tid_S, $S, $R, ~k_1, commit_1, n_R, tag_R) ]->
  [ Out(<$S, $R, commit_1, sig_0b>), !StateS1(~tid_S, $S, $R, ~k_1, commit_1) ]

// RuleStep3: Receiver R verifies signature and commits
rule RuleStep3:
  [ In(<$S, $R, commit_1, sig_0b>), !StateR1(~tid_R, $R, $S, n_R, tag_R), !Pk($S, pk_s) ]
  let sig_data = <commit_1, n_R, tag_R>
  in
  [ verify(sig_0b, sig_data, pk_s) = true ]
  --[ Test3(), CommitR(~tid_R, $R, $S, commit_1) ]->
  [ !StateR2(~tid_R, $R, $S, commit_1, n_R, tag_R) ]

// RuleStep4: Sender S broadcasts Msg 1 (D_1, MAC)
rule RuleStep4:
  [ !StateS1(~tid_S, $S, $R, ~k_1, commit_1), Fr(~k_2), Fr(~m_1) ]
  let commit_2 = f(~k_2)
      D_1 = <~m_1, commit_2>
      mac_1 = MAC(~k_1, D_1)
  in
  --[ Test4(), SendS1(~tid_S, $S, $R, ~m_1, commit_2, ~k_1) ]->
  [ Out(<D_1, mac_1>), !StateS2(~tid_S, $S, $R, ~k_2, commit_2) ]

// RuleStep5: Receiver R receives Msg 1 (caches)
rule RuleStep5:
  [ In(<D_1, mac_1>), !StateR2(~tid_R, $R, $S, commit_1, n_R, tag_R) ]
  let D_1 = <m_1, commit_2>
  in
  --[ Test5(), CacheR(~tid_R, $R, $S, D_1, mac_1, commit_1) ]->
  [ !StateR3(~tid_R, $R, $S, commit_1, commit_2, D_1, mac_1) ]

// RuleStep6: Sender S broadcasts Msg n (D_n, MAC, discloses k_{n-1})
rule RuleStep6:
  [ !StateS2(~tid_S, $S, $R, ~k_n, commit_n), Fr(~k_next), Fr(~m_n), Fr(~k_prev) ]
  let commit_next = f(~k_next)
      D_n = <~m_n, commit_next, ~k_prev>
      mac_n = MAC(~k_n, D_n)
  in
  --[ Test6(), SendSn(~tid_S, $S, $R, ~m_n, commit_next, ~k_prev, ~k_n) ]->
  [ Out(<D_n, mac_n>), !StateS2(~tid_S, $S, $R, ~k_next, commit_next) ]

// RuleStep7: Receiver R receives Msg n and verifies with disclosed key
rule RuleStep7:
  [ In(<D_n, mac_n>), !StateR3(~tid_R, $R, $S, commit_prev, commit_n, cached_D, cached_mac) ]
  let D_n = <m_n, commit_next, k_disclosed>
      check_data = <m_n, commit_next, k_disclosed>
  in
  [ MAC(k_disclosed, check_data) = mac_n, f(k_disclosed) = commit_n ]
  --[ Test7(), VerifyR(~tid_R, $R, $S, m_n, k_disclosed) ]->
  [ !StateR4(~tid_R, $R, $S, m_n) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4 #t5 #t6 #t7.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 &
       Test4() @ #t4 & Test5() @ #t5 & Test6() @ #t6 & Test7() @ #t7
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4 & #t4 < #t5 & #t5 < #t6 & #t6 < #t7"

end