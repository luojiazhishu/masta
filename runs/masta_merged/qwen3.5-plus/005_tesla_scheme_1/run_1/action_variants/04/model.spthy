theory TESLA_Scheme1 begin

builtins: hashing, signing

functions: MAC/2, f/1

// RuleStep1: Receiver R sends setup request with nonce
rule RuleStep1:
  [
    Fr(~n_R)
  ]
  --[ Test1(), Out(<$R, $S, ~n_R>) ]->
  [
    Out(<$R, $S, ~n_R>)
  ]

// RuleStep2: Sender S receives request, generates key k1, sends commitment and signature
rule RuleStep2:
  [
    In(<$R, $S, n_R>),
    Fr(~k_1)
  ]
  --[ Test2(), Out(<$S, $R, f(~k_1), sign(<f(~k_1), n_R>, sk($S))>) ]->
  [
    Out(<$S, $R, f(~k_1), sign(<f(~k_1), n_R>, sk($S))>),
    !ChainKey($S, 1, ~k_1)
  ]

// RuleStep3: Sender S sends first stream message (Msg 1)
rule RuleStep3:
  [
    !ChainKey($S, 1, k_1),
    Fr(~k_2),
    Fr(~m_1)
  ]
  --[ Test3(), Out(< <~m_1, f(~k_2)>, MAC(k_1, <~m_1, f(~k_2)>) >) ]->
  [
    Out(< <~m_1, f(~k_2)>, MAC(k_1, <~m_1, f(~k_2)>) >),
    !ChainKey($S, 2, ~k_2),
    !DisclosedKey($S, 1, k_1)
  ]

// RuleStep4: Sender S sends subsequent stream message (Msg i, i >= 2)
rule RuleStep4:
  [
    !ChainKey($S, i, k_i),
    !ChainKey($S, i+1, k_next),
    Fr(~m_i),
    Fr(~r_i)
  ]
  --[ Test4(), Out(< <~m_i, f(k_next), k_i>, MAC(k_i, <~m_i, f(k_next), k_i>), ~r_i >) ]->
  [
    Out(< <~m_i, f(k_next), k_i>, MAC(k_i, <~m_i, f(k_next), k_i>), ~r_i >)
  ]

// RuleStep5: Receiver R receives and verifies stream message
// MAC verification is modeled by pattern matching in the In fact:
// the receiver only accepts if the incoming mac equals MAC(k_i, D)
rule RuleStep5:
  [
    In(<D, MAC(k_i, D)>),
    !ChainKey($S, i, k_i)
  ]
  --[ Test5(), Verified($R, D) ]->
  [
    Verified($R, D)
  ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4 #t5.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & Test5() @ #t5
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4 & #t4 < #t5"

end