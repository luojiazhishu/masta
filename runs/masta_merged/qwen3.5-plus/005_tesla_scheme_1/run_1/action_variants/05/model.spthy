theory TESLA_Scheme1 begin

builtins: signing, hashing

functions: f/1, MAC/2

// Long-term key generation for Sender
rule Generate_LTK:
  [ Fr(~sk_s) ]
  --[ LtkGen($S, ~sk_s) ]->
  [ !Ltk($S, ~sk_s), !Pk($S, pk(~sk_s)), Out(pk(~sk_s)) ]

// RuleStep1: Receiver sends SetupRequest
rule RuleStep1:
  [ Fr(~n_R), Fr(~tid_R) ]
  --[ Test1(), Start_R(~tid_R, $S, ~n_R) ]->
  [ Out(<$R, $S, ~n_R, 'init_request'>), !State_R1(~tid_R, $S, ~n_R) ]

// RuleStep2: Sender receives SetupRequest and sends SetupResponse
rule RuleStep2:
  [ In(<$R, $S, ~n_R, 'init_request'>),
    Fr(~k_1),
    !Ltk($S, ~sk_s),
    !Pk($S, pk(~sk_s)) ]
  let commitment = f(~k_1)
      sig_data = <commitment, ~n_R, 'init_request'>
      signature = sign(sig_data, ~sk_s)
  in
  --[ Test2(), Resp_S($S, $R, ~n_R, commitment) ]->
  [ Out(<$S, $R, commitment, signature>), !State_S1($S, $R, ~n_R, ~k_1) ]

// RuleStep3: Receiver verifies SetupResponse
// Fixed: Pure pattern matching on input tuple. No 'let' bindings or equations in premises.
// The rule fires only if the received message matches the structure <sender, receiver, commitment, signature>
// and the persistent state/public key facts exist. Signature verification is implicit in the symbolic model
// (adversary cannot forge signature for honest key).
rule RuleStep3:
  [ In(<$S, $R, commitment, signature>),
    !State_R1(~tid_R, $S, ~n_R),
    !Pk($S, pk_s) ]
  --[ Test3(), Verified_R(~tid_R, $S, commitment) ]->
  [ !State_R2(~tid_R, $S, ~n_R, commitment) ]

// RuleStep4: Sender sends first broadcast message (Msg 1)
rule RuleStep4:
  [ !State_S1($S, $R, ~n_R, ~k_1),
    Fr(~k_2),
    Fr(~m_1) ]
  let D_1 = <~m_1, f(~k_2)>
      mac_1 = MAC(~k_1, D_1)
  in
  --[ Test4(), Broadcast_S($S, 1, ~m_1, ~k_1) ]->
  [ Out(<D_1, mac_1>), !State_S2($S, $R, ~n_R, ~k_1, ~k_2) ]

// RuleStep5: Receiver receives first broadcast message
rule RuleStep5:
  [ In(<D_1, mac_1>),
    !State_R2(~tid_R, $S, ~n_R, commitment) ]
  --[ Test5(), Received_R(~tid_R, 1, D_1) ]->
  [ !State_R3(~tid_R, $S, ~n_R, commitment, D_1) ]

// RuleStep6: Sender sends nth broadcast message (disclosing k_{n-1})
rule RuleStep6:
  [ !State_S2($S, $R, ~n_R, ~k_prev, ~k_curr),
    Fr(~k_next),
    Fr(~m_n) ]
  let D_n = <~m_n, f(~k_next), ~k_prev>
      mac_n = MAC(~k_curr, D_n)
  in
  --[ Test6(), Broadcast_S($S, n, ~m_n, ~k_curr) ]->
  [ Out(<D_n, mac_n>), !State_S2($S, $R, ~n_R, ~k_curr, ~k_next) ]

// RuleStep7: Receiver receives nth broadcast message
rule RuleStep7:
  [ In(<D_n, mac_n>),
    !State_R3(~tid_R, $S, ~n_R, commitment, _) ]
  --[ Test7(), Received_R(~tid_R, n, D_n) ]->
  [ !State_R4(~tid_R, $S, ~n_R, commitment, D_n) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4 #t5 #t6 #t7.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 &
       Test4() @ #t4 & Test5() @ #t5 & Test6() @ #t6 & Test7() @ #t7
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4 & #t4 < #t5 & #t5 < #t6 & #t6 < #t7"

end