theory TESLA_Scheme1 begin

builtins: signing, hashing

functions: f/1, mac/2

// PKI Setup: Generate long-term signing key for Sender S
// S is a public constant representing the sender identity
rule Setup_S:
  [ Fr(~sk_S) ]
  --[ Setup($S, pk(~sk_S)) ]->
  [ !Ltk($S, ~sk_S), !Pk($S, pk(~sk_S)), Out(pk(~sk_S)) ]

// RuleStep1: Receiver R generates nonce n_R and sends setup request
rule RuleStep1:
  [ Fr(~n_R), Fr(~tid_R) ]
  --[ Test1(), Start_R(~tid_R, $S, ~n_R) ]->
  [ Out(<$R, $S, ~n_R>), !State_R_1(~tid_R, $S, ~n_R) ]

// RuleStep2: Sender S receives request, generates keys, signs commitment, sends response
rule RuleStep2:
  [ In(<$R, $S, n_R>), Fr(~k_1), Fr(~k_2), !Ltk($S, ~sk_S) ]
  --[ Test2(), Resp_S($S, $R, f(~k_1), n_R) ]->
  [ Out(<$S, $R, f(~k_1), sign(<f(~k_1), n_R>, ~sk_S)>), !State_S_1($S, $R, ~k_1, ~k_2, n_R) ]

// RuleStep3: Receiver R receives response, verifies signature
rule RuleStep3:
  [ In(<$S, $R, f_k1, sig>), !State_R_1(~tid_R, $S, n_R), !Pk($S, pk_S) ]
  --[ Test3(), Verified_R(~tid_R, $S, f_k1) ]->
  [ !State_R_2(~tid_R, $S, f_k1, n_R) ]

// RuleStep4: Sender S broadcasts first stream message with marker
rule RuleStep4:
  [ !State_S_1($S, $R, ~k_1, ~k_2, n_R), Fr(~m_1) ]
  --[ Test4(), Send_Stream1($S, $R, ~m_1, f(~k_2)) ]->
  [ Out(<<~m_1, f(~k_2)>, mac(~k_1, <~m_1, f(~k_2)>), 'data1_marker'>), !State_S_2($S, $R, ~k_1, ~k_2) ]

// RuleStep5: Receiver R receives stream message, checks marker
rule RuleStep5:
  [ In(<D_1, mac_1, marker>), !State_R_2(~tid_R, $S, f_k1, n_R) ]
  --[ Test5(), Recv_Stream1(~tid_R, $S, D_1, mac_1, marker) ]->
  [ !State_R_3(~tid_R, $S, D_1, mac_1, marker) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4 #t5.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & Test5() @ #t5
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4 & #t4 < #t5"

end