theory TESLA_Scheme1 begin

builtins: signing, hashing

functions: MAC/2, f/1

// PKI Setup: Sender S has long-term signing key
rule SetupKeys:
  [ Fr(~sk_s) ]
  --[ Create('S', ~sk_s) ]->
  [ !Ltk('S', ~sk_s), !Pk('S', pk(~sk_s)), Out(pk(~sk_s)) ]

// Step 1: Receiver R sends nonce n_R to Sender S
rule RuleStep1:
  [ Fr(~n_R) ]
  --[ Test1(), Send('R', 'S', ~n_R) ]->
  [ Out(< 'R', 'S', ~n_R >) ]

// Step 2: Sender S receives n_R, generates k_1, sends commitment and signature
rule RuleStep2:
  [ In(< 'R', 'S', n_R >), !Ltk('S', sk_s), Fr(~k_1) ]
  --[ Test2(), Send('S', 'R', <f(~k_1), sign(<f(~k_1), n_R>, sk_s)>) ]->
  [ Out(< 'S', 'R', f(~k_1), sign(<f(~k_1), n_R>, sk_s) >) ]

// Step 3: Receiver R receives commitment and signature, verifies
rule RuleStep3:
  [ In(< 'S', 'R', f_k1, sig >) ]
  --[ Test3(), Verify('R', 'S', f_k1, sig) ]->
  [ ]

// Step 4: Sender S sends first stream message (D_1, MAC_1)
rule RuleStep4:
  [ Fr(~k_1), Fr(~k_2), Fr(~m_1) ]
  --[ Test4(), StreamSend('S', 1, ~m_1, f(~k_2), MAC(~k_1, <<~m_1, f(~k_2)>, 'stream'>)) ]->
  [ Out(<<~m_1, f(~k_2)>, MAC(~k_1, <<~m_1, f(~k_2)>, 'stream'>)>), !KnownKey('S', 1, ~k_1) ]

// Step 5: Receiver R receives first stream message
rule RuleStep5:
  [ In(< D_1, mac_1 >) ]
  --[ Test5(), StreamRecv('R', 1, D_1, mac_1) ]->
  [ !CachedMsg('R', 1, D_1, mac_1) ]

// Step 6: Sender S sends subsequent stream message (D_2, MAC_2) disclosing k_1
rule RuleStep6:
  [ !KnownKey('S', 1, k_1), Fr(~k_2), Fr(~k_3), Fr(~m_2) ]
  --[ Test6(), StreamSend('S', 2, ~m_2, f(~k_3), k_1, MAC(~k_2, <<~m_2, f(~k_3), k_1>, 'stream'>)) ]->
  [ Out(<<~m_2, f(~k_3), k_1>, MAC(~k_2, <<~m_2, f(~k_3), k_1>, 'stream'>)>), !KnownKey('S', 2, ~k_2) ]

// Step 7: Receiver R receives subsequent stream message
rule RuleStep7:
  [ In(< D_2, mac_2 >), !CachedMsg('R', 1, D_1, mac_1) ]
  --[ Test7(), StreamRecv('R', 2, D_2, mac_2) ]->
  [ !CachedMsg('R', 2, D_2, mac_2) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4 #t5 #t6 #t7.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 &
       Test4() @ #t4 & Test5() @ #t5 & Test6() @ #t6 & Test7() @ #t7
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4 & #t4 < #t5 & #t5 < #t6 & #t6 < #t7"

end