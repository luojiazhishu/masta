theory TESLA_Scheme1 begin

builtins: signing, hashing, symmetric-encryption

functions: f/1, mac/2

// Rule 1: Receiver sends SetupRequest
rule RuleStep1:
  [
    Fr(~n_R),
    Fr(~tid_R)
  ]
  --[ Test1(), SetupRequest(~tid_R, $R, $S, ~n_R) ]->
  [
    Out(<$R, $S, ~n_R, $R, $S, ~n_R>),
    !StateR(~tid_R, $R, $S, ~n_R)
  ]

// Rule 2: Sender receives SetupRequest, verifies, sends SetupResponse
rule RuleStep2:
  [
    In(<$R, $S, ~n_R, $R, $S, ~n_R>),
    Fr(~k_1),
    Fr(~tid_S),
    !Ltk($S, ~sk_S)
  ]
  --[ Test2(), SetupResponse(~tid_S, $S, $R, ~n_R), Commit($S, $R, <f(~k_1), ~n_R>) ]->
  [
    Out(<$S, $R, f(~k_1), sign(<f(~k_1), ~n_R>, ~sk_S)>),
    !StateS(~tid_S, $S, $R, ~n_R, ~k_1),
    !KeyCommitment($S, $R, f(~k_1), ~n_R)
  ]

// Rule 3: Sender sends first stream message (Msg 1)
rule RuleStep3:
  [
    !StateS(~tid_S, $S, $R, ~n_R, ~k_1),
    Fr(~k_2),
    Fr(~m_1)
  ]
  --[ Test3(), StreamMsg($S, $R, '1', <~m_1, f(~k_2)>) ]->
  [
    Out(<<~m_1, f(~k_2)>, mac(~k_1, <~m_1, f(~k_2)>)>),
    !StateS(~tid_S, $S, $R, ~n_R, ~k_2),
    !DisclosedKey($S, $R, '1', ~k_1)
  ]

// Rule 4: Sender sends subsequent stream message (Msg n), disclosing k_{n-1}
// Fixed: All variables in action facts are now bound in premises.
// ~idx_next, ~m_next, ~k_next are fresh/bound in premises.
// ~k_prev is bound from !DisclosedKey premise.
rule RuleStep4:
  [
    !StateS(~tid_S, $S, $R, ~n_R, ~k_curr),
    !DisclosedKey($S, $R, ~idx, ~k_prev),
    Fr(~k_next),
    Fr(~m_next),
    Fr(~idx_next)
  ]
  --[ Test4(), StreamMsg($S, $R, ~idx_next, <~m_next, f(~k_next), ~k_prev>) ]->
  [
    Out(<<~m_next, f(~k_next), ~k_prev>, mac(~k_curr, <~m_next, f(~k_next), ~k_prev>)>),
    !StateS(~tid_S, $S, $R, ~n_R, ~k_next),
    !DisclosedKey($S, $R, ~idx_next, ~k_curr)
  ]

// Key generation rule for Sender's long-term key
rule GenerateKey:
  [
    Fr(~sk_S)
  ]
  -->
  [
    !Ltk($S, ~sk_S),
    Out(pk(~sk_S))
  ]

// Adversary can reveal long-term key (for threat model)
rule LtkReveal:
  [
    !Ltk($A, ~ltk)
  ]
  --[ LtkReveal($A) ]->
  [
    Out(~ltk)
  ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

end