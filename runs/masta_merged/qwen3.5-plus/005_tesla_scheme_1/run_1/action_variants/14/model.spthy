theory TESLA_Scheme1 begin

builtins: signing, hashing

functions: f/1, mac/2

// PKI Setup: Generate long-term signing key for Sender
rule Setup_PK:
  [ Fr(~sk_s) ]
  --[ Setup() ]->
  [ !Ltk($S, ~sk_s), !Pk($S, pk(~sk_s)), Out(pk(~sk_s)) ]

// RuleStep1: Receiver sends setup request with nonce
rule RuleStep1:
  [ Fr(~n_R), Fr(~tid_R) ]
  --[ Test1(), Start_R(~tid_R, $R, $S, ~n_R) ]->
  [ Out(<$R, $S, ~n_R>), !StateR1(~tid_R, $R, $S, ~n_R) ]

// RuleStep2: Sender receives request, generates key, signs commitment, sends duplicated response
rule RuleStep2:
  [ In(<$R, $S, n_R>), Fr(~k_1), Fr(~tid_S), !Ltk($S, ~sk_s) ]
  let
    f_k1 = f(~k_1)
    sig = sign(<f_k1, n_R>, ~sk_s)
    resp = <$S, $R, f_k1, sig, $S, $R, f_k1, sig>
  in
  --[ Test2(), Start_S(~tid_S, $S, $R, ~k_1, f_k1) ]->
  [ Out(resp), !StateS1(~tid_S, $S, $R, ~k_1, f_k1, n_R) ]

// RuleStep3: Receiver receives duplicated response, verifies equality and signature
rule RuleStep3:
  [ In(<S1, R1, f_k1, sig, S2, R2, f_k1_2, sig2>), !StateR1(~tid_R, $R, $S, ~n_R) ]
  let
    pk_S = pk(~sk_s)
  in
  [
    S1 = $S,
    S2 = $S,
    R1 = $R,
    R2 = $R,
    f_k1 = f_k1_2,
    sig = sig2,
    verify(sig, <f_k1, ~n_R>, pk_S) = true
  ]
  --[ Test3(), Commit_R(~tid_R, $S, $R, f_k1) ]->
  [ !Commitment($R, f_k1, ~k_1) ]

// RuleStep4: Sender sends first stream message
rule RuleStep4:
  [ Fr(~m_1), Fr(~k_2), !StateS1(~tid_S, $S, $R, ~k_1, f_k1, n_R) ]
  let
    D_1 = <~m_1, f(~k_2)>
    mac_1 = mac(~k_1, D_1)
  in
  --[ Test4(), Send_Stream(~tid_S, 1, ~m_1) ]->
  [ Out(<D_1, mac_1>), !StateS2(~tid_S, $S, $R, ~k_2, f(~k_2)) ]

// RuleStep5: Receiver receives first stream message (abstracted verification)
rule RuleStep5:
  [ In(<D_1, mac_1>), !Commitment($R, f_k1, ~k_1) ]
  --[ Test5(), Receive_Stream($R, 1) ]->
  [ ]

// RuleStep6: Sender sends nth stream message (disclosing previous key)
rule RuleStep6:
  [ Fr(~m_n), Fr(~k_n_plus_1), Fr(~k_n), !StateS2(~tid_S, $S, $R, ~k_n, f_k_n) ]
  let
    D_n = <~m_n, f(~k_n_plus_1), ~k_n>
    mac_n = mac(~k_n, D_n)
  in
  --[ Test6(), Send_Stream(~tid_S, n, ~m_n) ]->
  [ Out(<D_n, mac_n>), !StateS2(~tid_S, $S, $R, ~k_n_plus_1, f(~k_n_plus_1)) ]

// RuleStep7: Receiver receives nth stream message
rule RuleStep7:
  [ In(<D_n, mac_n>), !Commitment($R, f_k_prev, ~k_prev) ]
  --[ Test7(), Receive_Stream($R, n) ]->
  [ ]

// Adversary capability: Reveal long-term signing key
rule LtkReveal:
  [ !Ltk($A, ltk) ]
  --[ LtkReveal($A) ]->
  [ Out(ltk) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4 #t5 #t6 #t7.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & Test5() @ #t5 & Test6() @ #t6 & Test7() @ #t7
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4 & #t4 < #t5 & #t5 < #t6 & #t6 < #t7"

end