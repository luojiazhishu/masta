theory sk_pmd begin

builtins: symmetric-encryption

functions: pmd/0

rule RuleStep1:
  [
    Fr(~sec),
    Fr(~pub),
    Fr(~k)
  ]
  --[ Secret(~sec), Test1() ]->
  [
    Out(<senc(<~sec, ~pub>, ~k), 'pmd'>)
  ]

rule RuleStep2:
  [
    In(<msg, tag>)
  ]
  --[ Test2() ]->
  [
  ]

lemma executable:
  exists-trace
  "Ex #t1 #t2.
       Test1() @ #t1 & Test2() @ #t2
     & #t1 < #t2"

// category: secrecy
lemma secrecy_sec:
  "All x #i.
     Secret(x) @ i
   ==>
       not (Ex #j. K(x) @ j)"

end