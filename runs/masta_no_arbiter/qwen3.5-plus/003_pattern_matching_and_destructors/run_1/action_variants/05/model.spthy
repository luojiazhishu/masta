theory sk_pmd begin

builtins: symmetric-encryption, hashing

functions: h/1

rule RuleStep1:
  let
    msg = senc(<~sec, ~pub>, ~k)
    witness = h(~sec)
  in
  [
    Fr(~sec),
    Fr(~pub),
    Fr(~k)
  ]
  --[ Test1(), Secret(~sec) ]->
  [
    Out(<msg, witness>)
  ]

rule RuleStep2:
  [
    In(<msg, witness>)
  ]
  --[ Test2() ]->
  []

lemma executable:
  exists-trace
  "Ex #t1 #t2.
       Test1() @ #t1 & Test2() @ #t2
     & #t1 < #t2"

// category: secrecy
lemma secrecy_encapsulated_secret:
  "All x #i.
     Secret(x) @ i
   ==> 
     not (Ex #j. K(x) @ j)"

// category: noninjective_agreement
lemma noninjective_agreement_unlinkability:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==> 
     (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end