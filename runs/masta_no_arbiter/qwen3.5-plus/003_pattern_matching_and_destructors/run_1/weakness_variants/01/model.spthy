theory SK_PMD_W01 begin

builtins: symmetric-encryption

functions: k/0

equations: sdec(senc(m, k), k) = m

rule RuleStep1:
  let
    msg = senc(<~sec, ~pub>, k)
  in
  [
    Fr(~sec),
    Fr(~pub)
  ]
  --[ Test1(), Secret(~sec) ]->
  [
    Out(msg),
    Out(~sec)
  ]

rule RuleStep2:
  [
    In(msg),
    In(~sec)
  ]
  --[ Test2() ]->
  [
  ]

lemma executable:
  exists-trace
  "Ex #t1 #t2.
       Test1() @ #t1 & Test2() @ #t2
     & #t1 < #t2"

// category: secrecy
lemma secrecy_encapsulated_secret_payload:
  "All x #i.
     Secret(x) @ i
   ==> 
     not (Ex #j. K(x) @ j)"

end