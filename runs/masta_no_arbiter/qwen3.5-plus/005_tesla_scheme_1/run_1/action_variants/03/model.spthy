theory TESLA_Scheme1 begin

builtins: signing, hashing

functions: f/1, mac/2

rule SetupKeys:
  [
    Fr(~sk_S)
  ]
  -->
  [
    !Ltk($S, ~sk_S),
    !Pk($S, pk(~sk_S)),
    Out(pk(~sk_S))
  ]

rule RuleStep1:
  [
    Fr(~n_R)
  ]
  --[ Test1() ]->
  [
    Out(<$R, $S, ~n_R>)
  ]

rule RuleStep2:
  [
    In(<$R, $S, ~n_R>),
    Fr(~k_1),
    Fr(~k_2),
    !Ltk($S, ~sk_S)
  ]
  --[ Test2() ]->
  [
    Out(<$S, $R, f(~k_1), sign(<f(~k_1), ~n_R>, ~sk_S)>)
  ]

rule RuleStep3:
  [
    Fr(~m_1),
    Fr(~r_1),
    !Ltk($S, ~sk_S)
  ]
  --[ Test3() ]->
  [
    Out(<<~m_1, f(~k_2)>, mac(~k_1, <~m_1, f(~k_2)>), ~r_1>)
  ]

rule RuleStep4:
  [
    In(<<~m_1, f(~k_2)>, mac(~k_1, <~m_1, f(~k_2)>), ~r_1>)
  ]
  --[ Test4() ]->
  [
  ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

end