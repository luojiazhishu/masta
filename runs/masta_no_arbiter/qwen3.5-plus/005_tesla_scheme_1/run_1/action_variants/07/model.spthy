theory TESLA_Scheme1 begin

builtins: signing, hashing

functions: f/1, mac/2

// PKI Setup: Generate long-term keys for Sender and Receiver
rule Setup_Keys:
  [ Fr(~sk_s), Fr(~sk_r) ]
  --[ Setup() ]->
  [ !Ltk('S', ~sk_s), !Ltk('R', ~sk_r),
    !Pk('S', pk(~sk_s)), !Pk('R', pk(~sk_r)),
    Out(pk(~sk_s)), Out(pk(~sk_r)) ]

// Step 1: Receiver sends nonce
rule RuleStep1:
  [ Fr(~n_R), !Ltk('R', ~sk_r), !Pk('S', pk_s) ]
  --[ Test1() ]->
  [ Out(< 'R', 'S', ~n_R >), !StateR1('R', 'S', ~n_R, ~sk_r, pk_s) ]

// Step 2: Sender receives nonce, signs commitment, sends response
rule RuleStep2:
  [ In(< 'R', 'S', n_R >),
    !Ltk('S', ~sk_s), !Pk('R', pk_r),
    Fr(~k_1) ]
  let f_k1 = f(~k_1)
      sig = sign(< f_k1, n_R >, ~sk_s)
  in
  --[ Test2() ]->
  [ Out(< 'S', 'R', f_k1, sig >),
    !StateS1('S', 'R', n_R, ~k_1, ~sk_s, pk_r) ]

// Step 3: Receiver verifies signature
rule RuleStep3:
  [ In(< 'S', 'R', f_k1, sig >),
    !StateR1('R', 'S', n_R, ~sk_r, pk_s) ]
  let msg = < f_k1, n_R >
  in
  --[ Test3() ]->
  [ !StateR2('R', 'S', n_R, ~sk_r, pk_s, f_k1) ]

// Step 4: Sender generates stream data, computes MAC, sends first stream message with marker
rule RuleStep4:
  [ !StateS1('S', 'R', n_R, ~k_1, ~sk_s, pk_r),
    Fr(~m_1), Fr(~k_2) ]
  let D_1 = < ~m_1, f(~k_2) >
      mac_1 = mac(~k_1, D_1)
  in
  --[ Test4() ]->
  [ Out(< D_1, mac_1, 'data1_marker' >) ]

// Step 5: Receiver receives stream message and checks marker
rule RuleStep5:
  [ In(< D_1, mac_1, 'data1_marker' >),
    !StateR2('R', 'S', n_R, ~sk_r, pk_s, f_k1) ]
  --[ Test5() ]->
  [ !StateR3('R', 'S', n_R, ~sk_r, pk_s, f_k1, D_1, mac_1) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4 #t5.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & Test5() @ #t5
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4 & #t4 < #t5"

end