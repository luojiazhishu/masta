theory TESLA_Scheme1 begin

builtins: signing

functions: f/1

// RuleStep1: Receiver R generates nonce n_R and sends SetupRequest
rule RuleStep1:
  [
    Fr(~n_R),
    Fr(~tid_R)
  ]
  --[ Test1() ]->
  [
    Out(<$R, $S, ~n_R>),
    !StateR_1(~tid_R, $R, $S, ~n_R)
  ]

// RuleStep2: Sender S receives SetupRequest, generates k_1, computes f(k_1) and signature, sends SetupResponse
rule GenerateKey:
  [
    Fr(~sk_S)
  ]
  -->
  [
    !Ltk($S, ~sk_S),
    Out(pk(~sk_S))
  ]

rule RuleStep2:
  [
    In(<$R, $S, n_R>),
    Fr(~k_1),
    Fr(~tid_S),
    !Ltk($S, ~sk_S)
  ]
  --[ Test2() ]->
  [
    Out(<$S, $R, f(~k_1), sign(n_R, ~sk_S)>),
    !StateS_1(~tid_S, $S, $R, n_R, ~k_1)
  ]

// RuleStep3: Receiver R receives SetupResponse, verifies signature
rule RuleStep3:
  [
    In(<$S, $R, commitment, signature>),
    !StateR_1(~tid_R, $R, $S, n_R)
  ]
  --[ Test3() ]->
  [
    !Verified($R, $S, n_R, commitment)
  ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

end