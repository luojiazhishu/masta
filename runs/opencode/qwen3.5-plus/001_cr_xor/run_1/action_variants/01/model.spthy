theory CR_XOR_Echo
begin

builtins: hashing, xor

rule Setup_Ltk:
  [ Fr(~k) ]
  --[ ]->
  [ !Ltk('I', ~k), !Ltk('R', ~k) ]

rule Ltk_Reveal:
  [ !Ltk(A, ~k) ]
  --[ LtkReveal(A) ]->
  [ Out(~k) ]

rule Initiator_Start:
  [ Fr(~na), Fr(~r), !Ltk('I', k) ]
  --[ Test1(), Create('I', ~na), Running('I', 'R', <'init', ~na, ~r>) ]->
  [ Out(<~na, ~r>), St_I('I', ~na, ~r, k) ]

rule Responder_Respond:
  [ Fr(~nb), In(<na, r>), !Ltk('R', k) ]
  --[ Test2(), Create('R', na), Running('R', 'I', <'resp', na, r, k>) ]->
  [ Out(<h(na XOR k XOR ~nb), ~nb, r>) ]

rule Initiator_Verify:
  [ St_I('I', ~na, ~r, k), In(<h(~na XOR k XOR nb), nb, ~r>) ]
  --[ Test3(), Commit('I', 'R', <'init', ~na, nb>), Honest('I'), Honest('R') ]->
  [ ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

// category: aliveness
lemma aliveness:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex id #j. Create(b, id) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end
