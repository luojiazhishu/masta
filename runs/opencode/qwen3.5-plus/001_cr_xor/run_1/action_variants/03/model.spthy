theory CR_XOR_RMK
begin

builtins: xor, hashing

functions: RMK/0

rule Setup:
  [ Fr(~k), Fr(~tidI), Fr(~tidR) ]
  --[ Create($I, ~tidI, ~k), Create($R, ~tidR, ~k) ]->
  [ !Ltk($I, ~k), !Ltk($R, ~k) ]

rule I_GenChallenge:
  [ Fr(~na), !Ltk($I, ~k) ]
  --[ Test1(), Running($I, $R, ~na, zero, ~k), Honest($I) ]->
  [ Out(~na), St_I_1($I, ~na, ~k) ]

rule R_Respond:
  [ Fr(~nb), In(na), !Ltk($R, ~k) ]
  --[ Test2(), Running($R, $I, na, ~nb, ~k), Honest($R) ]->
  [ Out(<h(na XOR ~k XOR ~nb), ~nb, RMK>), St_R_1($R, na, ~nb, ~k) ]

rule I_Verify:
  let computed_tag = h(~na XOR ~k XOR nb)
  in
  [ St_I_1($I, ~na, ~k), In(<tag, nb, RMK>) ]
  --[ Test3(), Commit($I, $R, ~na, nb, ~k), Honest($I) ]->
  [ ]

rule LtkReveal:
  [ !Ltk(X, k) ]
  --[ LtkReveal(X) ]->
  [ Out(k) ]

// category: aliveness
lemma aliveness:
  "All a b na nb k #i.
     Commit(a, b, na, nb, k) @ i
   ==>
       (Ex id #j. Create(b, id, k) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement:
  "All a b na nb k #i.
     Commit(a, b, na, nb, k) @ i
   ==>
       (Ex #j. Running(b, a, na, nb, k) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

end
