theory CR_XOR_DSep
begin

builtins: hashing

functions: xormsg/3, hash_with_init/1

rule Initiator_Start:
  [ Fr(~na), !Id(~i), !Id(~r), Fr(~k) ]
  --[ Test1() ]->
  [ Out(~na), St_I(~i, ~r, ~na, ~k) ]

rule Setup_Key:
  [ Fr(~k) ]
  --[ ]->
  [ !Ltk(~k) ]

rule Ltk_Reveal:
  [ !Ltk(~k) ]
  --[ LtkReveal(~k) ]->
  [ Out(~k) ]

rule Responder_Respond:
  [ In(na), Fr(~nb), !Ltk(~k), !Id(~i), !Id(~r) ]
  --[ Test2(), Create(~r, ~nb), Running(~r, ~i, <na, ~nb>) ]->
  [ Out(~nb), Auth(~r, ~i, na, ~nb) ]

rule Initiator_Verify:
  [ St_I(~i, ~r, ~na, ~k), In(nb), Auth(~r, ~i, ~na, nb) ]
  --[ Test3(), Commit(~i, ~r, <~na, nb>) ]->
  [ ]

rule Setup_Ids:
  [ Fr(~i) ]
  --[ ]->
  [ !Id(~i) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

// category: aliveness
lemma aliveness:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex id #j. Create(b, id) @ j)
     | (Ex X #r. LtkReveal(X) @ r)"

// category: noninjective_agreement
lemma noninjective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r)"

end
