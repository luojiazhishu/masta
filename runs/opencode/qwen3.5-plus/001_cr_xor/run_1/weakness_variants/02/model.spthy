theory CRXOR_NoKVfy
begin

builtins: hashing, xor

rule Setup_Ltk:
  [ Fr(~k) ]
  --[ ]->
  [ !Ltk(~k) ]

rule Initiator_Start:
  [ Fr(~na), Fr(~I), Fr(~R) ]
  --[ Test1(), Create(~I, ~na) ]->
  [ Out(~na), St_I_1(~I, ~R, ~na) ]

rule Responder_Receive:
  [ In(na), !Ltk(~k), Fr(~nb), Fr(~R), Fr(~I) ]
  --[ Test2(), Running(~R, ~I, <'responder', na, ~nb>) ]->
  [ Out(<h(na XOR ~k XOR ~nb), ~nb>), St_R_1(~R, ~I, na) ]

rule Initiator_Verify:
  [ St_I_1(~I, ~R, ~na), In(<tag, nb>) ]
  --[ Test3(), Eq(tag, h(~na XOR nb)), Commit(~I, ~R, <'initiator', ~na, nb>), Honest(~I) ]->
  [ ]

rule Ltk_Reveal:
  [ !Ltk(~k) ]
  --[ LtkReveal(~k) ]->
  [ Out(~k) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

lemma aliveness_responder:
  // category: aliveness
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex id #j. Create(b, id) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

lemma noninjective_agreement_tag:
  // category: noninjective_agreement
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end
