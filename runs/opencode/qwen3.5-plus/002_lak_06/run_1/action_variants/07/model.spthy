theory LAK06
begin

builtins: hashing

functions: xoring/2

rule Setup:
  [ Fr(~k), Fr(~R), Fr(~T) ]
  --[ Create(~R), Create(~T), Secret(~R, ~T, ~k) ]->
  [ !Ltk(~R, ~T, ~k), !Ltk(~T, ~R, ~k), !Honest(~R), !Honest(~T) ]

rule Reader_Start:
  [ !Ltk(R, T, k), Fr(~r0) ]
  --[ Test1(), Running(R, T, <'reader', ~r0>) ]->
  [ Out(~r0), St_R1(R, T, k, ~r0) ]

rule Tag_Respond:
  [ !Ltk(T, R, k), In(r0), Fr(~r1) ]
  --[ Test2(), Running(T, R, <'tag', r0, ~r1>) ]->
  [ Out(<~r1, h(xoring(xoring(r0, ~r1), k))>), St_T1(T, R, k, r0, ~r1, h(xoring(xoring(r0, ~r1), k))) ]

rule Reader_Verify:
  [ St_R1(R, T, k, r0), In(<r1, tag_mac>) ]
  --[ Test3(), Eq(tag_mac, h(xoring(xoring(r0, r1), k))), Running(R, T, <'reader_verify', r0, r1>) ]->
  [ Out(h(xoring(xoring(tag_mac, k), r0))), St_R2(R, T, k, r0, r1) ]

rule Tag_Verify:
  [ St_T1(T, R, k, r0, r1, tag_mac), In(reader_mac) ]
  --[ Test4(), Eq(reader_mac, h(xoring(xoring(tag_mac, k), r0))), Commit(T, R, <'tag', r0, r1, k>) ]->
  [ ]

rule LtkReveal_R:
  [ !Ltk(R, T, k), !Honest(R) ]
  --[ LtkReveal(R) ]->
  [ Out(k) ]

rule LtkReveal_T:
  [ !Ltk(T, R, k), !Honest(T) ]
  --[ LtkReveal(T) ]->
  [ Out(k) ]

restriction equality:
  "All x y #i. Eq(x,y)@i ==> x=y"

// category: secrecy
lemma secrecy_k:
  "All R T k #i.
     Secret(R, T, k) @ i
   ==>
       not (Ex #j. K(k) @ j)
     | (Ex X #r. LtkReveal(X) @ r)"

// category: noninjective_agreement
lemma noninjective_agreement_tag:
  "All T R r0 r1 k #i.
     Commit(T, R, <'tag', r0, r1, k>) @ i
   ==>
       (Ex #j. Running(R, T, <'reader_verify', r0, r1>) @ j)
     | (Ex X #r. LtkReveal(X) @ r)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

end
