theory LAK06
begin

builtins: hashing, xor

// Long-term key fact
rule Setup:
  [ Fr(~k) ]
  --[ Create(~k) ]->
  [ !Ltk(~k) ]

// Action block 1: Reader sends challenge r0
rule Reader_Challenge:
  [ Fr(~r0), !Ltk(~k) ]
  --[ Test1(), Running('R', 'T', <'reader', ~r0, ~k>) ]->
  [ Out(~r0), St_R(~r0, ~k) ]

// Action block 2: Tag responds with r1 and tag_mac
rule Tag_Response:
  [ In(r0), Fr(~r1), !Ltk(~k) ]
  --[ Test2(), Running('T', 'R', <'tag', r0, ~r1, ~k>), Secret('T', 'R', ~k) ]->
  [ Out(<~r1, h(r0 ⊕ ~r1 ⊕ ~k)>), St_T(r0, ~r1, ~k, h(r0 ⊕ ~r1 ⊕ ~k)) ]

// Action block 3: Reader verifies tag_mac and sends reader_mac twice
rule Reader_Confirm:
  let reader_mac = h(h(r0 ⊕ r1 ⊕ k) ⊕ k ⊕ r0) in
  [ St_R(r0, k), In(<r1, h(r0 ⊕ r1 ⊕ k)>) ]
  --[ Test3(), Commit('R', 'T', <'reader', r0, r1, k>), Honest('R') ]->
  [ Out(<reader_mac, reader_mac>) ]

// Action block 4: Tag verifies reader_mac
rule Tag_Verify:
  let expected = h(tag_mac ⊕ k ⊕ r0) in
  [ St_T(r0, r1, k, tag_mac), In(<expected, expected>) ]
  --[ Test4(), Commit('T', 'R', <'tag', r0, r1, k>), Honest('T') ]->
  [ ]

// LTK reveal rule for adversary
rule Ltk_Reveal:
  [ !Ltk(~k) ]
  --[ LtkReveal(~k) ]->
  [ Out(~k) ]

// category: secrecy
lemma secrecy_k:
  "All k #i.
     Secret('T', 'R', k) @ i
   ==>
       not (Ex #j. K(k) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma agreement_tag:
  "All t #i.
     Commit('T', 'R', t) @ i
   ==>
       (Ex #j. Running('R', 'T', t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma agreement_reader:
  "All t #i.
     Commit('R', 'T', t) @ i
   ==>
       (Ex #j. Running('T', 'R', t) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

end
