theory SymmetricKeyEncapsulation
begin

builtins: symmetric-encryption

rule Initiator_Send:
  [ Fr(~sec), Fr(~pub), Fr(~k) ]
  --[ Test1(), Secret('I', 'R', ~sec), Honest('I') ]->
  [ Out(senc(<~sec, ~pub>, ~k)) ]

rule Responder_Receive:
  [ In(senc(<sec, pub>, k)) ]
  --[ Test2() ]->
  [ ]

lemma executable:
  exists-trace
  "Ex #t1 #t2.
       Test1() @ #t1 & Test2() @ #t2
     & #t1 < #t2"

// category: secrecy
lemma secrecy_sec:
  "All A B sec #i.
     Secret(A, B, sec) @ i
   ==>
       not (Ex #j. K(sec) @ j)"

end
