theory BskTack
begin

builtins: asymmetric-encryption, hashing

rule Setup:
  [ Fr(~skS) ]
  --[ ]->
  [ !Ltk($S, ~skS), !Pk($S, pk(~skS)) ]

rule Client_Init:
  [ Fr(~k), !Pk($S, pkS) ]
  --[ Test1(), Create($C, ~k) ]->
  [ Out(aenc(~k, pkS)), St_C($C, ~k, $S) ]

rule Server_Recv:
  [ In(c), !Ltk($S, skS) ]
  --[ Test2(), Running($S, adec(c, skS)) ]->
  [ Out(<h(adec(c, skS)), 'ack'>), St_S($S, adec(c, skS)) ]

rule Client_Finish:
  [ St_C($C, ~k, $S), In(<h(~k), 'ack'>) ]
  --[ Test3(), Commit($C, $S, ~k), Secret($C, $S, ~k) ]->
  [ ]

rule LtkReveal_S:
  [ !Ltk($S, skS) ]
  --[ LtkReveal($S) ]->
  [ Out(skS) ]

// category: secrecy
lemma secrecy_session_key:
  "All C S k #i.
     Secret(C, S, k) @ i & not (Ex #r. LtkReveal(S) @ r & r < i)
   ==>
       not (Ex #j. K(k) @ j)"

// category: noninjective_agreement
lemma noninjective_agreement:
  "All c s k #i.
     Commit(c, s, k) @ i
   ==>
       (Ex #j. Running(s, k) @ j)
     | (Ex #r. LtkReveal(s) @ r)"

// category: injective_agreement
lemma injective_agreement:
  "All c s k #i.
     Commit(c, s, k) @ i
   ==>
       ( (Ex #j. Running(s, k) @ j
             & j < i
             & not (Ex c2 s2 #i2. Commit(c2, s2, k) @ i2
                                & not (#i2 = #i))) )
     | (Ex #r. LtkReveal(s) @ r)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

end
