theory TESLA_Scheme1_Var04
begin

builtins: signing

functions: MAC/2, f/1

// PKI
rule Generate_Keypair:
    [ Fr(~ltk) ]
  -->
    [ !Ltk($A, ~ltk), !Pk($A, pk(~ltk)), Out(pk(~ltk)) ]

rule Reveal_Ltk:
    [ !Ltk(A, ltk) ]
  --[ RevealLtk(A), LtkReveal(A) ]->
    [ Out(ltk) ]

// Setup phase
rule Sender_Setup:
    [ Fr(~k1) ]
  --[ Test1() ]->
    [ Sender1($S, ~k1), !Sender0a($S, ~k1) ]

rule Sender0a:
    [ !Sender0a(S, k1)
    , In( < R, S, nR> )
    , !Ltk(S, ltkS)
    ]
  --[ Test2() ]->
    [ Out( <S, R, f(k1), sign{ f(k1), nR}ltkS> ) ]

rule Receiver0a:
    [ Fr( ~nR ) ]
  --[ Test3() ]->
    [ Out( < $R, $S, ~nR > )
    , Receiver0b( ~nR, $R, $S ) ]

rule Receiver0b:
    [ Receiver0b ( nR, R, S )
    , !Pk( S, pkS)
    , In( <S, R, commit_k1, signature> )
    , Fr(~rid)
    ]
  --[ Setup(~rid), Create(R, ~rid), Test4() ]->
    [ Receiver0b_check( ~rid, S, commit_k1
                      , verify(signature, <commit_k1, nR>, pkS)) ]

rule Receiver0b_check:
    [ Receiver0b_check(nR, S, commit_k1, true), Fr(~rid) ]
  --[ Test5() ]->
    [ Receiver1( nR, S, commit_k1 ) ]

// Authenticated broadcasting
// Msg 1: D_1 = <m_1, f(k_2)>, MAC(k_1, D_1)
rule Send1:
  let data1 = <~m1, f(~k2)>
  in
    [ Sender1(S, ~k1)
    , Fr(~m1)
    , Fr(~k2)
    ]
  --[ Sent(S, data1)
    , Running(S, S, <'broadcast', data1>)
    , Test6()
    ]->
    [ Sender(S, ~k1, ~k2)
    , Out( < data1, MAC{data1}~k1 > )
    ]

rule Recv1:
  let data1 = <m1, commit_k2>
  in
    [ Receiver1(rid, S, commit_k1)
    , In( <data1, mac1> )
    ]
  --[ AssumeCommitNotExpired(rid, commit_k1)
    , Test7()
    ]->
    [ Receiver(rid, S, data1, mac1, commit_k1, commit_k2) ]

// Msg n (n>=2): D_n = <m_n, f(k_{n+1}), k_{n-1}>, MAC(k_n, D_n), r_n
// r_n is a fresh random packet tag NOT covered by the MAC
rule SendN:
  let data = <~m, f(~kNew), ~kOld>
  in
    [ Sender(S, ~kOld, ~k)
    , Fr(~m)
    , Fr(~kNew)
    , Fr(~r_n)
    ]
  --[ Sent(S, data)
    , CommitExpired(f(~kOld))
    , Running(S, S, <'broadcast', data>)
    , Test8()
    ]->
    [ Sender(S, ~k, ~kNew)
    , Out( <data, MAC{data}~k, ~r_n> )
    ]

rule RecvN:
  let data = <m, commit_kNew, kOld>
  in
    [ In(< data, mac, r_n >)
    , Receiver(rid, S, dataOld, MAC{dataOld}kOld, f(kOld), commit_k)
    ]
  --[ FromSender(rid, S, dataOld)
    , AssumeCommitNotExpired(rid, commit_k)
    , Commit(rid, S, <'broadcast', dataOld>)
    , Honest(S)
    , Test9()
    ]->
    [ Receiver(rid, S, data, mac, commit_k, commit_kNew) ]

restriction CommitNotExpiredOrdering:
  "All rid commit #i #j.
       AssumeCommitNotExpired(rid, commit) @ i & CommitExpired(commit) @ j
   ==> i < j"

// Non-injective agreement lemma
lemma authentic [use_induction]:
  "All R S m #i.
     Commit(R, S, <'broadcast', m>) @ i
   ==>
       (Ex #j. Running(S, S, <'broadcast', m>) @ j & j < i)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4 #t5 #t6 #t7 #t8 #t9.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & Test4() @ #t4 & Test5() @ #t5 & Test6() @ #t6
     & Test7() @ #t7 & Test8() @ #t8 & Test9() @ #t9
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4 & #t4 < #t5
     & #t5 < #t6 & #t6 < #t7 & #t7 < #t8 & #t8 < #t9"

end
