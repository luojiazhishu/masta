theory TeslaScheme1
begin

builtins: signing, hashing

functions: f/1

rule SetupKeys:
  [ Fr(~sk_S) ]
  --[ ]->
  [ !Ltk(~sk_S), !Pk(pk(~sk_S), ~sk_S) ]

rule Receiver_Start:
  [ Fr(~n_R) ]
  --[ Test1(), Create('R', ~n_R), Running('R', 'S', <'setup', ~n_R>) ]->
  [ Out(<'R', 'S', ~n_R>), St_R_Init(~n_R) ]

rule Sender_Respond:
  [ In(<'R', 'S', n_R>), !Ltk(sk_S), Fr(~k_1) ]
  --[ Test2(), Running('S', 'R', <'setup', n_R, f(~k_1)>), Create('S', <n_R, ~k_1>) ]->
  [ Out(<'S', 'R', f(~k_1), sign(n_R, sk_S)>), St_S_Resp(n_R, ~k_1) ]

rule Receiver_Verify:
  [ St_R_Init(n_R), In(<'S', 'R', commitment, signature>), !Pk(pk_S, sk_S) ]
  --[ Test3(), Commit('R', 'S', <'setup', n_R, commitment>), Honest('R') ]->
  [ St_R_Verified(n_R, commitment) ]

rule LtkReveal:
  [ !Ltk(sk) ]
  --[ LtkReveal(sk) ]->
  [ Out(sk), !Ltk(sk) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

// category: aliveness
lemma aliveness:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex id #j. Create(b, id) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex t2 #j. Running(b, a, t2) @ j)
     | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

end
