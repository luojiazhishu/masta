theory TeslaScheme1Weakness04
begin

builtins: hashing, signing

functions:
  mac/2

rule Setup_Ltk:
  [ Fr(~sk_s) ]
  --[ ]->
  [ !Ltk(~sk_s), !Pk(pk(~sk_s)) ]

rule Receiver_SetupRequest:
  [ Fr(~n_R) ]
  --[ Test1(), Create('R', ~n_R) ]->
  [ Out(< 'R', 'S', ~n_R >), St_R_WaitSetup('R', 'S', ~n_R) ]

rule Sender_SetupResponse:
  [ In(< 'R', 'S', n_R >), !Ltk(~k_1), !Pk(pk_s) ]
  --[ Test2(), Running('S', 'R', <'setup', ~k_1, n_R>) ]->
  [ Out(< 'S', 'R', h(~k_1), sign(<h(~k_1), n_R>, ~k_1) >), St_S_Key('S', ~k_1) ]

rule Receiver_VerifySetup:
  [ St_R_WaitSetup(r, s, n_R), In(< 'S', 'R', commitment, signature >), !Pk(pk_s) ]
  --[ Test3() ]->
  [ St_R_Commitment(r, s, commitment), St_R_Nonce(r, s, n_R) ]

rule Sender_Stream1:
  [ St_S_Key(s, ~k_1), Fr(~m_1), Fr(~k_2) ]
  --[ Test4(), Running('S', 'R', <'stream1', ~k_1, ~m_1, h(~k_2)>) ]->
  [ Out(< <~m_1, h(~k_2)>, mac(~k_1, <~m_1, h(~k_2)>) >), St_S_Key2(s, ~k_2), St_S_Msg1(s, ~m_1, h(~k_2), ~k_1) ]

rule Receiver_CacheMsg1:
  [ St_R_Commitment(r, s, commitment), St_R_Nonce(r, s, n_R), In(< payload, mac_val >) ]
  --[ Test5() ]->
  [ St_R_CachedMsg1(r, s, payload, mac_val) ]

rule Sender_Stream2:
  [ St_S_Key2(s, ~k_2), St_S_Msg1(s, ~m_1, h(~k_2), ~k_1), Fr(~m_2), Fr(~k_3) ]
  --[ Test6(), Running('S', 'R', <'stream2', ~k_2, ~m_2, h(~k_3), ~k_1>) ]->
  [ Out(< <~m_2, h(~k_3), ~k_1>, mac(~k_2, <~m_2, h(~k_3), ~k_1>) >), St_S_Key3(s, ~k_3) ]

rule Receiver_VerifyMsg1_Weak:
  [ St_R_CachedMsg1(r, s, cached_payload, cached_mac), In(< <~m_2, next_commitment, disclosed_key>, mac_val >) ]
  --[ Test7(), Commit('R', 'S', <'verify', cached_payload, disclosed_key>) ]->
  [ St_R_Authenticated(r, s, cached_payload) ]

rule LtkReveal:
  [ !Ltk(k) ]
  --[ LtkReveal('S') ]->
  [ Out(k) ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4 #t5 #t6 #t7.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4 & Test5() @ #t5 & Test6() @ #t6 & Test7() @ #t7
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4 & #t4 < #t5 & #t5 < #t6 & #t6 < #t7"

// category: noninjective_agreement
lemma payload_authenticity:
  "All r s payload key #i.
     Commit(r, s, <'verify', payload, key>) @ i
   ==>
       (Ex #j. Ex m2 nextcomm. Running(s, r, <'stream1', key, payload, <m2, nextcomm>>) @ j)
     | (Ex #r. LtkReveal('S') @ r)"

end
