theory OPCUA_Secure_Channel
begin

builtins: hashing, signing

rule SetupClient:
  [
    Fr(~skC)
  ]
  --[ ]->
  [
    !Honest($Client),
    !Pk($Client, pk(~skC)),
    !Sk($Client, ~skC)
  ]

rule SetupServer:
  [
    Fr(~skS)
  ]
  --[ ]->
  [
    !Honest($Server),
    !Pk($Server, pk(~skS)),
    !Sk($Server, ~skS)
  ]

rule GetEndpointsRequest:
  [
    Fr(~RequestId),
    !Honest($Client),
    !Honest($Server)
  ]
  --[ Test1() ]->
  [
    Out(~RequestId)
  ]

rule GetEndpointsResponse:
  [
    In(RequestId),
    !Honest($Server),
    !Pk($Server, pkS)
  ]
  --[ Test2() ]->
  [
    Out(pkS)
  ]

rule OpenSecureChannelRequest:
  [
    In(pkS),
    !Honest($Client),
    !Pk($Client, pkC),
    !Sk($Client, skC),
    Fr(~Nc)
  ]
  --[ Test3() ]->
  [
    Out(<pkC, ~Nc, sign(<pkC, ~Nc>, skC)>)
  ]

rule OpenSecureChannelResponse:
  [
    In(<pkC, Nc, sigC>),
    !Honest($Server),
    !Pk($Server, pkS),
    !Sk($Server, skS),
    Fr(~Ns)
  ]
  --[ Test4() ]->
  [
    Out(<~Ns, pkS, sign(<~Ns>, skS)>)
  ]

// ==================== Safety Properties ====================

// category: secrecy
lemma secrecy_channel_key:
  all-traces
  "All #t1 #t2 Nc Ns.
     (Fr(Nc) @ #t1) & (Fr(Ns) @ #t1) & Honest($Client) @ #t1 & Honest($Server) @ #t1 & K(<Nc, Ns>) @ #t2
     ==> #t1 < #t2"

// category: aliveness
lemma aliveness:
  all-traces
  "All #t1.
     Honest($Client) @ #t1 & Honest($Server) @ #t1
     ==> Ex #t2. K() @ #t2"

// category: noninjective_agreement
lemma noninjective_agreement:
  all-traces
  "All #t1 Nc Ns.
     (Fr(Nc) @ #t1) & (Fr(Ns) @ #t1)
     ==> Ex #t2. K() @ #t2"

// ==================== Executable Lemma ====================

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

end
