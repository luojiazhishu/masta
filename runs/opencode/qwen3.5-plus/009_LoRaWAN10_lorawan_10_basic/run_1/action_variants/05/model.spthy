theory LoRaWAN10
begin

builtins: symmetric-encryption, hashing

rule LtkReveal:
  [ !Ltk(x) ]
  --[ LtkReveal(x) ]->
  [ Out(x) ]

rule Reveal_pk:
  [ !Pk(x) ]
  --[ ]->
  [ Out(x) ]

rule Setup:
  [ Fr(~AppKey)
  , Fr(~DevEUI)
  , Fr(~JoinEUI)
  ]
  --[ ]->
  [ !Ltk(~AppKey)
  , !Pk(~DevEUI)
  , !Pk(~JoinEUI)
  , !LtkDevKey(~DevEUI, ~AppKey)
  ]

rule Device_JoinRequest:
  [ Fr(~DevNonce)
  , !LtkDevKey(DevEUI, AppKey)
  , !Pk(DevEUI)
  , !Pk(JoinEUI)
  ]
  --[ Test1()
    , Create(DevEUI, ~DevNonce)
    , Running(DevEUI, JoinEUI, <DevEUI, JoinEUI, ~DevNonce>)
    ]->
  [ Out(< 'JoinRequest', DevEUI, JoinEUI, ~DevNonce, h(AppKey, <'JoinRequest', DevEUI, JoinEUI, ~DevNonce>) >)
  , St_Dev1(DevEUI, JoinEUI, ~DevNonce)
  ]

rule Server_JoinAccept:
  [ In(< 'JoinRequest', DevEUI, JoinEUI, DevNonce, RequestMAC >)
  , !LtkDevKey(DevEUI, AppKey)
  , !Pk(DevEUI)
  , !Pk(JoinEUI)
  , Fr(~JoinNonce)
  , Fr(DevAddr)
  ]
  --[ Test2()
    , Eq(RequestMAC, h(AppKey, <'JoinRequest', DevEUI, JoinEUI, DevNonce>))
    , Running(JoinEUI, DevEUI, <DevEUI, JoinEUI, DevNonce, ~JoinNonce, DevAddr>)
    ]->
  [ Out(senc(< 'JoinAccept', ~JoinNonce, DevAddr, h(AppKey, <'JoinAccept', ~JoinNonce, DevAddr>) >, AppKey))
  , St_Serv1(DevEUI, JoinEUI, DevNonce, ~JoinNonce, DevAddr)
  , AuditCommitment(DevEUI, JoinEUI, h(DevEUI, JoinEUI))
  , NonceFingerprint(DevNonce, h(DevNonce))
  ]

rule Device_Finish:
  [ St_Dev1(DevEUI, JoinEUI, ~DevNonce)
  , In(senc(< 'JoinAccept', JoinNonce, DevAddr, ResponseMAC >, AppKey))
  , !LtkDevKey(DevEUI, AppKey)
  ]
  --[ Test3()
    , Eq(ResponseMAC, h(AppKey, <'JoinAccept', JoinNonce, DevAddr>))
    , Commit(DevEUI, JoinEUI, <DevEUI, JoinEUI, ~DevNonce, JoinNonce, DevAddr>)
    , Secret(DevEUI, JoinEUI, h(<'cst1', ~DevNonce, JoinNonce, AppKey>))
    , Secret(DevEUI, JoinEUI, h(<'cst2', ~DevNonce, JoinNonce, AppKey>))
    ]->
  [ ]

rule Server_Commit:
  [ St_Serv1(DevEUI, JoinEUI, DevNonce, ~JoinNonce, DevAddr)
  , !LtkDevKey(DevEUI, AppKey)
  ]
  --[ Commit(JoinEUI, DevEUI, <DevEUI, JoinEUI, DevNonce, ~JoinNonce, DevAddr>)
    , Secret(JoinEUI, DevEUI, h(<'cst1', DevNonce, ~JoinNonce, AppKey>))
    , Secret(JoinEUI, DevEUI, h(<'cst2', DevNonce, ~JoinNonce, AppKey>))
    ]->
  [ ]

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3
     & #t1 < #t2 & #t2 < #t3"

// category: secrecy
lemma secrecy_AppSKey:
  "All A B k #i.
     Secret(A, B, k) @ i
   ==>
       not (Ex #j. K(k) @ j)
     | (Ex X #r. LtkReveal(X) @ r)"

// category: secrecy
lemma secrecy_NwkSKey:
  "All A B k #i.
     Secret(A, B, k) @ i
   ==>
       not (Ex #j. K(k) @ j)
     | (Ex X #r. LtkReveal(X) @ r)"

// category: noninjective_agreement
lemma noninjective_agreement_device:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r)"

// category: noninjective_agreement
lemma noninjective_agreement_server:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       (Ex #j. Running(b, a, t) @ j)
     | (Ex X #r. LtkReveal(X) @ r)"

// category: injective_agreement
lemma injective_agreement_device:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r)"

// category: injective_agreement
lemma injective_agreement_server:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
       ( (Ex #j. Running(b, a, t) @ j
             & j < i
             & not (Ex a2 b2 #i2. Commit(a2, b2, t) @ i2
                                & not (#i2 = #i))) )
     | (Ex X #r. LtkReveal(X) @ r)"

end
