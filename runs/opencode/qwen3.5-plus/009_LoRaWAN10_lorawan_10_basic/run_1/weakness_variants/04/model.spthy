theory LoRaWAN10Join
begin

builtins: symmetric-encryption, hashing

rule Device_Start:
  [ Fr(~n), Fr(~k) ]
  --[ Test1(), Create(~k) ]->
  [ Out(~n), St_D(~k, ~n) ]

rule Server_Respond:
  [ Fr(~m), In(n) ]
  --[ Test2(), Running(~m, n) ]->
  [ Out(senc(~m, n)), St_S(n, ~m) ]

rule Device_Finish:
  [ St_D(k, n), In(senc(m, n)) ]
  --[ Test3(), Commit(m, n) ]->
  [ St_D2(n, m) ]

rule Device_Disclose:
  [ St_D2(n, m) ]
  --[ Test4() ]->
  [ Out(m) ]

// category: aliveness
lemma aliveness:
  "All a t #i.
     Running(a, t) @ i
   ==>
       (Ex #j. Create(a) @ j)"

// category: noninjective_agreement
lemma noninjective_agreement:
  "All a t #i.
     Commit(a, t) @ i
   ==>
       (Ex #j. Running(a, t) @ j)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4.
       Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4
     & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

end
