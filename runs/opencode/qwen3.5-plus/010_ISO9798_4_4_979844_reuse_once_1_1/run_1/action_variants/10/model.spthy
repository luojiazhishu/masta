theory ISO979844_Mutual_Auth
begin

builtins: hashing

functions: mac/2

rule Ltk_Registration:
  [ Fr(~kAB) ]
  --[ CreateLtk('A', 'B', ~kAB) ]->
  [ !Ltk('A', 'B', ~kAB) ]

rule Responder_Start:
  [ !Ltk('A', 'B', ~kAB), Fr(~RB), Fr(~Text1) ]
  --[ Test1(), Create('B', ~RB) ]->
  [ Out(<~RB, ~Text1>), St_B_1('B', ~kAB, ~RB) ]

rule Initiator_Respond:
  [ !Ltk('A', 'B', ~kAB), In(<rb, text1>), Fr(~RA), Fr(~Text2), Fr(~Text3) ]
  --[ Test2(), Running('A', 'B', <~RA, rb>) ]->
  [ Out(<~RA, ~Text3, <'sid1_mut_cr', ~RA, rb, 'B', ~Text2>, mac(<~RA, rb, 'B'>, ~kAB)>), St_A_1('A', ~kAB, ~RA, rb) ]

rule Responder_Verify_and_Send:
  [ !Ltk('A', 'B', ~kAB), St_B_1('B', ~kAB, rb), In(<ra, text3, <'sid1_mut_cr', ra, rb, 'B', text2>, mac(<ra, rb, 'B'>, ~kAB)>), Fr(~Text4), Fr(~Text5) ]
  --[ Test3(), Running('B', 'A', <ra, rb>) ]->
  [ Out(<~Text5, mac(<rb, ra, 'mac2_tag'>, ~kAB)>), St_B_2('B', ~kAB, rb, ra) ]

rule Initiator_Verify:
  [ !Ltk('A', 'B', ~kAB), St_A_1('A', ~kAB, ra, rb), In(<text5, mac(<rb, ra, 'mac2_tag'>, ~kAB)>) ]
  --[ Test4(), Commit('A', 'B', <ra, rb>), Honest('A'), Honest('B') ]->
  [ ]

rule Responder_Commit:
  [ !Ltk('A', 'B', ~kAB), St_B_2('B', ~kAB, rb, ra) ]
  --[ Commit('B', 'A', <ra, rb>), Honest('B'), Honest('A') ]->
  [ ]

rule Ltk_Reveal_A:
  [ !Ltk('A', 'B', ~kAB) ]
  --[ LtkReveal('A') ]->
  [ Out(~kAB) ]

rule Ltk_Reveal_B:
  [ !Ltk('A', 'B', ~kAB) ]
  --[ LtkReveal('B') ]->
  [ Out(~kAB) ]

// category: injective_agreement
lemma injective_agreement_A:
  "All a b t #i.
     Commit(a, b, t) @ i & a = 'A'
   ==>
     ( (Ex #j. Running(b, a, t) @ j
           & j < i
           & not (Ex b2 #i2. Commit(a, b2, t) @ i2
                              & not (#i2 = #i)
                              & a = 'A')) )
   | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: injective_agreement
lemma injective_agreement_B:
  "All a b t #i.
     Commit(a, b, t) @ i & a = 'B'
   ==>
     ( (Ex #j. Running(b, a, t) @ j
           & j < i
           & not (Ex a2 #i2. Commit(a2, b, t) @ i2
                              & not (#i2 = #i)
                              & a2 = 'B')) )
   | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_A:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
     (Ex #j. Running(b, a, t) @ j)
   | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

// category: noninjective_agreement
lemma noninjective_agreement_B:
  "All a b t #i.
     Commit(a, b, t) @ i
   ==>
     (Ex #j. Running(b, a, t) @ j)
   | (Ex X #r. LtkReveal(X) @ r & Honest(X) @ i)"

lemma executable:
  exists-trace
  "Ex #t1 #t2 #t3 #t4.
     Test1() @ #t1 & Test2() @ #t2 & Test3() @ #t3 & Test4() @ #t4
   & #t1 < #t2 & #t2 < #t3 & #t3 < #t4"

end
